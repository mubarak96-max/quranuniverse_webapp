[{"s":75,"a":16,"en":"Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an.","w":[["لَا","Not"],["تُحَرِّكۡ","move"],["بِهِۦ","with it"],["لِسَانَكَ","your tongue"],["لِتَعۡجَلَ","to hasten"],["بِهِۦٓ","with it"]]},{"s":70,"a":14,"en":"And whoever is on earth entirely [so] then it could save him.","w":[["وَمَن","And whoever"],["فِي","(is) on"],["ٱلۡأَرۡضِ","the earth"],["جَمِيعٗا","all"],["ثُمَّ","then"],["يُنجِيهِ","it (could) save him"]]},{"s":81,"a":28,"en":"For whoever wills among you to take a right course.","w":[["لِمَن","For whoever"],["شَآءَ","wills"],["مِنكُمۡ","among you"],["أَن","to"],["يَسۡتَقِيمَ","take a straight way"]]},{"s":15,"a":82,"en":"And they used to carve from the mountains, houses, feeling secure.","w":[["وَكَانُواْ","And they used (to)"],["يَنۡحِتُونَ","carve"],["مِنَ","from"],["ٱلۡجِبَالِ","the mountains"],["بُيُوتًا","houses"],["ءَامِنِينَ","secure"]]},{"s":101,"a":8,"en":"But as for one whose scales are light,","w":[["وَأَمَّا","But as for"],["مَنۡ","(him) whose"],["خَفَّتۡ","(are) light"],["مَوَٰزِينُهُۥ","his scales"]]},{"s":5,"a":86,"en":"But those who disbelieved and denied Our signs - they are the companions of Hellfire.","w":[["وَٱلَّذِينَ","And those who"],["كَفَرُواْ","disbelieved"],["وَكَذَّبُواْ","and denied"],["بِـَٔايَٰتِنَآ","Our Signs"],["أُوْلَـٰٓئِكَ","those"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡجَحِيمِ","(of) the Hellfire"]]},{"s":83,"a":36,"en":"Have the disbelievers [not] been rewarded [this Day] for what they used to do?","w":[["هَلۡ","Have (not)"],["ثُوِّبَ","been rewarded"],["ٱلۡكُفَّارُ","the disbelievers"],["مَا","(for) what"],["كَانُواْ","they used to"],["يَفۡعَلُونَ","do"]]},{"s":72,"a":16,"en":"And [Allah revealed] that if they had remained straight on the way, We would have given them abundant provision","w":[["وَأَلَّوِ","And that if"],["ٱسۡتَقَٰمُواْ","they had remained"],["عَلَى","on"],["ٱلطَّرِيقَةِ","the Way"],["لَأَسۡقَيۡنَٰهُم","surely We (would) have given them to drink"],["مَّآءً","water"],["غَدَقٗا","(in) abundance"]]},{"s":38,"a":70,"en":"It has not been revealed to me except that I am a clear warner.\"","w":[["إِن","Not"],["يُوحَىٰٓ","has been revealed"],["إِلَيَّ","to me"],["إِلَّآ","except"],["أَنَّمَآ","that only"],["أَنَا۠","I am"],["نَذِيرٞ","a warner"],["مُّبِينٌ","clear"]]},{"s":105,"a":4,"en":"Striking them with stones of hard clay,","w":[["تَرۡمِيهِم","Striking them"],["بِحِجَارَةٖ","with stones"],["مِّن","of"],["سِجِّيلٖ","baked clay"]]},{"s":28,"a":51,"en":"And We have [repeatedly] conveyed to them the Qur'an that they might be reminded.","w":[["۞وَلَقَدۡ","And indeed"],["وَصَّلۡنَا","We have conveyed"],["لَهُمُ","to them"],["ٱلۡقَوۡلَ","the Word"],["لَعَلَّهُمۡ","so that they may"],["يَتَذَكَّرُونَ","remember"]]},{"s":11,"a":25,"en":"And We had certainly sent Noah to his people, [saying], \"Indeed, I am to you a clear warner","w":[["وَلَقَدۡ","And verily"],["أَرۡسَلۡنَا","We sent"],["نُوحًا","Nuh"],["إِلَىٰ","to"],["قَوۡمِهِۦٓ","his people"],["إِنِّي","Indeed,I am"],["لَكُمۡ","to you"],["نَذِيرٞ","a warner"],["مُّبِينٌ","clear"]]},{"s":61,"a":3,"en":"Great is hatred in the sight of Allah that you say what you do not do.","w":[["كَبُرَ","Great is"],["مَقۡتًا","hatred"],["عِندَ","with"],["ٱللَّهِ","Allah"],["أَن","that"],["تَقُولُواْ","you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":10,"a":96,"en":"Indeed, those upon whom the word of your Lord has come into effect will not believe,","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those [whom]"],["حَقَّتۡ","has become due"],["عَلَيۡهِمۡ","on them"],["كَلِمَتُ","(the) Word"],["رَبِّكَ","(of) your Lord"],["لَا","will not"],["يُؤۡمِنُونَ","believe"]]},{"s":21,"a":99,"en":"Had these [false deities] been [actual] gods, they would not have come to it, but all are eternal therein.","w":[["لَوۡ","If"],["كَانَ","were"],["هَـٰٓؤُلَآءِ","these"],["ءَالِهَةٗ","gods"],["مَّا","not"],["وَرَدُوهَاۖ","they (would) have come to it"],["وَكُلّٞ","And all"],["فِيهَا","therein"],["خَٰلِدُونَ","will abide forever"]]},{"s":35,"a":17,"en":"And that is for Allah not difficult.","w":[["وَمَا","And not"],["ذَٰلِكَ","that"],["عَلَى","(is) on"],["ٱللَّهِ","Allah"],["بِعَزِيزٖ","difficult"]]},{"s":16,"a":55,"en":"So they will deny what We have given them. Then enjoy yourselves, for you are going to know.","w":[["لِيَكۡفُرُواْ","So as to deny"],["بِمَآ","that which"],["ءَاتَيۡنَٰهُمۡۚ","We have given them"],["فَتَمَتَّعُواْ","Then enjoy yourselves"],["فَسَوۡفَ","soon"],["تَعۡلَمُونَ","you will know"]]},{"s":80,"a":22,"en":"Then when He wills, He will resurrect him.","w":[["ثُمَّ","Then"],["إِذَا","when"],["شَآءَ","He wills"],["أَنشَرَهُۥ","He will resurrect him"]]},{"s":85,"a":13,"en":"Indeed, it is He who originates [creation] and repeats.","w":[["إِنَّهُۥ","Indeed He"],["هُوَ","He"],["يُبۡدِئُ","originates"],["وَيُعِيدُ","and repeats"]]},{"s":44,"a":12,"en":"[They will say], \"Our Lord, remove from us the torment; indeed, we are believers.\"","w":[["رَّبَّنَا","Our Lord"],["ٱكۡشِفۡ","Remove"],["عَنَّا","from us"],["ٱلۡعَذَابَ","the punishment"],["إِنَّا","indeed,we"],["مُؤۡمِنُونَ","(are) believers"]]},{"s":48,"a":3,"en":"And [that] Allah may aid you with a mighty victory.","w":[["وَيَنصُرَكَ","And Allah may help you"],["ٱللَّهُ","And Allah may help you"],["نَصۡرًا","(with) a help"],["عَزِيزًا","mighty"]]},{"s":113,"a":3,"en":"And from the evil of darkness when it settles","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["غَاسِقٍ","(of) darkness"],["إِذَا","when"],["وَقَبَ","it spreads"]]},{"s":76,"a":16,"en":"Clear glasses [made] from silver of which they have determined the measure.","w":[["قَوَارِيرَاْ","Crystal-clear"],["مِن","of"],["فِضَّةٖ","silver"],["قَدَّرُوهَا","They will determine its"],["تَقۡدِيرٗا","measure"]]},{"s":106,"a":2,"en":"Their accustomed security [in] the caravan of winter and summer -","w":[["إِۦلَٰفِهِمۡ","Their familiarity"],["رِحۡلَةَ","(with the) journey"],["ٱلشِّتَآءِ","(of) winter"],["وَٱلصَّيۡفِ","and summer"]]},{"s":92,"a":3,"en":"And [by] He who created the male and female,","w":[["وَمَا","And He Who"],["خَلَقَ","created"],["ٱلذَّكَرَ","the male"],["وَٱلۡأُنثَىٰٓ","and the female"]]},{"s":13,"a":12,"en":"It is He who shows you lightening, [causing] fear and aspiration, and generates the heavy clouds.","w":[["هُوَ","He"],["ٱلَّذِي","(is) the One Who"],["يُرِيكُمُ","shows you"],["ٱلۡبَرۡقَ","the lightning"],["خَوۡفٗا","a fear"],["وَطَمَعٗا","and a hope"],["وَيُنشِئُ","and brings up"],["ٱلسَّحَابَ","the clouds"],["ٱلثِّقَالَ","the heavy"]]},{"s":94,"a":1,"en":"Did We not expand for you, [O Muhammad], your breast?","w":[["أَلَمۡ","Have not"],["نَشۡرَحۡ","We expanded"],["لَكَ","for you"],["صَدۡرَكَ","your breast"]]},{"s":103,"a":2,"en":"Indeed, mankind is in loss,","w":[["إِنَّ","Indeed"],["ٱلۡإِنسَٰنَ","mankind"],["لَفِي","(is) surely,in"],["خُسۡرٍ","loss"]]},{"s":31,"a":24,"en":"We grant them enjoyment for a little; then We will force them to a massive punishment.","w":[["نُمَتِّعُهُمۡ","We grant them enjoyment"],["قَلِيلٗا","(for) a little"],["ثُمَّ","then"],["نَضۡطَرُّهُمۡ","We will force them"],["إِلَىٰ","to"],["عَذَابٍ","a punishment"],["غَلِيظٖ","severe"]]},{"s":34,"a":52,"en":"And they will [then] say, \"We believe in it!\" But how for them will be the taking [of faith] from a place far away?","w":[["وَقَالُوٓاْ","And they will say"],["ءَامَنَّا","We believe"],["بِهِۦ","in it"],["وَأَنَّىٰ","But how"],["لَهُمُ","for them"],["ٱلتَّنَاوُشُ","(will be) the receiving"],["مِن","from"],["مَّكَانِۭ","a place"],["بَعِيدٖ","far off"]]}]
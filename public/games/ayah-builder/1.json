[{"s":36,"a":10,"en":"And it is all the same for them whether you warn them or do not warn them - they will not believe.","w":[["وَسَوَآءٌ","And it (is) same"],["عَلَيۡهِمۡ","to them"],["ءَأَنذَرۡتَهُمۡ","whether you warn them"],["أَمۡ","or"],["لَمۡ","(do) not"],["تُنذِرۡهُمۡ","warn them"],["لَا","not"],["يُؤۡمِنُونَ","they will believe"]]},{"s":42,"a":32,"en":"And of His signs are the ships in the sea, like mountains.","w":[["وَمِنۡ","And among"],["ءَايَٰتِهِ","His Signs"],["ٱلۡجَوَارِ","(are) the ships"],["فِي","in"],["ٱلۡبَحۡرِ","the sea"],["كَٱلۡأَعۡلَٰمِ","like [the] mountains"]]},{"s":112,"a":3,"en":"He neither begets nor is born,","w":[["لَمۡ","Not"],["يَلِدۡ","He begets"],["وَلَمۡ","and not"],["يُولَدۡ","He is begotten"]]},{"s":95,"a":6,"en":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","w":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["فَلَهُمۡ","then for them"],["أَجۡرٌ","(is a) reward"],["غَيۡرُ","never"],["مَمۡنُونٖ","ending"]]},{"s":1,"a":5,"en":"It is You we worship and You we ask for help.","w":[["إِيَّاكَ","You Alone"],["نَعۡبُدُ","we worship"],["وَإِيَّاكَ","and You Alone"],["نَسۡتَعِينُ","we ask for help"]]},{"s":68,"a":22,"en":"[Saying], \"Go early to your crop if you would cut the fruit.\"","w":[["أَنِ","That"],["ٱغۡدُواْ","Go early"],["عَلَىٰ","to"],["حَرۡثِكُمۡ","your crop"],["إِن","if"],["كُنتُمۡ","you would"],["صَٰرِمِينَ","pluck (the) fruit"]]},{"s":87,"a":12,"en":"[He] who will [enter and] burn in the greatest Fire,","w":[["ٱلَّذِي","The one who"],["يَصۡلَى","will burn"],["ٱلنَّارَ","(in) the Fire"],["ٱلۡكُبۡرَىٰ","[the] great"]]},{"s":39,"a":64,"en":"Say, [O Muhammad], \"Is it other than Allah that you order me to worship, O ignorant ones?\"","w":[["قُلۡ","Say"],["أَفَغَيۡرَ","Is (it) other than"],["ٱللَّهِ","Allah"],["تَأۡمُرُوٓنِّيٓ","you order me"],["أَعۡبُدُ","(to) worship"],["أَيُّهَا","O"],["ٱلۡجَٰهِلُونَ","ignorant ones"]]},{"s":40,"a":71,"en":"When the shackles are around their necks and the chains; they will be dragged","w":[["إِذِ","When"],["ٱلۡأَغۡلَٰلُ","the iron collars"],["فِيٓ","(will be) around"],["أَعۡنَٰقِهِمۡ","their necks"],["وَٱلسَّلَٰسِلُ","and the chains"],["يُسۡحَبُونَ","they will be dragged"]]},{"s":54,"a":45,"en":"[Their] assembly will be defeated, and they will turn their backs [in retreat].","w":[["سَيُهۡزَمُ","Soon will be defeated"],["ٱلۡجَمۡعُ","(their) assembly"],["وَيُوَلُّونَ","and they will turn"],["ٱلدُّبُرَ","(their) backs"]]},{"s":108,"a":3,"en":"Indeed, your enemy is the one cut off.","w":[["إِنَّ","Indeed"],["شَانِئَكَ","your enemy"],["هُوَ","he (is)"],["ٱلۡأَبۡتَرُ","the one cut off"]]},{"s":41,"a":23,"en":"And that was your assumption which you assumed about your Lord. It has brought you to ruin, and you have become among the losers.\"","w":[["وَذَٰلِكُمۡ","And that"],["ظَنُّكُمُ","(was) your assumption"],["ٱلَّذِي","which"],["ظَنَنتُم","you assumed"],["بِرَبِّكُمۡ","about your Lord"],["أَرۡدَىٰكُمۡ","It has ruined you"],["فَأَصۡبَحۡتُم","and you have become"],["مِّنَ","of"],["ٱلۡخَٰسِرِينَ","the losers"]]},{"s":69,"a":20,"en":"Indeed, I was certain that I would be meeting my account.\"","w":[["إِنِّي","Indeed,I"],["ظَنَنتُ","was certain"],["أَنِّي","that I"],["مُلَٰقٍ","(will) meet"],["حِسَابِيَهۡ","my account"]]},{"s":25,"a":39,"en":"And for each We presented examples [as warnings], and each We destroyed with [total] destruction.","w":[["وَكُلّٗا","And each"],["ضَرَبۡنَا","We have set forth"],["لَهُ","for him"],["ٱلۡأَمۡثَٰلَۖ","the examples"],["وَكُلّٗا","and each"],["تَبَّرۡنَا","We destroyed"],["تَتۡبِيرٗا","(with) destruction"]]},{"s":6,"a":49,"en":"But those who deny Our verses - the punishment will touch them for their defiant disobedience.","w":[["وَٱلَّذِينَ","And those who"],["كَذَّبُواْ","denied"],["بِـَٔايَٰتِنَا","[in] Our Verses"],["يَمَسُّهُمُ","will touch them"],["ٱلۡعَذَابُ","the punishment"],["بِمَا","for what"],["كَانُواْ","they used to"],["يَفۡسُقُونَ","defiantly disobey"]]},{"s":46,"a":14,"en":"Those are the companions of Paradise, abiding eternally therein as reward for what they used to do.","w":[["أُوْلَـٰٓئِكَ","Those"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡجَنَّةِ","(of) Paradise"],["خَٰلِدِينَ","abiding forever"],["فِيهَا","therein"],["جَزَآءَۢ","a reward"],["بِمَا","for what"],["كَانُواْ","they used to"],["يَعۡمَلُونَ","do"]]},{"s":33,"a":65,"en":"Abiding therein forever, they will not find a protector or a helper.","w":[["خَٰلِدِينَ","Abiding"],["فِيهَآ","therein"],["أَبَدٗاۖ","forever"],["لَّا","not"],["يَجِدُونَ","they will find"],["وَلِيّٗا","any protector"],["وَلَا","and not"],["نَصِيرٗا","any helper"]]},{"s":43,"a":7,"en":"But there would not come to them a prophet except that they used to ridicule him.","w":[["وَمَا","And not"],["يَأۡتِيهِم","came to them"],["مِّن","any Prophet"],["نَّبِيٍّ","any Prophet"],["إِلَّا","but"],["كَانُواْ","they used to"],["بِهِۦ","mock at him"],["يَسۡتَهۡزِءُونَ","mock at him"]]},{"s":96,"a":5,"en":"Taught man that which he knew not.","w":[["عَلَّمَ","Taught"],["ٱلۡإِنسَٰنَ","man"],["مَا","what"],["لَمۡ","not"],["يَعۡلَمۡ","he knew"]]},{"s":88,"a":23,"en":"However, he who turns away and disbelieves -","w":[["إِلَّا","But"],["مَن","whoever"],["تَوَلَّىٰ","turns away"],["وَكَفَرَ","and disbelieves"]]},{"s":57,"a":5,"en":"His is the dominion of the heavens and earth. And to Allah are returned [all] matters.","w":[["لَّهُۥ","For Him"],["مُلۡكُ","(is the) dominion"],["ٱلسَّمَٰوَٰتِ","(of) the heavens"],["وَٱلۡأَرۡضِۚ","and the earth"],["وَإِلَى","and to"],["ٱللَّهِ","Allah"],["تُرۡجَعُ","will be returned"],["ٱلۡأُمُورُ","the matters"]]},{"s":3,"a":150,"en":"But Allah is your protector, and He is the best of helpers.","w":[["بَلِ","Nay"],["ٱللَّهُ","Allah"],["مَوۡلَىٰكُمۡۖ","(is) your Protector"],["وَهُوَ","and He"],["خَيۡرُ","(is the) best"],["ٱلنَّـٰصِرِينَ","(of) the Helpers"]]},{"s":19,"a":53,"en":"And We gave him out of Our mercy his brother Aaron as a prophet.","w":[["وَوَهَبۡنَا","And We bestowed"],["لَهُۥ","[to] him"],["مِن","from"],["رَّحۡمَتِنَآ","Our Mercy"],["أَخَاهُ","his brother"],["هَٰرُونَ","Harun"],["نَبِيّٗا","a Prophet"]]},{"s":99,"a":5,"en":"Because your Lord has commanded it.","w":[["بِأَنَّ","Because"],["رَبَّكَ","your Lord"],["أَوۡحَىٰ","inspired"],["لَهَا","[to] it"]]},{"s":12,"a":103,"en":"And most of the people, although you strive [for it], are not believers.","w":[["وَمَآ","And not"],["أَكۡثَرُ","most"],["ٱلنَّاسِ","(of) the mankind"],["وَلَوۡ","even though"],["حَرَصۡتَ","you desire"],["بِمُؤۡمِنِينَ","(will be) believers"]]},{"s":100,"a":7,"en":"And indeed, he is to that a witness.","w":[["وَإِنَّهُۥ","And indeed,he"],["عَلَىٰ","on"],["ذَٰلِكَ","that"],["لَشَهِيدٞ","surely (is) a witness"]]},{"s":71,"a":10,"en":"And said, 'Ask forgiveness of your Lord. Indeed, He is ever a Perpetual Forgiver.","w":[["فَقُلۡتُ","Then I said"],["ٱسۡتَغۡفِرُواْ","Ask forgiveness"],["رَبَّكُمۡ","(from) your Lord"],["إِنَّهُۥ","Indeed,He"],["كَانَ","is"],["غَفَّارٗا","Oft-Forgiving"]]},{"s":62,"a":3,"en":"And [to] others of them who have not yet joined them. And He is the Exalted in Might, the Wise.","w":[["وَءَاخَرِينَ","And others"],["مِنۡهُمۡ","among them"],["لَمَّا","who have not yet"],["يَلۡحَقُواْ","joined"],["بِهِمۡۚ","them"],["وَهُوَ","and He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":9,"a":119,"en":"O you who have believed, fear Allah and be with those who are true.","w":[["يَـٰٓأَيُّهَا","O you who believe"],["ٱلَّذِينَ","O you who believe"],["ءَامَنُواْ","O you who believe"],["ٱتَّقُواْ","Fear"],["ٱللَّهَ","Allah"],["وَكُونُواْ","and be"],["مَعَ","with"],["ٱلصَّـٰدِقِينَ","those who are truthful"]]},{"s":23,"a":52,"en":"And indeed this, your religion, is one religion, and I am your Lord, so fear Me.\"","w":[["وَإِنَّ","And indeed"],["هَٰذِهِۦٓ","this"],["أُمَّتُكُمۡ","your religion"],["أُمَّةٗ","(is) religion"],["وَٰحِدَةٗ","one"],["وَأَنَا۠","And I Am"],["رَبُّكُمۡ","your Lord"],["فَٱتَّقُونِ","so fear Me"]]}]
[{"s":4,"a":158,"en":"Rather, Allah raised him to Himself. And ever is Allah Exalted in Might and Wise.","w":[["بَل","Nay"],["رَّفَعَهُ","he was raised"],["ٱللَّهُ","(by) Allah"],["إِلَيۡهِۚ","towards Him"],["وَكَانَ","And is"],["ٱللَّهُ","Allah"],["عَزِيزًا","All-Mighty"],["حَكِيمٗا","All-Wise"]]},{"s":26,"a":185,"en":"They said, \"You are only of those affected by magic.","w":[["قَالُوٓاْ","They said"],["إِنَّمَآ","Only"],["أَنتَ","you"],["مِنَ","(are) of"],["ٱلۡمُسَحَّرِينَ","those bewitched"]]},{"s":37,"a":79,"en":"\"Peace upon Noah among the worlds.\"","w":[["سَلَٰمٌ","Peace be"],["عَلَىٰ","upon"],["نُوحٖ","Nuh"],["فِي","among"],["ٱلۡعَٰلَمِينَ","the worlds"]]},{"s":56,"a":49,"en":"Say, [O Muhammad], \"Indeed, the former and the later peoples","w":[["قُلۡ","Say"],["إِنَّ","Indeed"],["ٱلۡأَوَّلِينَ","the former"],["وَٱلۡأٓخِرِينَ","and the later people"]]},{"s":89,"a":17,"en":"No! But you do not honor the orphan","w":[["كَلَّاۖ","Nay"],["بَل","But"],["لَّا","not"],["تُكۡرِمُونَ","you honor"],["ٱلۡيَتِيمَ","the orphan"]]},{"s":1,"a":1,"en":"In the name of Allah, the Entirely Merciful, the Especially Merciful.","w":[["بِسۡمِ","In (the) name"],["ٱللَّهِ","(of) Allah"],["ٱلرَّحۡمَٰنِ","the Most Gracious"],["ٱلرَّحِيمِ","the Most Merciful"]]},{"s":34,"a":35,"en":"And they said, \"We are more [than the believers] in wealth and children, and we are not to be punished.\"","w":[["وَقَالُواْ","And they say"],["نَحۡنُ","We"],["أَكۡثَرُ","(have) more"],["أَمۡوَٰلٗا","wealth"],["وَأَوۡلَٰدٗا","and children"],["وَمَا","and not"],["نَحۡنُ","we"],["بِمُعَذَّبِينَ","will be punished"]]},{"s":42,"a":32,"en":"And of His signs are the ships in the sea, like mountains.","w":[["وَمِنۡ","And among"],["ءَايَٰتِهِ","His Signs"],["ٱلۡجَوَارِ","(are) the ships"],["فِي","in"],["ٱلۡبَحۡرِ","the sea"],["كَٱلۡأَعۡلَٰمِ","like [the] mountains"]]},{"s":15,"a":11,"en":"And no messenger would come to them except that they ridiculed him.","w":[["وَمَا","And not"],["يَأۡتِيهِم","came to them"],["مِّن","any"],["رَّسُولٍ","Messenger"],["إِلَّا","but"],["كَانُواْ","they did"],["بِهِۦ","at him"],["يَسۡتَهۡزِءُونَ","mock"]]},{"s":113,"a":2,"en":"From the evil of that which He created","w":[["مِن","From"],["شَرِّ","(the) evil"],["مَا","(of) what"],["خَلَقَ","He created"]]},{"s":39,"a":34,"en":"They will have whatever they desire with their Lord. That is the reward of the doers of good -","w":[["لَهُم","For them"],["مَّا","(is) what"],["يَشَآءُونَ","they wish"],["عِندَ","with"],["رَبِّهِمۡۚ","their Lord"],["ذَٰلِكَ","That"],["جَزَآءُ","(is the) reward"],["ٱلۡمُحۡسِنِينَ","(of) the good-doers"]]},{"s":20,"a":27,"en":"And untie the knot from my tongue","w":[["وَٱحۡلُلۡ","And untie"],["عُقۡدَةٗ","(the) knot"],["مِّن","from"],["لِّسَانِي","my tongue"]]},{"s":19,"a":77,"en":"Then, have you seen he who disbelieved in Our verses and said, \"I will surely be given wealth and children [in the next life]?\"","w":[["أَفَرَءَيۡتَ","Then,have you seen"],["ٱلَّذِي","he who"],["كَفَرَ","disbelieved"],["بِـَٔايَٰتِنَا","in Our Verses"],["وَقَالَ","and said"],["لَأُوتَيَنَّ","Surely,I will be given"],["مَالٗا","wealth"],["وَوَلَدًا","and children"]]},{"s":2,"a":244,"en":"And fight in the cause of Allah and know that Allah is Hearing and Knowing.","w":[["وَقَٰتِلُواْ","And fight"],["فِي","in"],["سَبِيلِ","(the) way"],["ٱللَّهِ","(of) Allah"],["وَٱعۡلَمُوٓاْ","and know"],["أَنَّ","that"],["ٱللَّهَ","Allah"],["سَمِيعٌ","(is) All-Hearing"],["عَلِيمٞ","All-Knowing"]]},{"s":114,"a":5,"en":"Who whispers [evil] into the breasts of mankind -","w":[["ٱلَّذِي","The one who"],["يُوَسۡوِسُ","whispers"],["فِي","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]]},{"s":73,"a":3,"en":"Half of it - or subtract from it a little","w":[["نِّصۡفَهُۥٓ","Half of it"],["أَوِ","or"],["ٱنقُصۡ","lessen"],["مِنۡهُ","from it"],["قَلِيلًا","a little"]]},{"s":90,"a":19,"en":"But they who disbelieved in Our signs - those are the companions of the left.","w":[["وَٱلَّذِينَ","But those who"],["كَفَرُواْ","disbelieve"],["بِـَٔايَٰتِنَا","in Our Verses"],["هُمۡ","they"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡمَشۡـَٔمَةِ","(of) the left (hand)"]]},{"s":96,"a":15,"en":"No! If he does not desist, We will surely drag him by the forelock -","w":[["كَلَّا","Nay"],["لَئِن","If"],["لَّمۡ","not"],["يَنتَهِ","he desists"],["لَنَسۡفَعَۢا","surely We will drag him"],["بِٱلنَّاصِيَةِ","by the forelock"]]},{"s":105,"a":3,"en":"And He sent against them birds in flocks,","w":[["وَأَرۡسَلَ","And He sent"],["عَلَيۡهِمۡ","against them"],["طَيۡرًا","birds"],["أَبَابِيلَ","(in) flocks"]]},{"s":11,"a":115,"en":"And be patient, for indeed, Allah does not allow to be lost the reward of those who do good.","w":[["وَٱصۡبِرۡ","And be patient"],["فَإِنَّ","for indeed"],["ٱللَّهَ","Allah"],["لَا","(does) not"],["يُضِيعُ","let go waste"],["أَجۡرَ","(the) reward"],["ٱلۡمُحۡسِنِينَ","(of) the good-doers"]]},{"s":35,"a":20,"en":"Nor are the darknesses and the light,","w":[["وَلَا","And not"],["ٱلظُّلُمَٰتُ","the darkness [es]"],["وَلَا","and not"],["ٱلنُّورُ","[the] light"]]},{"s":18,"a":97,"en":"So Gog and Magog were unable to pass over it, nor were they able [to effect] in it any penetration.","w":[["فَمَا","So not"],["ٱسۡطَٰعُوٓاْ","they were able"],["أَن","to"],["يَظۡهَرُوهُ","scale it"],["وَمَا","and not"],["ٱسۡتَطَٰعُواْ","they were able"],["لَهُۥ","in it"],["نَقۡبٗا","(to do) any penetration"]]},{"s":82,"a":19,"en":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah.","w":[["يَوۡمَ","(The) Day"],["لَا","not"],["تَمۡلِكُ","will have power"],["نَفۡسٞ","a soul"],["لِّنَفۡسٖ","for a soul"],["شَيۡـٔٗاۖ","anything"],["وَٱلۡأَمۡرُ","and the Command"],["يَوۡمَئِذٖ","that Day"],["لِّلَّهِ","(will be) with Allah"]]},{"s":25,"a":66,"en":"Indeed, it is evil as a settlement and residence.\"","w":[["إِنَّهَا","Indeed,it"],["سَآءَتۡ","(is) an evil"],["مُسۡتَقَرّٗا","abode"],["وَمُقَامٗا","and resting place"]]},{"s":44,"a":19,"en":"And [saying], \"Be not haughty with Allah. Indeed, I have come to you with clear authority.","w":[["وَأَن","And that"],["لَّا","(do) not"],["تَعۡلُواْ","exalt yourselves"],["عَلَى","against"],["ٱللَّهِۖ","Allah"],["إِنِّيٓ","Indeed,I"],["ءَاتِيكُم","[I] have come to you"],["بِسُلۡطَٰنٖ","with an authority"],["مُّبِينٖ","clear"]]},{"s":7,"a":21,"en":"And he swore [by Allah] to them, \"Indeed, I am to you from among the sincere advisors.\"","w":[["وَقَاسَمَهُمَآ","And he swore (to) both of them"],["إِنِّي","Indeed,I am"],["لَكُمَا","to both of you"],["لَمِنَ","among"],["ٱلنَّـٰصِحِينَ","the sincere advisors"]]},{"s":28,"a":41,"en":"And We made them leaders inviting to the Fire, and on the Day of Resurrection they will not be helped.","w":[["وَجَعَلۡنَٰهُمۡ","And We made them"],["أَئِمَّةٗ","leaders"],["يَدۡعُونَ","inviting"],["إِلَى","to"],["ٱلنَّارِۖ","the Fire"],["وَيَوۡمَ","and (on the) Day"],["ٱلۡقِيَٰمَةِ","(of) the Resurrection"],["لَا","not"],["يُنصَرُونَ","they will be helped"]]},{"s":69,"a":5,"en":"So as for Thamud, they were destroyed by the overpowering [blast].","w":[["فَأَمَّا","So as for"],["ثَمُودُ","Thamud"],["فَأُهۡلِكُواْ","they were destroyed"],["بِٱلطَّاغِيَةِ","by the overpowering (blast)"]]},{"s":43,"a":4,"en":"And indeed it is, in the Mother of the Book with Us, exalted and full of wisdom.","w":[["وَإِنَّهُۥ","And indeed,it"],["فِيٓ","(is) in"],["أُمِّ","(the) Mother"],["ٱلۡكِتَٰبِ","(of) the Book"],["لَدَيۡنَا","with Us"],["لَعَلِيٌّ","surely exalted"],["حَكِيمٌ","full of wisdom"]]},{"s":85,"a":20,"en":"While Allah encompasses them from behind.","w":[["وَٱللَّهُ","But Allah"],["مِن","from"],["وَرَآئِهِم","behind them"],["مُّحِيطُۢ","encompasses"]]}]
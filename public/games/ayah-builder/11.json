[{"s":73,"a":8,"en":"And remember the name of your Lord and devote yourself to Him with [complete] devotion.","w":[["وَٱذۡكُرِ","And remember"],["ٱسۡمَ","(the) name"],["رَبِّكَ","(of) your Lord"],["وَتَبَتَّلۡ","and devote yourself"],["إِلَيۡهِ","to Him"],["تَبۡتِيلٗا","(with) devotion"]]},{"s":104,"a":4,"en":"No! He will surely be thrown into the Crusher.","w":[["كَلَّاۖ","Nay"],["لَيُنۢبَذَنَّ","Surely he will be thrown"],["فِي","in"],["ٱلۡحُطَمَةِ","the Crusher"]]},{"s":41,"a":2,"en":"[This is] a revelation from the Entirely Merciful, the Especially Merciful -","w":[["تَنزِيلٞ","A revelation"],["مِّنَ","from"],["ٱلرَّحۡمَٰنِ","the Most Gracious"],["ٱلرَّحِيمِ","the Most Merciful"]]},{"s":97,"a":1,"en":"Indeed, We sent the Qur'an down during the Night of Decree.","w":[["إِنَّآ","Indeed,We"],["أَنزَلۡنَٰهُ","revealed it"],["فِي","in"],["لَيۡلَةِ","(the) Night"],["ٱلۡقَدۡرِ","(of) Power"]]},{"s":50,"a":31,"en":"And Paradise will be brought near to the righteous, not far,","w":[["وَأُزۡلِفَتِ","And will be brought near"],["ٱلۡجَنَّةُ","the Paradise"],["لِلۡمُتَّقِينَ","to the righteous"],["غَيۡرَ","not"],["بَعِيدٍ","far"]]},{"s":23,"a":46,"en":"To Pharaoh and his establishment, but they were arrogant and were a haughty people.","w":[["إِلَىٰ","To"],["فِرۡعَوۡنَ","Firaun"],["وَمَلَإِيْهِۦ","and his chiefs"],["فَٱسۡتَكۡبَرُواْ","but they behaved arrogantly"],["وَكَانُواْ","and they were"],["قَوۡمًا","a people"],["عَالِينَ","haughty"]]},{"s":110,"a":2,"en":"And you see the people entering into the religion of Allah in multitudes,","w":[["وَرَأَيۡتَ","And you see"],["ٱلنَّاسَ","the people"],["يَدۡخُلُونَ","entering"],["فِي","into"],["دِينِ","(the) religion"],["ٱللَّهِ","(of) Allah"],["أَفۡوَاجٗا","(in) multitudes"]]},{"s":42,"a":41,"en":"And whoever avenges himself after having been wronged - those have not upon them any cause [for blame].","w":[["وَلَمَنِ","And surely whosoever"],["ٱنتَصَرَ","defends himself"],["بَعۡدَ","after"],["ظُلۡمِهِۦ","he has been wronged"],["فَأُوْلَـٰٓئِكَ","then those"],["مَا","not"],["عَلَيۡهِم","(is) against them"],["مِّن","any"],["سَبِيلٍ","way"]]},{"s":101,"a":4,"en":"It is the Day when people will be like moths, dispersed,","w":[["يَوۡمَ","(The) Day"],["يَكُونُ","will be"],["ٱلنَّاسُ","the mankind"],["كَٱلۡفَرَاشِ","like moths"],["ٱلۡمَبۡثُوثِ","scattered"]]},{"s":80,"a":26,"en":"Then We broke open the earth, splitting [it with sprouts],","w":[["ثُمَّ","Then"],["شَقَقۡنَا","We cleaved"],["ٱلۡأَرۡضَ","the earth"],["شَقّٗا","splitting"]]},{"s":107,"a":1,"en":"Have you seen the one who denies the Recompense?","w":[["أَرَءَيۡتَ","Have you seen"],["ٱلَّذِي","the one who"],["يُكَذِّبُ","denies"],["بِٱلدِّينِ","the Judgment"]]},{"s":20,"a":126,"en":"[Allah] will say, \"Thus did Our signs come to you, and you forgot them; and thus will you this Day be forgotten.\"","w":[["قَالَ","He will say"],["كَذَٰلِكَ","Thus"],["أَتَتۡكَ","came to you"],["ءَايَٰتُنَا","Our Signs"],["فَنَسِيتَهَاۖ","but you forgot them"],["وَكَذَٰلِكَ","and thus"],["ٱلۡيَوۡمَ","today"],["تُنسَىٰ","you will be forgotten"]]},{"s":61,"a":3,"en":"Great is hatred in the sight of Allah that you say what you do not do.","w":[["كَبُرَ","Great is"],["مَقۡتًا","hatred"],["عِندَ","with"],["ٱللَّهِ","Allah"],["أَن","that"],["تَقُولُواْ","you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":46,"a":6,"en":"And when the people are gathered [that Day], they [who were invoked] will be enemies to them, and they will be deniers of their worship.","w":[["وَإِذَا","And when"],["حُشِرَ","are gathered"],["ٱلنَّاسُ","the people"],["كَانُواْ","they will be"],["لَهُمۡ","for them"],["أَعۡدَآءٗ","enemies"],["وَكَانُواْ","and they will be"],["بِعِبَادَتِهِمۡ","of their worship"],["كَٰفِرِينَ","deniers"]]},{"s":31,"a":8,"en":"Indeed, those who believe and do righteous deeds - for them are the Gardens of Pleasure.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["لَهُمۡ","for them"],["جَنَّـٰتُ","(are) Gardens"],["ٱلنَّعِيمِ","(of) Delight"]]},{"s":90,"a":14,"en":"Or feeding on a day of severe hunger","w":[["أَوۡ","Or"],["إِطۡعَٰمٞ","feeding"],["فِي","in"],["يَوۡمٖ","a day"],["ذِي","of"],["مَسۡغَبَةٖ","severe hunger"]]},{"s":91,"a":10,"en":"And he has failed who instills it [with corruption].","w":[["وَقَدۡ","And indeed"],["خَابَ","he fails"],["مَن","who"],["دَسَّىٰهَا","buries it"]]},{"s":19,"a":79,"en":"No! We will record what he says and extend for him from the punishment extensively.","w":[["كَلَّاۚ","Nay"],["سَنَكۡتُبُ","We will record"],["مَا","what"],["يَقُولُ","he says"],["وَنَمُدُّ","and We will extend"],["لَهُۥ","for him"],["مِنَ","from"],["ٱلۡعَذَابِ","the punishment"],["مَدّٗا","extensively"]]},{"s":14,"a":33,"en":"And He subjected for you the sun and the moon, continuous [in orbit], and subjected for you the night and the day.","w":[["وَسَخَّرَ","And He subjected"],["لَكُمُ","for you"],["ٱلشَّمۡسَ","the sun"],["وَٱلۡقَمَرَ","and the moon"],["دَآئِبَيۡنِۖ","both constantly pursuing their courses"],["وَسَخَّرَ","and subjected"],["لَكُمُ","for you"],["ٱلَّيۡلَ","the night"],["وَٱلنَّهَارَ","and the day"]]},{"s":105,"a":1,"en":"Have you not considered, [O Muhammad], how your Lord dealt with the companions of the elephant?","w":[["أَلَمۡ","Have not"],["تَرَ","you seen"],["كَيۡفَ","how"],["فَعَلَ","dealt"],["رَبُّكَ","your Lord"],["بِأَصۡحَٰبِ","with (the) Companions"],["ٱلۡفِيلِ","(of the) Elephant"]]},{"s":64,"a":13,"en":"Allah - there is no deity except Him. And upon Allah let the believers rely.","w":[["ٱللَّهُ","Allah"],["لَآ","(there is) no"],["إِلَٰهَ","god"],["إِلَّا","except"],["هُوَۚ","Him"],["وَعَلَى","And upon"],["ٱللَّهِ","Allah"],["فَلۡيَتَوَكَّلِ","let put (their) trust"],["ٱلۡمُؤۡمِنُونَ","the believers"]]},{"s":51,"a":31,"en":"[Abraham] said, \"Then what is your business [here], O messengers?\"","w":[["۞قَالَ","He said"],["فَمَا","Then what"],["خَطۡبُكُمۡ","(is) your mission"],["أَيُّهَا","O messengers"],["ٱلۡمُرۡسَلُونَ","O messengers"]]},{"s":35,"a":16,"en":"If He wills, He can do away with you and bring forth a new creation.","w":[["إِن","If"],["يَشَأۡ","He wills"],["يُذۡهِبۡكُمۡ","He (can) do away with you"],["وَيَأۡتِ","and bring"],["بِخَلۡقٖ","in a creation"],["جَدِيدٖ","new"]]},{"s":30,"a":12,"en":"And the Day the Hour appears the criminals will be in despair.","w":[["وَيَوۡمَ","And (the) Day"],["تَقُومُ","will (be) established"],["ٱلسَّاعَةُ","the Hour"],["يُبۡلِسُ","will (be in) despair"],["ٱلۡمُجۡرِمُونَ","the criminals"]]},{"s":18,"a":72,"en":"[Al-Khidh r] said, \"Did I not say that with me you would never be able to have patience?\"","w":[["قَالَ","He said"],["أَلَمۡ","Did not"],["أَقُلۡ","I say"],["إِنَّكَ","indeed,you"],["لَن","never"],["تَسۡتَطِيعَ","will be able"],["مَعِيَ","with me"],["صَبۡرٗا","(to have) patience"]]},{"s":32,"a":21,"en":"And we will surely let them taste the nearer punishment short of the greater punishment that perhaps they will repent.","w":[["وَلَنُذِيقَنَّهُم","And surely,We will let them taste"],["مِّنَ","of"],["ٱلۡعَذَابِ","the punishment"],["ٱلۡأَدۡنَىٰ","the nearer"],["دُونَ","before"],["ٱلۡعَذَابِ","the punishment"],["ٱلۡأَكۡبَرِ","the greater"],["لَعَلَّهُمۡ","so that they may"],["يَرۡجِعُونَ","return"]]},{"s":54,"a":18,"en":"'Aad denied; and how [severe] were My punishment and warning.","w":[["كَذَّبَتۡ","Denied"],["عَادٞ","Aad"],["فَكَيۡفَ","so how"],["كَانَ","was"],["عَذَابِي","My punishment"],["وَنُذُرِ","and My warnings"]]},{"s":9,"a":1,"en":"[This is a declaration of] disassociation, from Allah and His Messenger, to those with whom you had made a treaty among the polytheists.","w":[["بَرَآءَةٞ","Freedom from obligations"],["مِّنَ","from"],["ٱللَّهِ","Allah"],["وَرَسُولِهِۦٓ","and His Messenger"],["إِلَى","to"],["ٱلَّذِينَ","those (with) whom"],["عَٰهَدتُّم","you made a covenant"],["مِّنَ","from"],["ٱلۡمُشۡرِكِينَ","the polytheists"]]},{"s":28,"a":66,"en":"But the information will be unapparent to them that Day, so they will not [be able to] ask one another.","w":[["فَعَمِيَتۡ","But (will) be obscure"],["عَلَيۡهِمُ","to them"],["ٱلۡأَنۢبَآءُ","the information"],["يَوۡمَئِذٖ","that day"],["فَهُمۡ","so they"],["لَا","will not ask one another"],["يَتَسَآءَلُونَ","will not ask one another"]]},{"s":71,"a":24,"en":"And already they have misled many. And, [my Lord], do not increase the wrongdoers except in error.\"","w":[["وَقَدۡ","And indeed"],["أَضَلُّواْ","they have led astray"],["كَثِيرٗاۖ","many"],["وَلَا","And not"],["تَزِدِ","increase"],["ٱلظَّـٰلِمِينَ","the wrongdoers"],["إِلَّا","except"],["ضَلَٰلٗا","(in) error"]]}]
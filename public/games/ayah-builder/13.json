[{"s":81,"a":27,"en":"It is not except a reminder to the worlds","w":[["إِنۡ","Not"],["هُوَ","it"],["إِلَّا","(is) except"],["ذِكۡرٞ","a reminder"],["لِّلۡعَٰلَمِينَ","to the worlds"]]},{"s":85,"a":6,"en":"When they were sitting near it","w":[["إِذۡ","When"],["هُمۡ","they"],["عَلَيۡهَا","by it"],["قُعُودٞ","(were) sitting"]]},{"s":33,"a":11,"en":"There the believers were tested and shaken with a severe shaking.","w":[["هُنَالِكَ","There"],["ٱبۡتُلِيَ","were tried"],["ٱلۡمُؤۡمِنُونَ","the believers"],["وَزُلۡزِلُواْ","and shaken"],["زِلۡزَالٗا","(with a) shake"],["شَدِيدٗا","severe"]]},{"s":114,"a":5,"en":"Who whispers [evil] into the breasts of mankind -","w":[["ٱلَّذِي","The one who"],["يُوَسۡوِسُ","whispers"],["فِي","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]]},{"s":12,"a":91,"en":"They said, \"By Allah, certainly has Allah preferred you over us, and indeed, we have been sinners.\"","w":[["قَالُواْ","They said"],["تَٱللَّهِ","By Allah"],["لَقَدۡ","certainly"],["ءَاثَرَكَ","Allah has preferred you"],["ٱللَّهُ","Allah has preferred you"],["عَلَيۡنَا","over us"],["وَإِن","and indeed"],["كُنَّا","we have been"],["لَخَٰطِـِٔينَ","sinners"]]},{"s":47,"a":24,"en":"Then do they not reflect upon the Qur'an, or are there locks upon [their] hearts?","w":[["أَفَلَا","Then do not"],["يَتَدَبَّرُونَ","they ponder"],["ٱلۡقُرۡءَانَ","(over) the Quran"],["أَمۡ","or"],["عَلَىٰ","upon"],["قُلُوبٍ","(their) hearts"],["أَقۡفَالُهَآ","(are) locks"]]},{"s":92,"a":19,"en":"And not [giving] for anyone who has [done him] a favor to be rewarded","w":[["وَمَا","And not"],["لِأَحَدٍ","for anyone"],["عِندَهُۥ","with him"],["مِن","any"],["نِّعۡمَةٖ","favor"],["تُجۡزَىٰٓ","to be recompensed"]]},{"s":82,"a":9,"en":"No! But you deny the Recompense.","w":[["كَلَّا","Nay"],["بَلۡ","But"],["تُكَذِّبُونَ","you deny"],["بِٱلدِّينِ","the Judgment"]]},{"s":56,"a":90,"en":"And if he was of the companions of the right,","w":[["وَأَمَّآ","And"],["إِن","if"],["كَانَ","he was"],["مِنۡ","of"],["أَصۡحَٰبِ","(the) companions"],["ٱلۡيَمِينِ","(of) the right"]]},{"s":53,"a":43,"en":"And that it is He who makes [one] laugh and weep","w":[["وَأَنَّهُۥ","And that He"],["هُوَ","[He]"],["أَضۡحَكَ","makes (one) laugh"],["وَأَبۡكَىٰ","and makes (one) weep"]]},{"s":108,"a":3,"en":"Indeed, your enemy is the one cut off.","w":[["إِنَّ","Indeed"],["شَانِئَكَ","your enemy"],["هُوَ","he (is)"],["ٱلۡأَبۡتَرُ","the one cut off"]]},{"s":79,"a":31,"en":"He extracted from it its water and its pasture,","w":[["أَخۡرَجَ","He brought forth"],["مِنۡهَا","from it"],["مَآءَهَا","its water"],["وَمَرۡعَىٰهَا","and its pasture"]]},{"s":67,"a":24,"en":"Say, \"It is He who has multiplied you throughout the earth, and to Him you will be gathered.\"","w":[["قُلۡ","Say"],["هُوَ","He"],["ٱلَّذِي","(is) the One Who"],["ذَرَأَكُمۡ","multiplied you"],["فِي","in"],["ٱلۡأَرۡضِ","the earth"],["وَإِلَيۡهِ","and to Him"],["تُحۡشَرُونَ","you will be gathered"]]},{"s":75,"a":26,"en":"No! When the soul has reached the collar bones","w":[["كَلَّآ","No"],["إِذَا","When"],["بَلَغَتِ","it reaches"],["ٱلتَّرَاقِيَ","the collar bones"]]},{"s":37,"a":23,"en":"Other than Allah, and guide them to the path of Hellfire","w":[["مِن","Besides"],["دُونِ","Besides"],["ٱللَّهِ","Allah"],["فَٱهۡدُوهُمۡ","then lead them"],["إِلَىٰ","to"],["صِرَٰطِ","(the) Path"],["ٱلۡجَحِيمِ","(of) the Hellfire"]]},{"s":3,"a":196,"en":"Be not deceived by the [uninhibited] movement of the disbelievers throughout the land.","w":[["لَا","(Let) not"],["يَغُرَّنَّكَ","deceive you"],["تَقَلُّبُ","(the) movement"],["ٱلَّذِينَ","(of) those who"],["كَفَرُواْ","disbelieved"],["فِي","in"],["ٱلۡبِلَٰدِ","the land"]]},{"s":1,"a":7,"en":"The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray.","w":[["صِرَٰطَ","(The) path"],["ٱلَّذِينَ","(of) those"],["أَنۡعَمۡتَ","You have bestowed (Your) Favors"],["عَلَيۡهِمۡ","on them"],["غَيۡرِ","not (of)"],["ٱلۡمَغۡضُوبِ","those who earned (Your) wrath"],["عَلَيۡهِمۡ","on themselves"],["وَلَا","and not"],["ٱلضَّآلِّينَ","(of) those who go astray"]]},{"s":29,"a":66,"en":"So that they will deny what We have granted them, and they will enjoy themselves. But they are going to know.","w":[["لِيَكۡفُرُواْ","So that they may deny"],["بِمَآ","[in] what"],["ءَاتَيۡنَٰهُمۡ","We have given them"],["وَلِيَتَمَتَّعُواْۚ","and they may enjoy (themselves)"],["فَسَوۡفَ","But soon"],["يَعۡلَمُونَ","they will know"]]},{"s":86,"a":5,"en":"So let man observe from what he was created.","w":[["فَلۡيَنظُرِ","So let see"],["ٱلۡإِنسَٰنُ","man"],["مِمَّ","from what"],["خُلِقَ","he is created"]]},{"s":74,"a":43,"en":"They will say, \"We were not of those who prayed,","w":[["قَالُواْ","They will say"],["لَمۡ","Not"],["نَكُ","we were"],["مِنَ","of"],["ٱلۡمُصَلِّينَ","those who prayed"]]},{"s":38,"a":82,"en":"[Iblees] said, \"By your might, I will surely mislead them all","w":[["قَالَ","He said"],["فَبِعِزَّتِكَ","Then by Your might"],["لَأُغۡوِيَنَّهُمۡ","I will surely mislead them"],["أَجۡمَعِينَ","all"]]},{"s":77,"a":32,"en":"Indeed, it throws sparks [as huge] as a fortress,","w":[["إِنَّهَا","Indeed,it"],["تَرۡمِي","throws up"],["بِشَرَرٖ","sparks"],["كَٱلۡقَصۡرِ","as the fortress"]]},{"s":112,"a":3,"en":"He neither begets nor is born,","w":[["لَمۡ","Not"],["يَلِدۡ","He begets"],["وَلَمۡ","and not"],["يُولَدۡ","He is begotten"]]},{"s":89,"a":18,"en":"And you do not encourage one another to feed the poor.","w":[["وَلَا","And not"],["تَحَـٰٓضُّونَ","you feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلۡمِسۡكِينِ","the poor"]]},{"s":13,"a":20,"en":"Those who fulfill the covenant of Allah and do not break the contract,","w":[["ٱلَّذِينَ","Those who"],["يُوفُونَ","fulfill"],["بِعَهۡدِ","the covenant"],["ٱللَّهِ","(of) Allah"],["وَلَا","and not"],["يَنقُضُونَ","they break"],["ٱلۡمِيثَٰقَ","the contract"]]},{"s":76,"a":19,"en":"There will circulate among them young boys made eternal. When you see them, you would think them [as beautiful as] scattered pearls.","w":[["۞وَيَطُوفُ","And will circulate"],["عَلَيۡهِمۡ","among them"],["وِلۡدَٰنٞ","young boys"],["مُّخَلَّدُونَ","made eternal"],["إِذَا","When"],["رَأَيۡتَهُمۡ","you see them"],["حَسِبۡتَهُمۡ","you would think them"],["لُؤۡلُؤٗا","(to be) pearls"],["مَّنثُورٗا","scattered"]]},{"s":15,"a":35,"en":"And indeed, upon you is the curse until the Day of Recompense.\"","w":[["وَإِنَّ","And indeed"],["عَلَيۡكَ","upon you"],["ٱللَّعۡنَةَ","(will be) the curse"],["إِلَىٰ","till"],["يَوۡمِ","(the) Day"],["ٱلدِّينِ","(of) [the] Judgment"]]},{"s":6,"a":85,"en":"And Zechariah and John and Jesus and Elias - and all were of the righteous.","w":[["وَزَكَرِيَّا","And Zakariya"],["وَيَحۡيَىٰ","and Yahya"],["وَعِيسَىٰ","and Isa"],["وَإِلۡيَاسَۖ","and Elijah"],["كُلّٞ","all (were)"],["مِّنَ","of"],["ٱلصَّـٰلِحِينَ","the righteous"]]},{"s":48,"a":19,"en":"And much war booty which they will take. And ever is Allah Exalted in Might and Wise.","w":[["وَمَغَانِمَ","And spoils of war"],["كَثِيرَةٗ","much"],["يَأۡخُذُونَهَاۗ","that they will take"],["وَكَانَ","and is"],["ٱللَّهُ","Allah"],["عَزِيزًا","All-Mighty"],["حَكِيمٗا","All-Wise"]]},{"s":21,"a":16,"en":"And We did not create the heaven and earth and that between them in play.","w":[["وَمَا","And not"],["خَلَقۡنَا","We created"],["ٱلسَّمَآءَ","the heavens"],["وَٱلۡأَرۡضَ","and the earth"],["وَمَا","and what"],["بَيۡنَهُمَا","(is) between them"],["لَٰعِبِينَ","(for) playing"]]}]
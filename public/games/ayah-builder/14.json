[{"s":44,"a":31,"en":"From Pharaoh. Indeed, he was a haughty one among the transgressors.","w":[["مِن","From"],["فِرۡعَوۡنَۚ","Firaun"],["إِنَّهُۥ","Indeed,he"],["كَانَ","was"],["عَالِيٗا","arrogant"],["مِّنَ","among"],["ٱلۡمُسۡرِفِينَ","the transgressors"]]},{"s":2,"a":5,"en":"Those are upon [right] guidance from their Lord, and it is those who are the successful.","w":[["أُوْلَـٰٓئِكَ","Those"],["عَلَىٰ","(are) on"],["هُدٗى","Guidance"],["مِّن","from"],["رَّبِّهِمۡۖ","their Lord"],["وَأُوْلَـٰٓئِكَ","and those"],["هُمُ","they"],["ٱلۡمُفۡلِحُونَ","(are) the successful ones"]]},{"s":109,"a":3,"en":"Nor are you worshippers of what I worship.","w":[["وَلَآ","And not"],["أَنتُمۡ","you"],["عَٰبِدُونَ","(are) worshippers"],["مَآ","(of) what"],["أَعۡبُدُ","I worship"]]},{"s":94,"a":5,"en":"For indeed, with hardship [will be] ease.","w":[["فَإِنَّ","So indeed"],["مَعَ","with"],["ٱلۡعُسۡرِ","the hardship"],["يُسۡرًا","(is) ease"]]},{"s":87,"a":13,"en":"Neither dying therein nor living.","w":[["ثُمَّ","Then"],["لَا","not"],["يَمُوتُ","he will die"],["فِيهَا","therein"],["وَلَا","and not"],["يَحۡيَىٰ","will live"]]},{"s":5,"a":102,"en":"A people asked such [questions] before you; then they became thereby disbelievers.","w":[["قَدۡ","Indeed"],["سَأَلَهَا","asked them"],["قَوۡمٞ","a people"],["مِّن","from"],["قَبۡلِكُمۡ","before you"],["ثُمَّ","then"],["أَصۡبَحُواْ","they became"],["بِهَا","thereby"],["كَٰفِرِينَ","disbelievers"]]},{"s":83,"a":29,"en":"Indeed, those who committed crimes used to laugh at those who believed.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["أَجۡرَمُواْ","committed crimes"],["كَانُواْ","used to"],["مِنَ","at"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believed"],["يَضۡحَكُونَ","laugh"]]},{"s":98,"a":7,"en":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["أُوْلَـٰٓئِكَ","those"],["هُمۡ","they"],["خَيۡرُ","(are the) best"],["ٱلۡبَرِيَّةِ","(of) the creatures"]]},{"s":52,"a":36,"en":"Or did they create the heavens and the earth? Rather, they are not certain.","w":[["أَمۡ","Or"],["خَلَقُواْ","(did) they create"],["ٱلسَّمَٰوَٰتِ","the heavens"],["وَٱلۡأَرۡضَۚ","and the earth"],["بَل","Nay"],["لَّا","not"],["يُوقِنُونَ","they are certain"]]},{"s":62,"a":3,"en":"And [to] others of them who have not yet joined them. And He is the Exalted in Might, the Wise.","w":[["وَءَاخَرِينَ","And others"],["مِنۡهُمۡ","among them"],["لَمَّا","who have not yet"],["يَلۡحَقُواْ","joined"],["بِهِمۡۚ","them"],["وَهُوَ","and He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":111,"a":5,"en":"Around her neck is a rope of [twisted] fiber.","w":[["فِي","In"],["جِيدِهَا","her neck"],["حَبۡلٞ","(will be) a rope"],["مِّن","of"],["مَّسَدِۭ","palm-fiber"]]},{"s":34,"a":52,"en":"And they will [then] say, \"We believe in it!\" But how for them will be the taking [of faith] from a place far away?","w":[["وَقَالُوٓاْ","And they will say"],["ءَامَنَّا","We believe"],["بِهِۦ","in it"],["وَأَنَّىٰ","But how"],["لَهُمُ","for them"],["ٱلتَّنَاوُشُ","(will be) the receiving"],["مِن","from"],["مَّكَانِۭ","a place"],["بَعِيدٖ","far off"]]},{"s":106,"a":3,"en":"Let them worship the Lord of this House,","w":[["فَلۡيَعۡبُدُواْ","So let them worship"],["رَبَّ","(the) Lord"],["هَٰذَا","(of) this"],["ٱلۡبَيۡتِ","House"]]},{"s":39,"a":12,"en":"And I have been commanded to be the first [among you] of the Muslims.\"","w":[["وَأُمِرۡتُ","And I am commanded"],["لِأَنۡ","that"],["أَكُونَ","I be"],["أَوَّلَ","(the) first"],["ٱلۡمُسۡلِمِينَ","(of) those who submit"]]},{"s":78,"a":15,"en":"That We may bring forth thereby grain and vegetation","w":[["لِّنُخۡرِجَ","That We may bring forth"],["بِهِۦ","thereby"],["حَبّٗا","grain"],["وَنَبَاتٗا","and vegetation"]]},{"s":103,"a":3,"en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","w":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلۡحَقِّ","to the truth"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلصَّبۡرِ","to [the] patience"]]},{"s":27,"a":54,"en":"And [mention] Lot, when he said to his people, \"Do you commit immorality while you are seeing?","w":[["وَلُوطًا","And Lut"],["إِذۡ","when"],["قَالَ","he said"],["لِقَوۡمِهِۦٓ","to his people"],["أَتَأۡتُونَ","Do you commit"],["ٱلۡفَٰحِشَةَ","[the] immorality"],["وَأَنتُمۡ","while you"],["تُبۡصِرُونَ","see"]]},{"s":49,"a":8,"en":"[It is] as bounty from Allah and favor. And Allah is Knowing and Wise.","w":[["فَضۡلٗا","A Bounty"],["مِّنَ","from Allah"],["ٱللَّهِ","from Allah"],["وَنِعۡمَةٗۚ","and favor"],["وَٱللَّهُ","And Allah"],["عَلِيمٌ","(is) All-Knower"],["حَكِيمٞ","All-Wise"]]},{"s":25,"a":75,"en":"Those will be awarded the Chamber for what they patiently endured, and they will be received therein with greetings and [words of] peace.","w":[["أُوْلَـٰٓئِكَ","Those"],["يُجۡزَوۡنَ","will be awarded"],["ٱلۡغُرۡفَةَ","the Chamber"],["بِمَا","because"],["صَبَرُواْ","they were patient"],["وَيُلَقَّوۡنَ","and they will be met"],["فِيهَا","therein"],["تَحِيَّةٗ","(with) greetings"],["وَسَلَٰمًا","and peace"]]},{"s":10,"a":79,"en":"And Pharaoh said, \"Bring to me every learned magician.\"","w":[["وَقَالَ","And Firaun said"],["فِرۡعَوۡنُ","And Firaun said"],["ٱئۡتُونِي","Bring to me"],["بِكُلِّ","every"],["سَٰحِرٍ","magician"],["عَلِيمٖ","learned"]]},{"s":95,"a":7,"en":"So what yet causes you to deny the Recompense?","w":[["فَمَا","Then what"],["يُكَذِّبُكَ","causes you to deny"],["بَعۡدُ","after (this)"],["بِٱلدِّينِ","the judgment"]]},{"s":6,"a":129,"en":"And thus will We make some of the wrongdoers allies of others for what they used to earn.","w":[["وَكَذَٰلِكَ","And thus"],["نُوَلِّي","We make friends"],["بَعۡضَ","some (of)"],["ٱلظَّـٰلِمِينَ","the wrongdoers"],["بَعۡضَۢا","(to) others"],["بِمَا","for what"],["كَانُواْ","they used to"],["يَكۡسِبُونَ","earn"]]},{"s":11,"a":90,"en":"And ask forgiveness of your Lord and then repent to Him. Indeed, my Lord is Merciful and Affectionate.\"","w":[["وَٱسۡتَغۡفِرُواْ","And ask forgiveness"],["رَبَّكُمۡ","(of) your Lord"],["ثُمَّ","then"],["تُوبُوٓاْ","turn in repentance"],["إِلَيۡهِۚ","to Him"],["إِنَّ","Indeed"],["رَبِّي","my Lord"],["رَحِيمٞ","(is) Most Merciful"],["وَدُودٞ","Most Loving"]]},{"s":40,"a":38,"en":"And he who believed said, \"O my people, follow me, I will guide you to the way of right conduct.","w":[["وَقَالَ","And said"],["ٱلَّذِيٓ","the one who"],["ءَامَنَ","believed"],["يَٰقَوۡمِ","O my people"],["ٱتَّبِعُونِ","Follow me"],["أَهۡدِكُمۡ","I will guide you"],["سَبِيلَ","(to the) way"],["ٱلرَّشَادِ","the right"]]},{"s":93,"a":5,"en":"And your Lord is going to give you, and you will be satisfied.","w":[["وَلَسَوۡفَ","And soon"],["يُعۡطِيكَ","will give you"],["رَبُّكَ","your Lord"],["فَتَرۡضَىٰٓ","then you will be satisfied"]]},{"s":76,"a":29,"en":"Indeed, this is a reminder, so he who wills may take to his Lord a way.","w":[["إِنَّ","Indeed"],["هَٰذِهِۦ","this"],["تَذۡكِرَةٞۖ","(is) a reminder"],["فَمَن","so whoever"],["شَآءَ","wills"],["ٱتَّخَذَ","let him take"],["إِلَىٰ","to"],["رَبِّهِۦ","his Lord"],["سَبِيلٗا","a way"]]},{"s":34,"a":38,"en":"And the ones who strive against Our verses to cause [them] failure - those will be brought into the punishment [to remain].","w":[["وَٱلَّذِينَ","And those who"],["يَسۡعَوۡنَ","strive"],["فِيٓ","against"],["ءَايَٰتِنَا","Our Verses"],["مُعَٰجِزِينَ","(to) cause failure"],["أُوْلَـٰٓئِكَ","those"],["فِي","into"],["ٱلۡعَذَابِ","the punishment"],["مُحۡضَرُونَ","(will be) brought"]]},{"s":67,"a":6,"en":"And for those who disbelieved in their Lord is the punishment of Hell, and wretched is the destination.","w":[["وَلِلَّذِينَ","And for those who"],["كَفَرُواْ","disbelieved"],["بِرَبِّهِمۡ","in their Lord"],["عَذَابُ","(is the) punishment"],["جَهَنَّمَۖ","(of) Hell"],["وَبِئۡسَ","and wretched is"],["ٱلۡمَصِيرُ","the destination"]]},{"s":92,"a":19,"en":"And not [giving] for anyone who has [done him] a favor to be rewarded","w":[["وَمَا","And not"],["لِأَحَدٍ","for anyone"],["عِندَهُۥ","with him"],["مِن","any"],["نِّعۡمَةٖ","favor"],["تُجۡزَىٰٓ","to be recompensed"]]},{"s":2,"a":252,"en":"These are the verses of Allah which We recite to you, [O Muhammad], in truth. And indeed, you are from among the messengers.","w":[["تِلۡكَ","These"],["ءَايَٰتُ","(are the) Verses"],["ٱللَّهِ","(of) Allah"],["نَتۡلُوهَا","We recite them"],["عَلَيۡكَ","to you"],["بِٱلۡحَقِّۚ","in [the] truth"],["وَإِنَّكَ","And indeed,you"],["لَمِنَ","(are) surely of"],["ٱلۡمُرۡسَلِينَ","the Messengers"]]}]
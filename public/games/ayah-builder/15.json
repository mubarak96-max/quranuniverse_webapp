[{"s":13,"a":12,"en":"It is He who shows you lightening, [causing] fear and aspiration, and generates the heavy clouds.","w":[["هُوَ","He"],["ٱلَّذِي","(is) the One Who"],["يُرِيكُمُ","shows you"],["ٱلۡبَرۡقَ","the lightning"],["خَوۡفٗا","a fear"],["وَطَمَعٗا","and a hope"],["وَيُنشِئُ","and brings up"],["ٱلسَّحَابَ","the clouds"],["ٱلثِّقَالَ","the heavy"]]},{"s":54,"a":20,"en":"Extracting the people as if they were trunks of palm trees uprooted.","w":[["تَنزِعُ","Plucking out"],["ٱلنَّاسَ","men"],["كَأَنَّهُمۡ","as if they (were)"],["أَعۡجَازُ","trunks"],["نَخۡلٖ","(of) date-palms"],["مُّنقَعِرٖ","uprooted"]]},{"s":85,"a":6,"en":"When they were sitting near it","w":[["إِذۡ","When"],["هُمۡ","they"],["عَلَيۡهَا","by it"],["قُعُودٞ","(were) sitting"]]},{"s":31,"a":8,"en":"Indeed, those who believe and do righteous deeds - for them are the Gardens of Pleasure.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["لَهُمۡ","for them"],["جَنَّـٰتُ","(are) Gardens"],["ٱلنَّعِيمِ","(of) Delight"]]},{"s":98,"a":2,"en":"A Messenger from Allah, reciting purified scriptures","w":[["رَسُولٞ","A Messenger"],["مِّنَ","from"],["ٱللَّهِ","Allah"],["يَتۡلُواْ","reciting"],["صُحُفٗا","pages"],["مُّطَهَّرَةٗ","purified"]]},{"s":5,"a":30,"en":"And his soul permitted to him the murder of his brother, so he killed him and became among the losers.","w":[["فَطَوَّعَتۡ","Then prompted"],["لَهُۥ","to him"],["نَفۡسُهُۥ","his soul"],["قَتۡلَ","(to) kill"],["أَخِيهِ","his brother"],["فَقَتَلَهُۥ","so he killed him"],["فَأَصۡبَحَ","and became"],["مِنَ","of"],["ٱلۡخَٰسِرِينَ","the losers"]]},{"s":33,"a":61,"en":"Accursed wherever they are found, [being] seized and massacred completely.","w":[["مَّلۡعُونِينَۖ","Accursed"],["أَيۡنَمَا","wherever"],["ثُقِفُوٓاْ","they are found"],["أُخِذُواْ","they are seized"],["وَقُتِّلُواْ","and massacred completely"],["تَقۡتِيلٗا","and massacred completely"]]},{"s":101,"a":5,"en":"And the mountains will be like wool, fluffed up.","w":[["وَتَكُونُ","And will be"],["ٱلۡجِبَالُ","the mountains"],["كَٱلۡعِهۡنِ","like wool"],["ٱلۡمَنفُوشِ","fluffed up"]]},{"s":111,"a":5,"en":"Around her neck is a rope of [twisted] fiber.","w":[["فِي","In"],["جِيدِهَا","her neck"],["حَبۡلٞ","(will be) a rope"],["مِّن","of"],["مَّسَدِۭ","palm-fiber"]]},{"s":52,"a":27,"en":"So Allah conferred favor upon us and protected us from the punishment of the Scorching Fire.","w":[["فَمَنَّ","But Allah conferred favor"],["ٱللَّهُ","But Allah conferred favor"],["عَلَيۡنَا","upon us"],["وَوَقَىٰنَا","and protected us"],["عَذَابَ","(from the) punishment"],["ٱلسَّمُومِ","(of) the Scorching Fire"]]},{"s":97,"a":4,"en":"The angels and the Spirit descend therein by permission of their Lord for every matter.","w":[["تَنَزَّلُ","Descend"],["ٱلۡمَلَـٰٓئِكَةُ","the Angels"],["وَٱلرُّوحُ","and the Spirit"],["فِيهَا","therein"],["بِإِذۡنِ","by (the) permission"],["رَبِّهِم","(of) their Lord"],["مِّن","for"],["كُلِّ","every"],["أَمۡرٖ","affair"]]},{"s":39,"a":70,"en":"And every soul will be fully compensated [for] what it did; and He is most knowing of what they do.","w":[["وَوُفِّيَتۡ","And (will) be paid in full"],["كُلُّ","every"],["نَفۡسٖ","soul"],["مَّا","what"],["عَمِلَتۡ","it did"],["وَهُوَ","and He"],["أَعۡلَمُ","(is the) Best-Knower"],["بِمَا","of what"],["يَفۡعَلُونَ","they do"]]},{"s":15,"a":8,"en":"We do not send down the angels except with truth; and the disbelievers would not then be reprieved.","w":[["مَا","Not"],["نُنَزِّلُ","We send down"],["ٱلۡمَلَـٰٓئِكَةَ","the Angels"],["إِلَّا","except"],["بِٱلۡحَقِّ","with the truth"],["وَمَا","and not"],["كَانُوٓاْ","they would be"],["إِذٗا","then"],["مُّنظَرِينَ","given respite"]]},{"s":58,"a":21,"en":"Allah has written, \"I will surely overcome, I and My messengers.\" Indeed, Allah is Powerful and Exalted in Might.","w":[["كَتَبَ","Allah has decreed"],["ٱللَّهُ","Allah has decreed"],["لَأَغۡلِبَنَّ","Surely,I will overcome"],["أَنَا۠","I"],["وَرُسُلِيٓۚ","and My Messengers"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["قَوِيٌّ","(is) All-Strong"],["عَزِيزٞ","All-Mighty"]]},{"s":65,"a":9,"en":"And it tasted the bad consequence of its affair, and the outcome of its affair was loss.","w":[["فَذَاقَتۡ","So it tasted"],["وَبَالَ","(the bad) consequence"],["أَمۡرِهَا","(of) its affair"],["وَكَانَ","and was"],["عَٰقِبَةُ","(the) end"],["أَمۡرِهَا","(of) its affair"],["خُسۡرًا","loss"]]},{"s":100,"a":6,"en":"Indeed mankind, to his Lord, is ungrateful.","w":[["إِنَّ","Indeed"],["ٱلۡإِنسَٰنَ","mankind"],["لِرَبِّهِۦ","to his Lord"],["لَكَنُودٞ","(is) surely ungrateful"]]},{"s":114,"a":5,"en":"Who whispers [evil] into the breasts of mankind -","w":[["ٱلَّذِي","The one who"],["يُوَسۡوِسُ","whispers"],["فِي","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]]},{"s":107,"a":1,"en":"Have you seen the one who denies the Recompense?","w":[["أَرَءَيۡتَ","Have you seen"],["ٱلَّذِي","the one who"],["يُكَذِّبُ","denies"],["بِٱلدِّينِ","the Judgment"]]},{"s":71,"a":17,"en":"And Allah has caused you to grow from the earth a [progressive] growth.","w":[["وَٱللَّهُ","And Allah"],["أَنۢبَتَكُم","has caused you to grow"],["مِّنَ","from"],["ٱلۡأَرۡضِ","the earth"],["نَبَاتٗا","(as) a growth"]]},{"s":23,"a":26,"en":"[Noah] said, \"My Lord, support me because they have denied me.\"","w":[["قَالَ","He said"],["رَبِّ","My Lord"],["ٱنصُرۡنِي","Help me"],["بِمَا","because"],["كَذَّبُونِ","they deny me"]]},{"s":90,"a":12,"en":"And what can make you know what is [breaking through] the difficult pass?","w":[["وَمَآ","And what"],["أَدۡرَىٰكَ","can make you know"],["مَا","what"],["ٱلۡعَقَبَةُ","the steep path (is)"]]},{"s":84,"a":4,"en":"And has cast out that within it and relinquished [it]","w":[["وَأَلۡقَتۡ","And has cast out"],["مَا","what"],["فِيهَا","(is) in it"],["وَتَخَلَّتۡ","and becomes empty"]]},{"s":43,"a":87,"en":"And if you asked them who created them, they would surely say, \"Allah.\" So how are they deluded?","w":[["وَلَئِن","And if"],["سَأَلۡتَهُم","you ask them"],["مَّنۡ","who"],["خَلَقَهُمۡ","created them"],["لَيَقُولُنَّ","they will certainly say"],["ٱللَّهُۖ","Allah"],["فَأَنَّىٰ","Then how"],["يُؤۡفَكُونَ","are they deluded"]]},{"s":80,"a":19,"en":"From a sperm-drop He created him and destined for him;","w":[["مِن","From"],["نُّطۡفَةٍ","a semen-drop"],["خَلَقَهُۥ","He created him"],["فَقَدَّرَهُۥ","then He proportioned him"]]},{"s":51,"a":19,"en":"And from their properties was [given] the right of the [needy] petitioner and the deprived.","w":[["وَفِيٓ","And in"],["أَمۡوَٰلِهِمۡ","their wealth"],["حَقّٞ","(was the) right"],["لِّلسَّآئِلِ","(of) those who asked"],["وَٱلۡمَحۡرُومِ","and the deprived"]]},{"s":83,"a":13,"en":"When Our verses are recited to him, he says, \"Legends of the former peoples.\"","w":[["إِذَا","When"],["تُتۡلَىٰ","are recited"],["عَلَيۡهِ","to him"],["ءَايَٰتُنَا","Our Verses"],["قَالَ","he says"],["أَسَٰطِيرُ","Stories"],["ٱلۡأَوَّلِينَ","(of) the former (people)"]]},{"s":106,"a":3,"en":"Let them worship the Lord of this House,","w":[["فَلۡيَعۡبُدُواْ","So let them worship"],["رَبَّ","(the) Lord"],["هَٰذَا","(of) this"],["ٱلۡبَيۡتِ","House"]]},{"s":21,"a":26,"en":"And they say, \"The Most Merciful has taken a son.\" Exalted is He! Rather, they are [but] honored servants.","w":[["وَقَالُواْ","And they say"],["ٱتَّخَذَ","Has taken"],["ٱلرَّحۡمَٰنُ","the Most Gracious"],["وَلَدٗاۗ","a son"],["سُبۡحَٰنَهُۥۚ","Glorified is He"],["بَلۡ","Nay"],["عِبَادٞ","(they are) slaves"],["مُّكۡرَمُونَ","honored"]]},{"s":82,"a":7,"en":"Who created you, proportioned you, and balanced you?","w":[["ٱلَّذِي","Who"],["خَلَقَكَ","created you"],["فَسَوَّىٰكَ","then fashioned you"],["فَعَدَلَكَ","then balanced you"]]},{"s":75,"a":1,"en":"I swear by the Day of Resurrection","w":[["لَآ","Nay"],["أُقۡسِمُ","I swear"],["بِيَوۡمِ","by (the) Day"],["ٱلۡقِيَٰمَةِ","(of) the Resurrection"]]}]
[{"s":79,"a":13,"en":"Indeed, it will be but one shout,","w":[["فَإِنَّمَا","Then only"],["هِيَ","it"],["زَجۡرَةٞ","(will be) a shout"],["وَٰحِدَةٞ","single"]]},{"s":7,"a":174,"en":"And thus do We [explain in] detail the verses, and perhaps they will return.","w":[["وَكَذَٰلِكَ","And thus"],["نُفَصِّلُ","We explain"],["ٱلۡأٓيَٰتِ","the Verses"],["وَلَعَلَّهُمۡ","so that they may"],["يَرۡجِعُونَ","return"]]},{"s":70,"a":40,"en":"So I swear by the Lord of [all] risings and settings that indeed We are able","w":[["فَلَآ","But nay"],["أُقۡسِمُ","I swear"],["بِرَبِّ","by (the) Lord"],["ٱلۡمَشَٰرِقِ","(of) the risings"],["وَٱلۡمَغَٰرِبِ","and the settings"],["إِنَّا","that We"],["لَقَٰدِرُونَ","(are) surely Able"]]},{"s":110,"a":2,"en":"And you see the people entering into the religion of Allah in multitudes,","w":[["وَرَأَيۡتَ","And you see"],["ٱلنَّاسَ","the people"],["يَدۡخُلُونَ","entering"],["فِي","into"],["دِينِ","(the) religion"],["ٱللَّهِ","(of) Allah"],["أَفۡوَاجٗا","(in) multitudes"]]},{"s":109,"a":6,"en":"For you is your religion, and for me is my religion.\"","w":[["لَكُمۡ","For you"],["دِينُكُمۡ","(is) your religion"],["وَلِيَ","and for me"],["دِينِ","(is) my religion"]]},{"s":28,"a":69,"en":"And your Lord knows what their breasts conceal and what they declare.","w":[["وَرَبُّكَ","And your Lord"],["يَعۡلَمُ","knows"],["مَا","what"],["تُكِنُّ","conceals"],["صُدُورُهُمۡ","their breasts"],["وَمَا","and what"],["يُعۡلِنُونَ","they declare"]]},{"s":99,"a":7,"en":"So whoever does an atom's weight of good will see it,","w":[["فَمَن","So whoever"],["يَعۡمَلۡ","does"],["مِثۡقَالَ","(equal to the) weight"],["ذَرَّةٍ","(of) an atom"],["خَيۡرٗا","good"],["يَرَهُۥ","will see it"]]},{"s":89,"a":9,"en":"And [with] Thamud, who carved out the rocks in the valley?","w":[["وَثَمُودَ","And Thamud"],["ٱلَّذِينَ","who"],["جَابُواْ","carved out"],["ٱلصَّخۡرَ","the rocks"],["بِٱلۡوَادِ","in the valley"]]},{"s":30,"a":31,"en":"[Adhere to it], turning in repentance to Him, and fear Him and establish prayer and do not be of those who associate others with Allah","w":[["۞مُنِيبِينَ","Turning"],["إِلَيۡهِ","to Him"],["وَٱتَّقُوهُ","and fear Him"],["وَأَقِيمُواْ","and establish"],["ٱلصَّلَوٰةَ","the prayer"],["وَلَا","and (do) not"],["تَكُونُواْ","be"],["مِنَ","of"],["ٱلۡمُشۡرِكِينَ","the polytheists"]]},{"s":3,"a":2,"en":"Allah - there is no deity except Him, the Ever-Living, the Sustainer of existence.","w":[["ٱللَّهُ","Allah"],["لَآ","(there is) no"],["إِلَٰهَ","God"],["إِلَّا","except"],["هُوَ","Him"],["ٱلۡحَيُّ","the Ever-Living"],["ٱلۡقَيُّومُ","the Sustainer of all that exists"]]},{"s":35,"a":16,"en":"If He wills, He can do away with you and bring forth a new creation.","w":[["إِن","If"],["يَشَأۡ","He wills"],["يُذۡهِبۡكُمۡ","He (can) do away with you"],["وَيَأۡتِ","and bring"],["بِخَلۡقٖ","in a creation"],["جَدِيدٖ","new"]]},{"s":108,"a":3,"en":"Indeed, your enemy is the one cut off.","w":[["إِنَّ","Indeed"],["شَانِئَكَ","your enemy"],["هُوَ","he (is)"],["ٱلۡأَبۡتَرُ","the one cut off"]]},{"s":88,"a":7,"en":"Which neither nourishes nor avails against hunger.","w":[["لَّا","Not"],["يُسۡمِنُ","it nourishes"],["وَلَا","and not"],["يُغۡنِي","it avails"],["مِن","from"],["جُوعٖ","hunger"]]},{"s":62,"a":3,"en":"And [to] others of them who have not yet joined them. And He is the Exalted in Might, the Wise.","w":[["وَءَاخَرِينَ","And others"],["مِنۡهُمۡ","among them"],["لَمَّا","who have not yet"],["يَلۡحَقُواْ","joined"],["بِهِمۡۚ","them"],["وَهُوَ","and He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":47,"a":8,"en":"But those who disbelieve - for them is misery, and He will waste their deeds.","w":[["وَٱلَّذِينَ","But those who"],["كَفَرُواْ","disbelieve"],["فَتَعۡسٗا","destruction (is)"],["لَّهُمۡ","for them"],["وَأَضَلَّ","and He will cause to be lost"],["أَعۡمَٰلَهُمۡ","their deeds"]]},{"s":24,"a":42,"en":"And to Allah belongs the dominion of the heavens and the earth, and to Allah is the destination.","w":[["وَلِلَّهِ","And to Allah (belongs)"],["مُلۡكُ","(the) dominion"],["ٱلسَّمَٰوَٰتِ","(of) the heavens"],["وَٱلۡأَرۡضِۖ","and the earth"],["وَإِلَى","And to"],["ٱللَّهِ","Allah"],["ٱلۡمَصِيرُ","(is) the destination"]]},{"s":102,"a":4,"en":"Then no! You are going to know.","w":[["ثُمَّ","Then"],["كَلَّا","nay"],["سَوۡفَ","Soon"],["تَعۡلَمُونَ","you will know"]]},{"s":44,"a":45,"en":"Like murky oil, it boils within bellies","w":[["كَٱلۡمُهۡلِ","Like the murky oil"],["يَغۡلِي","it will boil"],["فِي","in"],["ٱلۡبُطُونِ","the bellies"]]},{"s":42,"a":32,"en":"And of His signs are the ships in the sea, like mountains.","w":[["وَمِنۡ","And among"],["ءَايَٰتِهِ","His Signs"],["ٱلۡجَوَارِ","(are) the ships"],["فِي","in"],["ٱلۡبَحۡرِ","the sea"],["كَٱلۡأَعۡلَٰمِ","like [the] mountains"]]},{"s":113,"a":4,"en":"And from the evil of the blowers in knots","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["ٱلنَّفَّـٰثَٰتِ","(of) the blowers"],["فِي","in"],["ٱلۡعُقَدِ","the knots"]]},{"s":38,"a":36,"en":"So We subjected to him the wind blowing by his command, gently, wherever he directed,","w":[["فَسَخَّرۡنَا","Then We subjected"],["لَهُ","to him"],["ٱلرِّيحَ","the wind"],["تَجۡرِي","to flow"],["بِأَمۡرِهِۦ","by his command"],["رُخَآءً","gently"],["حَيۡثُ","wherever"],["أَصَابَ","he directed"]]},{"s":86,"a":8,"en":"Indeed, Allah, to return him [to life], is Able.","w":[["إِنَّهُۥ","Indeed,He"],["عَلَىٰ","to"],["رَجۡعِهِۦ","return him"],["لَقَادِرٞ","(is) Able"]]},{"s":56,"a":68,"en":"And have you seen the water that you drink?","w":[["أَفَرَءَيۡتُمُ","Do you see"],["ٱلۡمَآءَ","the water"],["ٱلَّذِي","which"],["تَشۡرَبُونَ","you drink"]]},{"s":105,"a":4,"en":"Striking them with stones of hard clay,","w":[["تَرۡمِيهِم","Striking them"],["بِحِجَارَةٖ","with stones"],["مِّن","of"],["سِجِّيلٖ","baked clay"]]},{"s":94,"a":1,"en":"Did We not expand for you, [O Muhammad], your breast?","w":[["أَلَمۡ","Have not"],["نَشۡرَحۡ","We expanded"],["لَكَ","for you"],["صَدۡرَكَ","your breast"]]},{"s":12,"a":44,"en":"They said, \"[It is but] a mixture of false dreams, and we are not learned in the interpretation of dreams.\"","w":[["قَالُوٓاْ","They said"],["أَضۡغَٰثُ","Confused"],["أَحۡلَٰمٖۖ","dreams"],["وَمَا","and not"],["نَحۡنُ","we"],["بِتَأۡوِيلِ","(are) in the interpretation"],["ٱلۡأَحۡلَٰمِ","(of) the dreams"],["بِعَٰلِمِينَ","learned"]]},{"s":20,"a":50,"en":"He said, \"Our Lord is He who gave each thing its form and then guided [it].\"","w":[["قَالَ","He said"],["رَبُّنَا","Our Lord"],["ٱلَّذِيٓ","(is) the One Who"],["أَعۡطَىٰ","gave"],["كُلَّ","(to) every"],["شَيۡءٍ","thing"],["خَلۡقَهُۥ","its form"],["ثُمَّ","then"],["هَدَىٰ","He guided (it)"]]},{"s":103,"a":2,"en":"Indeed, mankind is in loss,","w":[["إِنَّ","Indeed"],["ٱلۡإِنسَٰنَ","mankind"],["لَفِي","(is) surely,in"],["خُسۡرٍ","loss"]]},{"s":4,"a":156,"en":"And [We cursed them] for their disbelief and their saying against Mary a great slander,","w":[["وَبِكُفۡرِهِمۡ","And for their disbelief"],["وَقَوۡلِهِمۡ","and their saying"],["عَلَىٰ","against"],["مَرۡيَمَ","Maryam"],["بُهۡتَٰنًا","a slander"],["عَظِيمٗا","great"]]},{"s":16,"a":58,"en":"And when one of them is informed of [the birth of] a female, his face becomes dark, and he suppresses grief.","w":[["وَإِذَا","And when"],["بُشِّرَ","is given good news"],["أَحَدُهُم","(to) one of them"],["بِٱلۡأُنثَىٰ","of a female"],["ظَلَّ","turns"],["وَجۡهُهُۥ","his face"],["مُسۡوَدّٗا","dark"],["وَهُوَ","and he"],["كَظِيمٞ","suppresses grief"]]}]
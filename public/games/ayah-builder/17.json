[{"s":77,"a":43,"en":"[Being told], \"Eat and drink in satisfaction for what you used to do.\"","w":[["كُلُواْ","Eat"],["وَٱشۡرَبُواْ","and drink"],["هَنِيٓـَٔۢا","(in) satisfaction"],["بِمَا","for what"],["كُنتُمۡ","you used to"],["تَعۡمَلُونَ","do"]]},{"s":55,"a":44,"en":"They will go around between it and scalding water, heated [to the utmost degree].","w":[["يَطُوفُونَ","They will go around"],["بَيۡنَهَا","between it"],["وَبَيۡنَ","and between"],["حَمِيمٍ","scalding water"],["ءَانٖ","heated"]]},{"s":29,"a":9,"en":"And those who believe and do righteous deeds - We will surely admit them among the righteous [into Paradise].","w":[["وَٱلَّذِينَ","And those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["لَنُدۡخِلَنَّهُمۡ","We will surely admit them"],["فِي","among"],["ٱلصَّـٰلِحِينَ","the righteous"]]},{"s":8,"a":64,"en":"O Prophet, sufficient for you is Allah and for whoever follows you of the believers.","w":[["يَـٰٓأَيُّهَا","O"],["ٱلنَّبِيُّ","Prophet"],["حَسۡبُكَ","Sufficient for you"],["ٱللَّهُ","(is) Allah"],["وَمَنِ","and whoever"],["ٱتَّبَعَكَ","follows you"],["مِنَ","of"],["ٱلۡمُؤۡمِنِينَ","the believers"]]},{"s":78,"a":29,"en":"But all things We have enumerated in writing.","w":[["وَكُلَّ","And every"],["شَيۡءٍ","thing"],["أَحۡصَيۡنَٰهُ","We have enumerated it"],["كِتَٰبٗا","(in) a Book"]]},{"s":73,"a":7,"en":"Indeed, for you by day is prolonged occupation.","w":[["إِنَّ","Indeed"],["لَكَ","for you"],["فِي","in"],["ٱلنَّهَارِ","the day"],["سَبۡحٗا","(is) occupation"],["طَوِيلٗا","prolonged"]]},{"s":72,"a":16,"en":"And [Allah revealed] that if they had remained straight on the way, We would have given them abundant provision","w":[["وَأَلَّوِ","And that if"],["ٱسۡتَقَٰمُواْ","they had remained"],["عَلَى","on"],["ٱلطَّرِيقَةِ","the Way"],["لَأَسۡقَيۡنَٰهُم","surely We (would) have given them to drink"],["مَّآءً","water"],["غَدَقٗا","(in) abundance"]]},{"s":45,"a":36,"en":"Then, to Allah belongs [all] praise - Lord of the heavens and Lord of the earth, Lord of the worlds.","w":[["فَلِلَّهِ","Then for Allah"],["ٱلۡحَمۡدُ","(is) all the praise"],["رَبِّ","(the) Lord"],["ٱلسَّمَٰوَٰتِ","(of) the heavens"],["وَرَبِّ","and (the) Lord"],["ٱلۡأَرۡضِ","(of) the earth"],["رَبِّ","(the) lord"],["ٱلۡعَٰلَمِينَ","(of) the worlds"]]},{"s":22,"a":24,"en":"And they had been guided [in worldly life] to good speech, and they were guided to the path of the Praiseworthy.","w":[["وَهُدُوٓاْ","And they were guided"],["إِلَى","to"],["ٱلطَّيِّبِ","the good"],["مِنَ","of"],["ٱلۡقَوۡلِ","the speech"],["وَهُدُوٓاْ","and they were guided"],["إِلَىٰ","to"],["صِرَٰطِ","(the) path"],["ٱلۡحَمِيدِ","(of) the Praiseworthy"]]},{"s":87,"a":9,"en":"So remind, if the reminder should benefit;","w":[["فَذَكِّرۡ","So remind"],["إِن","if"],["نَّفَعَتِ","benefits"],["ٱلذِّكۡرَىٰ","the reminder"]]},{"s":91,"a":9,"en":"He has succeeded who purifies it,","w":[["قَدۡ","Indeed"],["أَفۡلَحَ","he succeeds"],["مَن","who"],["زَكَّىٰهَا","purifies it"]]},{"s":27,"a":50,"en":"And they planned a plan, and We planned a plan, while they perceived not.","w":[["وَمَكَرُواْ","So they plotted"],["مَكۡرٗا","a plot"],["وَمَكَرۡنَا","and We planned"],["مَكۡرٗا","a plan"],["وَهُمۡ","while they"],["لَا","(did) not"],["يَشۡعُرُونَ","perceive"]]},{"s":96,"a":19,"en":"No! Do not obey him. But prostrate and draw near [to Allah].","w":[["كَلَّا","Nay"],["لَا","(Do) not"],["تُطِعۡهُ","obey him"],["وَٱسۡجُدۡۤ","But prostrate"],["وَٱقۡتَرِب۩","and draw near (to Allah)"]]},{"s":48,"a":19,"en":"And much war booty which they will take. And ever is Allah Exalted in Might and Wise.","w":[["وَمَغَانِمَ","And spoils of war"],["كَثِيرَةٗ","much"],["يَأۡخُذُونَهَاۗ","that they will take"],["وَكَانَ","and is"],["ٱللَّهُ","Allah"],["عَزِيزًا","All-Mighty"],["حَكِيمٗا","All-Wise"]]},{"s":17,"a":22,"en":"Do not make [as equal] with Allah another deity and [thereby] become censured and forsaken.","w":[["لَّا","(Do) not"],["تَجۡعَلۡ","make"],["مَعَ","with"],["ٱللَّهِ","Allah"],["إِلَٰهًا","god"],["ءَاخَرَ","another"],["فَتَقۡعُدَ","lest you will sit"],["مَذۡمُومٗا","disgraced"],["مَّخۡذُولٗا","forsaken"]]},{"s":46,"a":14,"en":"Those are the companions of Paradise, abiding eternally therein as reward for what they used to do.","w":[["أُوْلَـٰٓئِكَ","Those"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡجَنَّةِ","(of) Paradise"],["خَٰلِدِينَ","abiding forever"],["فِيهَا","therein"],["جَزَآءَۢ","a reward"],["بِمَا","for what"],["كَانُواْ","they used to"],["يَعۡمَلُونَ","do"]]},{"s":49,"a":8,"en":"[It is] as bounty from Allah and favor. And Allah is Knowing and Wise.","w":[["فَضۡلٗا","A Bounty"],["مِّنَ","from Allah"],["ٱللَّهِ","from Allah"],["وَنِعۡمَةٗۚ","and favor"],["وَٱللَّهُ","And Allah"],["عَلِيمٌ","(is) All-Knower"],["حَكِيمٞ","All-Wise"]]},{"s":81,"a":24,"en":"And Muhammad is not a withholder of [knowledge of] the unseen.","w":[["وَمَا","And not"],["هُوَ","he (is)"],["عَلَى","on"],["ٱلۡغَيۡبِ","the unseen"],["بِضَنِينٖ","a withholder"]]},{"s":64,"a":13,"en":"Allah - there is no deity except Him. And upon Allah let the believers rely.","w":[["ٱللَّهُ","Allah"],["لَآ","(there is) no"],["إِلَٰهَ","god"],["إِلَّا","except"],["هُوَۚ","Him"],["وَعَلَى","And upon"],["ٱللَّهِ","Allah"],["فَلۡيَتَوَكَّلِ","let put (their) trust"],["ٱلۡمُؤۡمِنُونَ","the believers"]]},{"s":25,"a":25,"en":"And [mention] the Day when the heaven will split open with [emerging] clouds, and the angels will be sent down in successive descent.","w":[["وَيَوۡمَ","And (the) Day"],["تَشَقَّقُ","will split open"],["ٱلسَّمَآءُ","the heavens"],["بِٱلۡغَمَٰمِ","with the clouds"],["وَنُزِّلَ","and (will be) sent down"],["ٱلۡمَلَـٰٓئِكَةُ","the Angels"],["تَنزِيلًا","descending"]]},{"s":36,"a":68,"en":"And he to whom We grant long life We reverse in creation; so will they not understand?","w":[["وَمَن","And (he) whom"],["نُّعَمِّرۡهُ","We grant him long life"],["نُنَكِّسۡهُ","We reverse him"],["فِي","in"],["ٱلۡخَلۡقِۚ","the creation"],["أَفَلَا","Then will not"],["يَعۡقِلُونَ","they use intellect"]]},{"s":10,"a":82,"en":"And Allah will establish the truth by His words, even if the criminals dislike it.\"","w":[["وَيُحِقُّ","And Allah will establish"],["ٱللَّهُ","And Allah will establish"],["ٱلۡحَقَّ","the truth"],["بِكَلِمَٰتِهِۦ","by His words"],["وَلَوۡ","even if"],["كَرِهَ","dislike it"],["ٱلۡمُجۡرِمُونَ","the criminals"]]},{"s":112,"a":4,"en":"Nor is there to Him any equivalent.\"","w":[["وَلَمۡ","And not"],["يَكُن","is"],["لَّهُۥ","for Him"],["كُفُوًا","equivalent"],["أَحَدُۢ","any [one]"]]},{"s":41,"a":19,"en":"And [mention, O Muhammad], the Day when the enemies of Allah will be gathered to the Fire while they are [driven] assembled in rows,","w":[["وَيَوۡمَ","And (the) Day"],["يُحۡشَرُ","will be gathered"],["أَعۡدَآءُ","(the) enemies"],["ٱللَّهِ","(of) Allah"],["إِلَى","to"],["ٱلنَّارِ","the Fire"],["فَهُمۡ","then they"],["يُوزَعُونَ","will be assembled in rows"]]},{"s":26,"a":115,"en":"I am only a clear warner.\"","w":[["إِنۡ","Not"],["أَنَا۠","I am"],["إِلَّا","but"],["نَذِيرٞ","a warner"],["مُّبِينٞ","clear"]]},{"s":74,"a":42,"en":"[And asking them], \"What put you into Saqar?\"","w":[["مَا","What"],["سَلَكَكُمۡ","led you"],["فِي","into"],["سَقَرَ","Hell"]]},{"s":61,"a":2,"en":"O you who have believed, why do you say what you do not do?","w":[["يَـٰٓأَيُّهَا","O"],["ٱلَّذِينَ","(you) who"],["ءَامَنُواْ","believe"],["لِمَ","Why"],["تَقُولُونَ","(do) you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":18,"a":83,"en":"And they ask you, [O Muhammad], about Dhul-Qarnayn. Say, \"I will recite to you about him a report.\"","w":[["وَيَسۡـَٔلُونَكَ","And they ask you"],["عَن","about"],["ذِي","Dhul-qarnain"],["ٱلۡقَرۡنَيۡنِۖ","Dhul-qarnain"],["قُلۡ","Say"],["سَأَتۡلُواْ","I will recite"],["عَلَيۡكُم","to you"],["مِّنۡهُ","about him"],["ذِكۡرًا","a remembrance"]]},{"s":14,"a":43,"en":"Racing ahead, their heads raised up, their glance does not come back to them, and their hearts are void.","w":[["مُهۡطِعِينَ","Racing ahead"],["مُقۡنِعِي","raised up"],["رُءُوسِهِمۡ","their heads"],["لَا","not"],["يَرۡتَدُّ","returning"],["إِلَيۡهِمۡ","towards them"],["طَرۡفُهُمۡۖ","their gaze"],["وَأَفۡـِٔدَتُهُمۡ","and their hearts"],["هَوَآءٞ","(are) empty"]]},{"s":104,"a":7,"en":"Which mounts directed at the hearts.","w":[["ٱلَّتِي","Which"],["تَطَّلِعُ","mounts up"],["عَلَى","to"],["ٱلۡأَفۡـِٔدَةِ","the hearts"]]}]
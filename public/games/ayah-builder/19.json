[{"s":30,"a":14,"en":"And the Day the Hour appears - that Day they will become separated.","w":[["وَيَوۡمَ","And (the) Day"],["تَقُومُ","will (be) established"],["ٱلسَّاعَةُ","the Hour"],["يَوۡمَئِذٖ","that Day"],["يَتَفَرَّقُونَ","they will become separated"]]},{"s":94,"a":1,"en":"Did We not expand for you, [O Muhammad], your breast?","w":[["أَلَمۡ","Have not"],["نَشۡرَحۡ","We expanded"],["لَكَ","for you"],["صَدۡرَكَ","your breast"]]},{"s":76,"a":8,"en":"And they give food in spite of love for it to the needy, the orphan, and the captive,","w":[["وَيُطۡعِمُونَ","And they feed"],["ٱلطَّعَامَ","the food"],["عَلَىٰ","in spite of"],["حُبِّهِۦ","love (for) it"],["مِسۡكِينٗا","(to the) needy"],["وَيَتِيمٗا","and (the) orphan"],["وَأَسِيرًا","and (the) captive"]]},{"s":43,"a":73,"en":"For you therein is much fruit from which you will eat.","w":[["لَكُمۡ","For you"],["فِيهَا","therein"],["فَٰكِهَةٞ","(are) fruits"],["كَثِيرَةٞ","abundant"],["مِّنۡهَا","from it"],["تَأۡكُلُونَ","you will eat"]]},{"s":67,"a":11,"en":"And they will admit their sin, so [it is] alienation for the companions of the Blaze.","w":[["فَٱعۡتَرَفُواْ","Then they (will) confess"],["بِذَنۢبِهِمۡ","their sins"],["فَسُحۡقٗا","so away with"],["لِّأَصۡحَٰبِ","(the) companions"],["ٱلسَّعِيرِ","(of) the Blaze"]]},{"s":102,"a":8,"en":"Then you will surely be asked that Day about pleasure.","w":[["ثُمَّ","Then"],["لَتُسۡـَٔلُنَّ","surely you will be asked"],["يَوۡمَئِذٍ","that Day"],["عَنِ","about"],["ٱلنَّعِيمِ","the pleasures"]]},{"s":111,"a":5,"en":"Around her neck is a rope of [twisted] fiber.","w":[["فِي","In"],["جِيدِهَا","her neck"],["حَبۡلٞ","(will be) a rope"],["مِّن","of"],["مَّسَدِۭ","palm-fiber"]]},{"s":20,"a":118,"en":"Indeed, it is [promised] for you not to be hungry therein or be unclothed.","w":[["إِنَّ","Indeed"],["لَكَ","for you"],["أَلَّا","that not"],["تَجُوعَ","you will be hungry"],["فِيهَا","therein"],["وَلَا","and not"],["تَعۡرَىٰ","you will be unclothed"]]},{"s":97,"a":3,"en":"The Night of Decree is better than a thousand months.","w":[["لَيۡلَةُ","(The) Night"],["ٱلۡقَدۡرِ","(of) Power"],["خَيۡرٞ","(is) better"],["مِّنۡ","than"],["أَلۡفِ","a thousand"],["شَهۡرٖ","month (s)"]]},{"s":77,"a":27,"en":"And We placed therein lofty, firmly set mountains and have given you to drink sweet water.","w":[["وَجَعَلۡنَا","And We made"],["فِيهَا","therein"],["رَوَٰسِيَ","firmly set mountains"],["شَٰمِخَٰتٖ","lofty"],["وَأَسۡقَيۡنَٰكُم","and We gave you to drink"],["مَّآءٗ","water"],["فُرَاتٗا","sweet"]]},{"s":87,"a":14,"en":"He has certainly succeeded who purifies himself","w":[["قَدۡ","Certainly"],["أَفۡلَحَ","has succeeded"],["مَن","(one) who"],["تَزَكَّىٰ","purifies (himself)"]]},{"s":6,"a":55,"en":"And thus do We detail the verses, and [thus] the way of the criminals will become evident.","w":[["وَكَذَٰلِكَ","And thus"],["نُفَصِّلُ","We explain"],["ٱلۡأٓيَٰتِ","the Verses"],["وَلِتَسۡتَبِينَ","so that becomes manifest"],["سَبِيلُ","(the) way"],["ٱلۡمُجۡرِمِينَ","(of) the criminals"]]},{"s":96,"a":11,"en":"Have you seen if he is upon guidance","w":[["أَرَءَيۡتَ","Have you seen"],["إِن","if"],["كَانَ","he is"],["عَلَى","upon"],["ٱلۡهُدَىٰٓ","[the] guidance"]]},{"s":105,"a":4,"en":"Striking them with stones of hard clay,","w":[["تَرۡمِيهِم","Striking them"],["بِحِجَارَةٖ","with stones"],["مِّن","of"],["سِجِّيلٖ","baked clay"]]},{"s":84,"a":6,"en":"O mankind, indeed you are laboring toward your Lord with [great] exertion and will meet it.","w":[["يَـٰٓأَيُّهَا","O"],["ٱلۡإِنسَٰنُ","mankind"],["إِنَّكَ","Indeed,you"],["كَادِحٌ","(are) laboring"],["إِلَىٰ","to"],["رَبِّكَ","your Lord"],["كَدۡحٗا","(with) exertion"],["فَمُلَٰقِيهِ","and you (will) meet Him"]]},{"s":58,"a":21,"en":"Allah has written, \"I will surely overcome, I and My messengers.\" Indeed, Allah is Powerful and Exalted in Might.","w":[["كَتَبَ","Allah has decreed"],["ٱللَّهُ","Allah has decreed"],["لَأَغۡلِبَنَّ","Surely,I will overcome"],["أَنَا۠","I"],["وَرُسُلِيٓۚ","and My Messengers"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["قَوِيٌّ","(is) All-Strong"],["عَزِيزٞ","All-Mighty"]]},{"s":42,"a":43,"en":"And whoever is patient and forgives - indeed, that is of the matters [requiring] determination.","w":[["وَلَمَن","And whoever"],["صَبَرَ","(is) patient"],["وَغَفَرَ","and forgives"],["إِنَّ","indeed"],["ذَٰلِكَ","that"],["لَمِنۡ","(is) surely of"],["عَزۡمِ","matters of determination"],["ٱلۡأُمُورِ","matters of determination"]]},{"s":11,"a":4,"en":"To Allah is your return, and He is over all things competent.\"","w":[["إِلَى","To"],["ٱللَّهِ","Allah"],["مَرۡجِعُكُمۡۖ","(is) your return"],["وَهُوَ","and He"],["عَلَىٰ","(is) on"],["كُلِّ","every"],["شَيۡءٖ","thing"],["قَدِيرٌ","All-Powerful"]]},{"s":71,"a":13,"en":"What is [the matter] with you that you do not attribute to Allah [due] grandeur","w":[["مَّا","What"],["لَكُمۡ","(is) for you"],["لَا","not"],["تَرۡجُونَ","you attribute"],["لِلَّهِ","to Allah"],["وَقَارٗا","grandeur"]]},{"s":28,"a":33,"en":"He said, \"My Lord, indeed, I killed from among them someone, and I fear they will kill me.","w":[["قَالَ","He said"],["رَبِّ","My Lord"],["إِنِّي","Indeed"],["قَتَلۡتُ","I killed"],["مِنۡهُمۡ","of them"],["نَفۡسٗا","a man"],["فَأَخَافُ","and I fear"],["أَن","that"],["يَقۡتُلُونِ","they will kill me"]]},{"s":78,"a":12,"en":"And constructed above you seven strong [heavens]","w":[["وَبَنَيۡنَا","And We constructed"],["فَوۡقَكُمۡ","over you"],["سَبۡعٗا","seven"],["شِدَادٗا","strong"]]},{"s":48,"a":9,"en":"That you [people] may believe in Allah and His Messenger and honor him and respect the Prophet and exalt Allah morning and afternoon.","w":[["لِّتُؤۡمِنُواْ","That you may believe"],["بِٱللَّهِ","in Allah"],["وَرَسُولِهِۦ","and His Messenger"],["وَتُعَزِّرُوهُ","and (may) honor him"],["وَتُوَقِّرُوهُۚ","and respect him"],["وَتُسَبِّحُوهُ","and glorify Him"],["بُكۡرَةٗ","morning"],["وَأَصِيلًا","and evening"]]},{"s":35,"a":26,"en":"Then I seized the ones who disbelieved, and how [terrible] was My reproach.","w":[["ثُمَّ","Then"],["أَخَذۡتُ","I seized"],["ٱلَّذِينَ","those who"],["كَفَرُواْۖ","disbelieved"],["فَكَيۡفَ","and how"],["كَانَ","was"],["نَكِيرِ","My rejection"]]},{"s":13,"a":20,"en":"Those who fulfill the covenant of Allah and do not break the contract,","w":[["ٱلَّذِينَ","Those who"],["يُوفُونَ","fulfill"],["بِعَهۡدِ","the covenant"],["ٱللَّهِ","(of) Allah"],["وَلَا","and not"],["يَنقُضُونَ","they break"],["ٱلۡمِيثَٰقَ","the contract"]]},{"s":98,"a":7,"en":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["أُوْلَـٰٓئِكَ","those"],["هُمۡ","they"],["خَيۡرُ","(are the) best"],["ٱلۡبَرِيَّةِ","(of) the creatures"]]},{"s":19,"a":96,"en":"Indeed, those who have believed and done righteous deeds - the Most Merciful will appoint for them affection.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believed"],["وَعَمِلُواْ","and did"],["ٱلصَّـٰلِحَٰتِ","good deeds"],["سَيَجۡعَلُ","will bestow"],["لَهُمُ","for them"],["ٱلرَّحۡمَٰنُ","the Most Gracious"],["وُدّٗا","affection"]]},{"s":61,"a":3,"en":"Great is hatred in the sight of Allah that you say what you do not do.","w":[["كَبُرَ","Great is"],["مَقۡتًا","hatred"],["عِندَ","with"],["ٱللَّهِ","Allah"],["أَن","that"],["تَقُولُواْ","you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":38,"a":12,"en":"The people of Noah denied before them, and [the tribe of] 'Aad and Pharaoh, the owner of stakes,","w":[["كَذَّبَتۡ","Denied"],["قَبۡلَهُمۡ","before them"],["قَوۡمُ","(the) people"],["نُوحٖ","(of) Nuh"],["وَعَادٞ","and Aad"],["وَفِرۡعَوۡنُ","and Firaun"],["ذُو","(the) owner"],["ٱلۡأَوۡتَادِ","(of) the stakes"]]},{"s":23,"a":90,"en":"Rather, We have brought them the truth, and indeed they are liars.","w":[["بَلۡ","Nay"],["أَتَيۡنَٰهُم","We (have) brought them"],["بِٱلۡحَقِّ","the truth"],["وَإِنَّهُمۡ","but indeed,they"],["لَكَٰذِبُونَ","surely,(are) liars"]]},{"s":24,"a":18,"en":"And Allah makes clear to you the verses, and Allah is Knowing and Wise.","w":[["وَيُبَيِّنُ","And Allah makes clear"],["ٱللَّهُ","And Allah makes clear"],["لَكُمُ","to you"],["ٱلۡأٓيَٰتِۚ","the Verses"],["وَٱللَّهُ","And Allah"],["عَلِيمٌ","(is) All-Knower"],["حَكِيمٌ","All-Wise"]]}]
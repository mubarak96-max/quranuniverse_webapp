[{"s":22,"a":74,"en":"They have not appraised Allah with true appraisal. Indeed, Allah is Powerful and Exalted in Might.","w":[["مَا","Not"],["قَدَرُواْ","they (have) estimated"],["ٱللَّهَ","Allah"],["حَقَّ","(with) due"],["قَدۡرِهِۦٓۚ","[His] estimation"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["لَقَوِيٌّ","(is) surely All-Strong"],["عَزِيزٌ","All-Mighty"]]},{"s":109,"a":4,"en":"Nor will I be a worshipper of what you worship.","w":[["وَلَآ","And not"],["أَنَا۠","I am"],["عَابِدٞ","a worshipper"],["مَّا","(of) what"],["عَبَدتُّمۡ","you worship"]]},{"s":84,"a":13,"en":"Indeed, he had [once] been among his people in happiness;","w":[["إِنَّهُۥ","Indeed,he"],["كَانَ","had been"],["فِيٓ","among"],["أَهۡلِهِۦ","his people"],["مَسۡرُورًا","happy"]]},{"s":64,"a":13,"en":"Allah - there is no deity except Him. And upon Allah let the believers rely.","w":[["ٱللَّهُ","Allah"],["لَآ","(there is) no"],["إِلَٰهَ","god"],["إِلَّا","except"],["هُوَۚ","Him"],["وَعَلَى","And upon"],["ٱللَّهِ","Allah"],["فَلۡيَتَوَكَّلِ","let put (their) trust"],["ٱلۡمُؤۡمِنُونَ","the believers"]]},{"s":74,"a":37,"en":"To whoever wills among you to proceed or stay behind.","w":[["لِمَن","To whoever"],["شَآءَ","wills"],["مِنكُمۡ","among you"],["أَن","to"],["يَتَقَدَّمَ","proceed"],["أَوۡ","or"],["يَتَأَخَّرَ","stay behind"]]},{"s":30,"a":13,"en":"And there will not be for them among their [alleged] partners any intercessors, and they will [then] be disbelievers in their partners.","w":[["وَلَمۡ","And not"],["يَكُن","will be"],["لَّهُم","for them"],["مِّن","among"],["شُرَكَآئِهِمۡ","theirs partners"],["شُفَعَـٰٓؤُاْ","any intercessors"],["وَكَانُواْ","and they will be"],["بِشُرَكَآئِهِمۡ","in their partners"],["كَٰفِرِينَ","disbelievers"]]},{"s":89,"a":26,"en":"And none will bind [as severely] as His binding [of the evildoers].","w":[["وَلَا","And not"],["يُوثِقُ","will bind"],["وَثَاقَهُۥٓ","(as) His binding"],["أَحَدٞ","anyone"]]},{"s":55,"a":45,"en":"So which of the favors of your Lord would you deny?","w":[["فَبِأَيِّ","So which"],["ءَالَآءِ","(of the) favors"],["رَبِّكُمَا","(of) your Lord"],["تُكَذِّبَانِ","will you both deny"]]},{"s":86,"a":17,"en":"So allow time for the disbelievers. Leave them awhile.","w":[["فَمَهِّلِ","So give respite"],["ٱلۡكَٰفِرِينَ","(to) the disbelievers"],["أَمۡهِلۡهُمۡ","Give respite to them"],["رُوَيۡدَۢا","little"]]},{"s":114,"a":5,"en":"Who whispers [evil] into the breasts of mankind -","w":[["ٱلَّذِي","The one who"],["يُوَسۡوِسُ","whispers"],["فِي","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]]},{"s":32,"a":18,"en":"Then is one who was a believer like one who was defiantly disobedient? They are not equal.","w":[["أَفَمَن","Then is one who"],["كَانَ","is"],["مُؤۡمِنٗا","a believer"],["كَمَن","like (him) who"],["كَانَ","is"],["فَاسِقٗاۚ","defiantly disobedient"],["لَّا","Not"],["يَسۡتَوُۥنَ","they are equal"]]},{"s":104,"a":3,"en":"He thinks that his wealth will make him immortal.","w":[["يَحۡسَبُ","Thinking"],["أَنَّ","that"],["مَالَهُۥٓ","his wealth"],["أَخۡلَدَهُۥ","will make him immortal"]]},{"s":90,"a":14,"en":"Or feeding on a day of severe hunger","w":[["أَوۡ","Or"],["إِطۡعَٰمٞ","feeding"],["فِي","in"],["يَوۡمٖ","a day"],["ذِي","of"],["مَسۡغَبَةٖ","severe hunger"]]},{"s":4,"a":158,"en":"Rather, Allah raised him to Himself. And ever is Allah Exalted in Might and Wise.","w":[["بَل","Nay"],["رَّفَعَهُ","he was raised"],["ٱللَّهُ","(by) Allah"],["إِلَيۡهِۚ","towards Him"],["وَكَانَ","And is"],["ٱللَّهُ","Allah"],["عَزِيزًا","All-Mighty"],["حَكِيمٗا","All-Wise"]]},{"s":65,"a":9,"en":"And it tasted the bad consequence of its affair, and the outcome of its affair was loss.","w":[["فَذَاقَتۡ","So it tasted"],["وَبَالَ","(the bad) consequence"],["أَمۡرِهَا","(of) its affair"],["وَكَانَ","and was"],["عَٰقِبَةُ","(the) end"],["أَمۡرِهَا","(of) its affair"],["خُسۡرًا","loss"]]},{"s":73,"a":13,"en":"And food that chokes and a painful punishment -","w":[["وَطَعَامٗا","And food"],["ذَا","that"],["غُصَّةٖ","chokes"],["وَعَذَابًا","and a punishment"],["أَلِيمٗا","painful"]]},{"s":50,"a":10,"en":"And lofty palm trees having fruit arranged in layers -","w":[["وَٱلنَّخۡلَ","And the palms trees"],["بَاسِقَٰتٖ","tall"],["لَّهَا","for it"],["طَلۡعٞ","(are) layers"],["نَّضِيدٞ","arranged"]]},{"s":79,"a":36,"en":"And Hellfire will be exposed for [all] those who see -","w":[["وَبُرِّزَتِ","And will be made manifest"],["ٱلۡجَحِيمُ","the Hellfire"],["لِمَن","to (him) who"],["يَرَىٰ","sees"]]},{"s":56,"a":54,"en":"And drinking on top of it from scalding water","w":[["فَشَٰرِبُونَ","And drink"],["عَلَيۡهِ","over it"],["مِنَ","[from]"],["ٱلۡحَمِيمِ","the scalding water"]]},{"s":97,"a":4,"en":"The angels and the Spirit descend therein by permission of their Lord for every matter.","w":[["تَنَزَّلُ","Descend"],["ٱلۡمَلَـٰٓئِكَةُ","the Angels"],["وَٱلرُّوحُ","and the Spirit"],["فِيهَا","therein"],["بِإِذۡنِ","by (the) permission"],["رَبِّهِم","(of) their Lord"],["مِّن","for"],["كُلِّ","every"],["أَمۡرٖ","affair"]]},{"s":47,"a":31,"en":"And We will surely test you until We make evident those who strive among you [for the cause of Allah] and the patient, and We will test your affairs.","w":[["وَلَنَبۡلُوَنَّكُمۡ","And surely We will test you"],["حَتَّىٰ","until"],["نَعۡلَمَ","We make evident"],["ٱلۡمُجَٰهِدِينَ","those who strive"],["مِنكُمۡ","among you"],["وَٱلصَّـٰبِرِينَ","and the patient ones"],["وَنَبۡلُوَاْ","and We will test"],["أَخۡبَارَكُمۡ","your affairs"]]},{"s":102,"a":5,"en":"No! If you only knew with knowledge of certainty...","w":[["كَلَّا","Nay"],["لَوۡ","If"],["تَعۡلَمُونَ","you know"],["عِلۡمَ","(with) a knowledge"],["ٱلۡيَقِينِ","(of) certainty"]]},{"s":7,"a":83,"en":"So We saved him and his family, except for his wife; she was of those who remained [with the evildoers].","w":[["فَأَنجَيۡنَٰهُ","So We saved him"],["وَأَهۡلَهُۥٓ","and his family"],["إِلَّا","except"],["ٱمۡرَأَتَهُۥ","his wife"],["كَانَتۡ","she was"],["مِنَ","of"],["ٱلۡغَٰبِرِينَ","those who stayed behind"]]},{"s":67,"a":1,"en":"Blessed is He in whose hand is dominion, and He is over all things competent -","w":[["تَبَٰرَكَ","Blessed is"],["ٱلَّذِي","He"],["بِيَدِهِ","in Whose Hand"],["ٱلۡمُلۡكُ","(is) the Dominion"],["وَهُوَ","and He"],["عَلَىٰ","(is) over"],["كُلِّ","every"],["شَيۡءٖ","thing"],["قَدِيرٌ","All-Powerful"]]},{"s":49,"a":8,"en":"[It is] as bounty from Allah and favor. And Allah is Knowing and Wise.","w":[["فَضۡلٗا","A Bounty"],["مِّنَ","from Allah"],["ٱللَّهِ","from Allah"],["وَنِعۡمَةٗۚ","and favor"],["وَٱللَّهُ","And Allah"],["عَلِيمٌ","(is) All-Knower"],["حَكِيمٞ","All-Wise"]]},{"s":107,"a":3,"en":"And does not encourage the feeding of the poor.","w":[["وَلَا","And (does) not"],["يَحُضُّ","feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلۡمِسۡكِينِ","the poor"]]},{"s":91,"a":14,"en":"But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","w":[["فَكَذَّبُوهُ","But they denied him"],["فَعَقَرُوهَا","and they hamstrung her"],["فَدَمۡدَمَ","So destroyed"],["عَلَيۡهِمۡ","them"],["رَبُّهُم","their Lord"],["بِذَنۢبِهِمۡ","for their sin"],["فَسَوَّىٰهَا","and leveled them"]]},{"s":14,"a":29,"en":"[It is] Hell, which they will [enter to] burn, and wretched is the settlement.","w":[["جَهَنَّمَ","Hell"],["يَصۡلَوۡنَهَاۖ","(in) it they will burn"],["وَبِئۡسَ","and a wretched"],["ٱلۡقَرَارُ","place to settle"]]},{"s":18,"a":25,"en":"And they remained in their cave for three hundred years and exceeded by nine.","w":[["وَلَبِثُواْ","And they remained"],["فِي","in"],["كَهۡفِهِمۡ","their cave"],["ثَلَٰثَ","(for) three"],["مِاْئَةٖ","hundred"],["سِنِينَ","years"],["وَٱزۡدَادُواْ","and add"],["تِسۡعٗا","nine"]]},{"s":82,"a":5,"en":"A soul will [then] know what it has put forth and kept back.","w":[["عَلِمَتۡ","Will know"],["نَفۡسٞ","a soul"],["مَّا","what"],["قَدَّمَتۡ","it has sent forth"],["وَأَخَّرَتۡ","and left behind"]]}]
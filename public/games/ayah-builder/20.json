[{"s":41,"a":32,"en":"As accommodation from a [Lord who is] Forgiving and Merciful.\"","w":[["نُزُلٗا","A hospitable gift"],["مِّنۡ","from"],["غَفُورٖ","(the) Oft-Forgiving"],["رَّحِيمٖ","(the) Most Merciful"]]},{"s":89,"a":28,"en":"Return to your Lord, well-pleased and pleasing [to Him],","w":[["ٱرۡجِعِيٓ","Return"],["إِلَىٰ","to"],["رَبِّكِ","your Lord"],["رَاضِيَةٗ","well pleased"],["مَّرۡضِيَّةٗ","and pleasing"]]},{"s":95,"a":5,"en":"Then We return him to the lowest of the low,","w":[["ثُمَّ","Then"],["رَدَدۡنَٰهُ","We returned him"],["أَسۡفَلَ","(to the) lowest"],["سَٰفِلِينَ","(of the) low"]]},{"s":9,"a":119,"en":"O you who have believed, fear Allah and be with those who are true.","w":[["يَـٰٓأَيُّهَا","O you who believe"],["ٱلَّذِينَ","O you who believe"],["ءَامَنُواْ","O you who believe"],["ٱتَّقُواْ","Fear"],["ٱللَّهَ","Allah"],["وَكُونُواْ","and be"],["مَعَ","with"],["ٱلصَّـٰدِقِينَ","those who are truthful"]]},{"s":108,"a":3,"en":"Indeed, your enemy is the one cut off.","w":[["إِنَّ","Indeed"],["شَانِئَكَ","your enemy"],["هُوَ","he (is)"],["ٱلۡأَبۡتَرُ","the one cut off"]]},{"s":83,"a":28,"en":"A spring from which those near [to Allah] drink.","w":[["عَيۡنٗا","A spring"],["يَشۡرَبُ","will drink"],["بِهَا","from it"],["ٱلۡمُقَرَّبُونَ","those brought near"]]},{"s":8,"a":64,"en":"O Prophet, sufficient for you is Allah and for whoever follows you of the believers.","w":[["يَـٰٓأَيُّهَا","O"],["ٱلنَّبِيُّ","Prophet"],["حَسۡبُكَ","Sufficient for you"],["ٱللَّهُ","(is) Allah"],["وَمَنِ","and whoever"],["ٱتَّبَعَكَ","follows you"],["مِنَ","of"],["ٱلۡمُؤۡمِنِينَ","the believers"]]},{"s":112,"a":1,"en":"Say, \"He is Allah, [who is] One,","w":[["قُلۡ","Say"],["هُوَ","He"],["ٱللَّهُ","(is) Allah"],["أَحَدٌ","the One"]]},{"s":7,"a":8,"en":"And the weighing [of deeds] that Day will be the truth. So those whose scales are heavy - it is they who will be the successful.","w":[["وَٱلۡوَزۡنُ","And the weighing"],["يَوۡمَئِذٍ","that day"],["ٱلۡحَقُّۚ","(will be) the truth"],["فَمَن","So whose"],["ثَقُلَتۡ","(will be) heavy"],["مَوَٰزِينُهُۥ","his scales"],["فَأُوْلَـٰٓئِكَ","then those"],["هُمُ","[they]"],["ٱلۡمُفۡلِحُونَ","(will be) the successful ones"]]},{"s":4,"a":121,"en":"The refuge of those will be Hell, and they will not find from it an escape.","w":[["أُوْلَـٰٓئِكَ","Those"],["مَأۡوَىٰهُمۡ","their abode"],["جَهَنَّمُ","(is) Hell"],["وَلَا","and not"],["يَجِدُونَ","they will find"],["عَنۡهَا","from it"],["مَحِيصٗا","any escape"]]},{"s":18,"a":91,"en":"Thus. And We had encompassed [all] that he had in knowledge.","w":[["كَذَٰلِكَۖ","Thus"],["وَقَدۡ","And verily"],["أَحَطۡنَا","We encompassed"],["بِمَا","of what"],["لَدَيۡهِ","(was) with him"],["خُبۡرٗا","(of the) information"]]},{"s":114,"a":4,"en":"From the evil of the retreating whisperer -","w":[["مِن","From"],["شَرِّ","(the) evil"],["ٱلۡوَسۡوَاسِ","(of) the whisperer"],["ٱلۡخَنَّاسِ","the one who withdraws"]]},{"s":55,"a":78,"en":"Blessed is the name of your Lord, Owner of Majesty and Honor.","w":[["تَبَٰرَكَ","Blessed is"],["ٱسۡمُ","(the) name"],["رَبِّكَ","(of) your Lord"],["ذِي","Owner"],["ٱلۡجَلَٰلِ","(of) Majesty"],["وَٱلۡإِكۡرَامِ","and Honor"]]},{"s":10,"a":48,"en":"And they say, \"When is [the fulfillment of] this promise, if you should be truthful?\"","w":[["وَيَقُولُونَ","And they say"],["مَتَىٰ","When"],["هَٰذَا","(will) this"],["ٱلۡوَعۡدُ","the promise (be fulfilled)"],["إِن","if"],["كُنتُمۡ","you are"],["صَٰدِقِينَ","truthful"]]},{"s":81,"a":14,"en":"A soul will [then] know what it has brought [with it].","w":[["عَلِمَتۡ","Will know"],["نَفۡسٞ","a soul"],["مَّآ","what"],["أَحۡضَرَتۡ","it has brought"]]},{"s":72,"a":2,"en":"It guides to the right course, and we have believed in it. And we will never associate with our Lord anyone.","w":[["يَهۡدِيٓ","It guides"],["إِلَى","to"],["ٱلرُّشۡدِ","the right way"],["فَـَٔامَنَّا","so we believe"],["بِهِۦۖ","in it"],["وَلَن","and never"],["نُّشۡرِكَ","we will associate"],["بِرَبِّنَآ","with our Lord"],["أَحَدٗا","anyone"]]},{"s":103,"a":2,"en":"Indeed, mankind is in loss,","w":[["إِنَّ","Indeed"],["ٱلۡإِنسَٰنَ","mankind"],["لَفِي","(is) surely,in"],["خُسۡرٍ","loss"]]},{"s":16,"a":83,"en":"They recognize the favor of Allah; then they deny it. And most of them are disbelievers.","w":[["يَعۡرِفُونَ","They recognize"],["نِعۡمَتَ","(the) Favor"],["ٱللَّهِ","(of) Allah"],["ثُمَّ","then"],["يُنكِرُونَهَا","they deny it"],["وَأَكۡثَرُهُمُ","And most of them"],["ٱلۡكَٰفِرُونَ","(are) the disbelievers"]]},{"s":92,"a":8,"en":"But as for he who withholds and considers himself free of need","w":[["وَأَمَّا","But as for"],["مَنۢ","(him) who"],["بَخِلَ","withholds"],["وَٱسۡتَغۡنَىٰ","and considers himself free from need"]]},{"s":46,"a":14,"en":"Those are the companions of Paradise, abiding eternally therein as reward for what they used to do.","w":[["أُوْلَـٰٓئِكَ","Those"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡجَنَّةِ","(of) Paradise"],["خَٰلِدِينَ","abiding forever"],["فِيهَا","therein"],["جَزَآءَۢ","a reward"],["بِمَا","for what"],["كَانُواْ","they used to"],["يَعۡمَلُونَ","do"]]},{"s":54,"a":8,"en":"Racing ahead toward the Caller. The disbelievers will say, \"This is a difficult Day.\"","w":[["مُّهۡطِعِينَ","Racing ahead"],["إِلَى","towards"],["ٱلدَّاعِۖ","the caller"],["يَقُولُ","Will say"],["ٱلۡكَٰفِرُونَ","the disbelievers"],["هَٰذَا","This"],["يَوۡمٌ","(is) a Day"],["عَسِرٞ","difficult"]]},{"s":5,"a":98,"en":"Know that Allah is severe in penalty and that Allah is Forgiving and Merciful.","w":[["ٱعۡلَمُوٓاْ","Know"],["أَنَّ","that"],["ٱللَّهَ","Allah"],["شَدِيدُ","(is) severe"],["ٱلۡعِقَابِ","(in) punishment"],["وَأَنَّ","and that"],["ٱللَّهَ","Allah"],["غَفُورٞ","(is) Oft-Forgiving"],["رَّحِيمٞ","Most Merciful"]]},{"s":47,"a":31,"en":"And We will surely test you until We make evident those who strive among you [for the cause of Allah] and the patient, and We will test your affairs.","w":[["وَلَنَبۡلُوَنَّكُمۡ","And surely We will test you"],["حَتَّىٰ","until"],["نَعۡلَمَ","We make evident"],["ٱلۡمُجَٰهِدِينَ","those who strive"],["مِنكُمۡ","among you"],["وَٱلصَّـٰبِرِينَ","and the patient ones"],["وَنَبۡلُوَاْ","and We will test"],["أَخۡبَارَكُمۡ","your affairs"]]},{"s":32,"a":2,"en":"[This is] the revelation of the Book about which there is no doubt from the Lord of the worlds.","w":[["تَنزِيلُ","(The) revelation"],["ٱلۡكِتَٰبِ","(of) the Book"],["لَا","(there is) no"],["رَيۡبَ","doubt"],["فِيهِ","about it"],["مِن","from"],["رَّبِّ","(the) Lord"],["ٱلۡعَٰلَمِينَ","(of) the worlds"]]},{"s":93,"a":3,"en":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you].","w":[["مَا","Not"],["وَدَّعَكَ","has forsaken you"],["رَبُّكَ","your Lord"],["وَمَا","and not"],["قَلَىٰ","He is displeased"]]},{"s":64,"a":15,"en":"Your wealth and your children are but a trial, and Allah has with Him a great reward.","w":[["إِنَّمَآ","Only"],["أَمۡوَٰلُكُمۡ","your wealth"],["وَأَوۡلَٰدُكُمۡ","and your children"],["فِتۡنَةٞۚ","(are) a trial"],["وَٱللَّهُ","and Allah"],["عِندَهُۥٓ","with Him"],["أَجۡرٌ","(is) a reward"],["عَظِيمٞ","great"]]},{"s":33,"a":46,"en":"And one who invites to Allah, by His permission, and an illuminating lamp.","w":[["وَدَاعِيًا","And as one who invites"],["إِلَى","to"],["ٱللَّهِ","Allah"],["بِإِذۡنِهِۦ","by His permission"],["وَسِرَاجٗا","and (as) a lamp"],["مُّنِيرٗا","illuminating"]]},{"s":107,"a":3,"en":"And does not encourage the feeding of the poor.","w":[["وَلَا","And (does) not"],["يَحُضُّ","feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلۡمِسۡكِينِ","the poor"]]},{"s":44,"a":12,"en":"[They will say], \"Our Lord, remove from us the torment; indeed, we are believers.\"","w":[["رَّبَّنَا","Our Lord"],["ٱكۡشِفۡ","Remove"],["عَنَّا","from us"],["ٱلۡعَذَابَ","the punishment"],["إِنَّا","indeed,we"],["مُؤۡمِنُونَ","(are) believers"]]},{"s":79,"a":45,"en":"You are only a warner for those who fear it.","w":[["إِنَّمَآ","Only"],["أَنتَ","you"],["مُنذِرُ","(are) a warner"],["مَن","(for him) who"],["يَخۡشَىٰهَا","fears it"]]}]
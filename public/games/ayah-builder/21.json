[{"s":86,"a":10,"en":"Then man will have no power or any helper.","w":[["فَمَا","Then not"],["لَهُۥ","(is) for him"],["مِن","any"],["قُوَّةٖ","power"],["وَلَا","and not"],["نَاصِرٖ","any helper"]]},{"s":75,"a":3,"en":"Does man think that We will not assemble his bones?","w":[["أَيَحۡسَبُ","Does think"],["ٱلۡإِنسَٰنُ","[the] man"],["أَلَّن","that not"],["نَّجۡمَعَ","We will assemble"],["عِظَامَهُۥ","his bones"]]},{"s":37,"a":135,"en":"Except his wife among those who remained [with the evildoers].","w":[["إِلَّا","Except"],["عَجُوزٗا","an old woman"],["فِي","(was) among"],["ٱلۡغَٰبِرِينَ","those who remained behind"]]},{"s":36,"a":63,"en":"This is the Hellfire which you were promised.","w":[["هَٰذِهِۦ","This (is)"],["جَهَنَّمُ","(the) Hell"],["ٱلَّتِي","which"],["كُنتُمۡ","you were"],["تُوعَدُونَ","promised"]]},{"s":3,"a":2,"en":"Allah - there is no deity except Him, the Ever-Living, the Sustainer of existence.","w":[["ٱللَّهُ","Allah"],["لَآ","(there is) no"],["إِلَٰهَ","God"],["إِلَّا","except"],["هُوَ","Him"],["ٱلۡحَيُّ","the Ever-Living"],["ٱلۡقَيُّومُ","the Sustainer of all that exists"]]},{"s":91,"a":14,"en":"But they denied him and hamstrung her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].","w":[["فَكَذَّبُوهُ","But they denied him"],["فَعَقَرُوهَا","and they hamstrung her"],["فَدَمۡدَمَ","So destroyed"],["عَلَيۡهِمۡ","them"],["رَبُّهُم","their Lord"],["بِذَنۢبِهِمۡ","for their sin"],["فَسَوَّىٰهَا","and leveled them"]]},{"s":31,"a":9,"en":"Wherein they abide eternally; [it is] the promise of Allah [which is] truth. And He is the Exalted in Might, the Wise.","w":[["خَٰلِدِينَ","(To) abide forever"],["فِيهَاۖ","in it"],["وَعۡدَ","(The) Promise of Allah"],["ٱللَّهِ","(The) Promise of Allah"],["حَقّٗاۚ","(is) true"],["وَهُوَ","And He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":110,"a":2,"en":"And you see the people entering into the religion of Allah in multitudes,","w":[["وَرَأَيۡتَ","And you see"],["ٱلنَّاسَ","the people"],["يَدۡخُلُونَ","entering"],["فِي","into"],["دِينِ","(the) religion"],["ٱللَّهِ","(of) Allah"],["أَفۡوَاجٗا","(in) multitudes"]]},{"s":104,"a":1,"en":"Woe to every scorner and mocker","w":[["وَيۡلٞ","Woe"],["لِّكُلِّ","to every"],["هُمَزَةٖ","slanderer"],["لُّمَزَةٍ","backbiter"]]},{"s":113,"a":2,"en":"From the evil of that which He created","w":[["مِن","From"],["شَرِّ","(the) evil"],["مَا","(of) what"],["خَلَقَ","He created"]]},{"s":25,"a":24,"en":"The companions of Paradise, that Day, are [in] a better settlement and better resting place.","w":[["أَصۡحَٰبُ","(The) companions"],["ٱلۡجَنَّةِ","(of) Paradise"],["يَوۡمَئِذٍ","that Day"],["خَيۡرٞ","(will be in) a better"],["مُّسۡتَقَرّٗا","abode"],["وَأَحۡسَنُ","and a better"],["مَقِيلٗا","resting-place"]]},{"s":52,"a":18,"en":"Enjoying what their Lord has given them, and their Lord protected them from the punishment of Hellfire.","w":[["فَٰكِهِينَ","Enjoying"],["بِمَآ","in what"],["ءَاتَىٰهُمۡ","has given them"],["رَبُّهُمۡ","their Lord"],["وَوَقَىٰهُمۡ","and protected them"],["رَبُّهُمۡ","their Lord"],["عَذَابَ","(from the) punishment"],["ٱلۡجَحِيمِ","(of) Hellfire"]]},{"s":56,"a":64,"en":"Is it you who makes it grow, or are We the grower?","w":[["ءَأَنتُمۡ","Is it you (who)"],["تَزۡرَعُونَهُۥٓ","cause it to grow"],["أَمۡ","or"],["نَحۡنُ","(are) We"],["ٱلزَّـٰرِعُونَ","the Ones Who grow"]]},{"s":51,"a":30,"en":"They said, \"Thus has said your Lord; indeed, He is the Wise, the Knowing.\"","w":[["قَالُواْ","They said"],["كَذَٰلِكِ","Thus"],["قَالَ","said"],["رَبُّكِۖ","your Lord"],["إِنَّهُۥ","Indeed,He"],["هُوَ","[He]"],["ٱلۡحَكِيمُ","(is) the All-Wise"],["ٱلۡعَلِيمُ","the All-Knower"]]},{"s":12,"a":58,"en":"And the brothers of Joseph came [seeking food], and they entered upon him; and he recognized them, but he was to them unknown.","w":[["وَجَآءَ","And came"],["إِخۡوَةُ","(the) brothers"],["يُوسُفَ","(of) Yusuf"],["فَدَخَلُواْ","and they entered"],["عَلَيۡهِ","upon him"],["فَعَرَفَهُمۡ","and he recognized them"],["وَهُمۡ","but they"],["لَهُۥ","knew him not"],["مُنكِرُونَ","knew him not"]]},{"s":21,"a":65,"en":"Then they reversed themselves, [saying], \"You have already known that these do not speak!\"","w":[["ثُمَّ","Then"],["نُكِسُواْ","they were turned"],["عَلَىٰ","on"],["رُءُوسِهِمۡ","their heads"],["لَقَدۡ","Verily"],["عَلِمۡتَ","you know"],["مَا","not"],["هَـٰٓؤُلَآءِ","these"],["يَنطِقُونَ","(can) speak"]]},{"s":57,"a":1,"en":"Whatever is in the heavens and earth exalts Allah, and He is the Exalted in Might, the Wise.","w":[["سَبَّحَ","Glorifies"],["لِلَّهِ","[to] Allah"],["مَا","whatever"],["فِي","(is) in"],["ٱلسَّمَٰوَٰتِ","the heavens"],["وَٱلۡأَرۡضِۖ","and the earth"],["وَهُوَ","and He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":15,"a":52,"en":"When they entered upon him and said, \"Peace.\" [Abraham] said, \"Indeed, we are fearful of you.\"","w":[["إِذۡ","When"],["دَخَلُواْ","they entered"],["عَلَيۡهِ","upon him"],["فَقَالُواْ","and said"],["سَلَٰمٗا","Peace"],["قَالَ","He said"],["إِنَّا","Indeed,we"],["مِنكُمۡ","(are) of you"],["وَجِلُونَ","afraid"]]},{"s":106,"a":3,"en":"Let them worship the Lord of this House,","w":[["فَلۡيَعۡبُدُواْ","So let them worship"],["رَبَّ","(the) Lord"],["هَٰذَا","(of) this"],["ٱلۡبَيۡتِ","House"]]},{"s":17,"a":106,"en":"And [it is] a Qur'an which We have separated [by intervals] that you might recite it to the people over a prolonged period. And We have sent it down progressively.","w":[["وَقُرۡءَانٗا","And the Quran"],["فَرَقۡنَٰهُ","We have divided"],["لِتَقۡرَأَهُۥ","that you might recite it"],["عَلَى","to"],["ٱلنَّاسِ","the people"],["عَلَىٰ","at"],["مُكۡثٖ","intervals"],["وَنَزَّلۡنَٰهُ","And We have revealed it"],["تَنزِيلٗا","(in) stages"]]},{"s":26,"a":59,"en":"Thus. And We caused to inherit it the Children of Israel.","w":[["كَذَٰلِكَۖ","Thus"],["وَأَوۡرَثۡنَٰهَا","And We caused to inherit them"],["بَنِيٓ","(the) Children of Israel"],["إِسۡرَـٰٓءِيلَ","(the) Children of Israel"]]},{"s":2,"a":179,"en":"And there is for you in legal retribution [saving of] life, O you [people] of understanding, that you may become righteous.","w":[["وَلَكُمۡ","And for you"],["فِي","in"],["ٱلۡقِصَاصِ","the legal retribution"],["حَيَوٰةٞ","(is) life"],["يَـٰٓأُوْلِي","O men"],["ٱلۡأَلۡبَٰبِ","(of) understanding"],["لَعَلَّكُمۡ","So that you may"],["تَتَّقُونَ","(become) righteous"]]},{"s":49,"a":8,"en":"[It is] as bounty from Allah and favor. And Allah is Knowing and Wise.","w":[["فَضۡلٗا","A Bounty"],["مِّنَ","from Allah"],["ٱللَّهِ","from Allah"],["وَنِعۡمَةٗۚ","and favor"],["وَٱللَّهُ","And Allah"],["عَلِيمٌ","(is) All-Knower"],["حَكِيمٞ","All-Wise"]]},{"s":53,"a":11,"en":"The heart did not lie [about] what it saw.","w":[["مَا","Not"],["كَذَبَ","lied"],["ٱلۡفُؤَادُ","the heart"],["مَا","what"],["رَأَىٰٓ","it saw"]]},{"s":73,"a":12,"en":"Indeed, with Us [for them] are shackles and burning fire","w":[["إِنَّ","Indeed"],["لَدَيۡنَآ","with Us"],["أَنكَالٗا","(are) shackles"],["وَجَحِيمٗا","and burning fire"]]},{"s":74,"a":8,"en":"And when the trumpet is blown,","w":[["فَإِذَا","Then when"],["نُقِرَ","is blown"],["فِي","in"],["ٱلنَّاقُورِ","the trumpet"]]},{"s":80,"a":40,"en":"And [other] faces, that Day, will have upon them dust.","w":[["وَوُجُوهٞ","And faces"],["يَوۡمَئِذٍ","that Day"],["عَلَيۡهَا","upon them"],["غَبَرَةٞ","(will be) dust"]]},{"s":68,"a":24,"en":"[Saying], \"There will surely not enter it today upon you [any] poor person.\"","w":[["أَن","That"],["لَّا","Not"],["يَدۡخُلَنَّهَا","will enter it"],["ٱلۡيَوۡمَ","today"],["عَلَيۡكُم","upon you"],["مِّسۡكِينٞ","any poor person"]]},{"s":27,"a":1,"en":"Ta, Seen. These are the verses of the Qur'an and a clear Book","w":[["طسٓۚ","Ta Seen"],["تِلۡكَ","These"],["ءَايَٰتُ","(are the) Verses"],["ٱلۡقُرۡءَانِ","(of) the Quran"],["وَكِتَابٖ","and a Book"],["مُّبِينٍ","clear"]]},{"s":39,"a":30,"en":"Indeed, you are to die, and indeed, they are to die.","w":[["إِنَّكَ","Indeed,you"],["مَيِّتٞ","will die"],["وَإِنَّهُم","and indeed,they"],["مَّيِّتُونَ","(will also) die"]]}]
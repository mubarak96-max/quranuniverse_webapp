[{"s":25,"a":75,"en":"Those will be awarded the Chamber for what they patiently endured, and they will be received therein with greetings and [words of] peace.","w":[["أُوْلَـٰٓئِكَ","Those"],["يُجۡزَوۡنَ","will be awarded"],["ٱلۡغُرۡفَةَ","the Chamber"],["بِمَا","because"],["صَبَرُواْ","they were patient"],["وَيُلَقَّوۡنَ","and they will be met"],["فِيهَا","therein"],["تَحِيَّةٗ","(with) greetings"],["وَسَلَٰمًا","and peace"]]},{"s":84,"a":23,"en":"And Allah is most knowing of what they keep within themselves.","w":[["وَٱللَّهُ","And Allah"],["أَعۡلَمُ","(is) most knowing"],["بِمَا","of what"],["يُوعُونَ","they keep within themselves"]]},{"s":20,"a":17,"en":"And what is that in your right hand, O Moses?\"","w":[["وَمَا","And what"],["تِلۡكَ","(is) that"],["بِيَمِينِكَ","in your right hand"],["يَٰمُوسَىٰ","O Musa"]]},{"s":45,"a":20,"en":"This [Qur'an] is enlightenment for mankind and guidance and mercy for a people who are certain [in faith].","w":[["هَٰذَا","This"],["بَصَـٰٓئِرُ","(is) enlightenment"],["لِلنَّاسِ","for mankind"],["وَهُدٗى","and guidance"],["وَرَحۡمَةٞ","and mercy"],["لِّقَوۡمٖ","for a people"],["يُوقِنُونَ","who are certain"]]},{"s":75,"a":16,"en":"Move not your tongue with it, [O Muhammad], to hasten with recitation of the Qur'an.","w":[["لَا","Not"],["تُحَرِّكۡ","move"],["بِهِۦ","with it"],["لِسَانَكَ","your tongue"],["لِتَعۡجَلَ","to hasten"],["بِهِۦٓ","with it"]]},{"s":65,"a":9,"en":"And it tasted the bad consequence of its affair, and the outcome of its affair was loss.","w":[["فَذَاقَتۡ","So it tasted"],["وَبَالَ","(the bad) consequence"],["أَمۡرِهَا","(of) its affair"],["وَكَانَ","and was"],["عَٰقِبَةُ","(the) end"],["أَمۡرِهَا","(of) its affair"],["خُسۡرًا","loss"]]},{"s":51,"a":43,"en":"And in Thamud, when it was said to them, \"Enjoy yourselves for a time.\"","w":[["وَفِي","And in"],["ثَمُودَ","Thamud"],["إِذۡ","when"],["قِيلَ","was said"],["لَهُمۡ","to them"],["تَمَتَّعُواْ","Enjoy (yourselves)"],["حَتَّىٰ","for"],["حِينٖ","a time"]]},{"s":79,"a":27,"en":"Are you a more difficult creation or is the heaven? Allah constructed it.","w":[["ءَأَنتُمۡ","Are you"],["أَشَدُّ","a more difficult"],["خَلۡقًا","creation"],["أَمِ","or"],["ٱلسَّمَآءُۚ","the heaven"],["بَنَىٰهَا","He constructed it"]]},{"s":13,"a":24,"en":"\"Peace be upon you for what you patiently endured. And excellent is the final home.\"","w":[["سَلَٰمٌ","(Saying),\" Peace"],["عَلَيۡكُم","(be) upon you"],["بِمَا","for what"],["صَبَرۡتُمۡۚ","you patiently endured"],["فَنِعۡمَ","And excellent"],["عُقۡبَى","(is) the final attainment"],["ٱلدَّارِ","(of) the Home"]]},{"s":80,"a":19,"en":"From a sperm-drop He created him and destined for him;","w":[["مِن","From"],["نُّطۡفَةٍ","a semen-drop"],["خَلَقَهُۥ","He created him"],["فَقَدَّرَهُۥ","then He proportioned him"]]},{"s":107,"a":3,"en":"And does not encourage the feeding of the poor.","w":[["وَلَا","And (does) not"],["يَحُضُّ","feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلۡمِسۡكِينِ","the poor"]]},{"s":49,"a":8,"en":"[It is] as bounty from Allah and favor. And Allah is Knowing and Wise.","w":[["فَضۡلٗا","A Bounty"],["مِّنَ","from Allah"],["ٱللَّهِ","from Allah"],["وَنِعۡمَةٗۚ","and favor"],["وَٱللَّهُ","And Allah"],["عَلِيمٌ","(is) All-Knower"],["حَكِيمٞ","All-Wise"]]},{"s":67,"a":11,"en":"And they will admit their sin, so [it is] alienation for the companions of the Blaze.","w":[["فَٱعۡتَرَفُواْ","Then they (will) confess"],["بِذَنۢبِهِمۡ","their sins"],["فَسُحۡقٗا","so away with"],["لِّأَصۡحَٰبِ","(the) companions"],["ٱلسَّعِيرِ","(of) the Blaze"]]},{"s":71,"a":15,"en":"Do you not consider how Allah has created seven heavens in layers","w":[["أَلَمۡ","Do not"],["تَرَوۡاْ","you see"],["كَيۡفَ","how"],["خَلَقَ","did create"],["ٱللَّهُ","Allah"],["سَبۡعَ","(the) seven"],["سَمَٰوَٰتٖ","heavens"],["طِبَاقٗا","(in) layers"]]},{"s":23,"a":113,"en":"They will say, \"We remained a day or part of a day; ask those who enumerate.\"","w":[["قَالُواْ","They will say"],["لَبِثۡنَا","We remained"],["يَوۡمًا","a day"],["أَوۡ","or"],["بَعۡضَ","a part"],["يَوۡمٖ","(of) a day"],["فَسۡـَٔلِ","but ask"],["ٱلۡعَآدِّينَ","those who keep count"]]},{"s":101,"a":5,"en":"And the mountains will be like wool, fluffed up.","w":[["وَتَكُونُ","And will be"],["ٱلۡجِبَالُ","the mountains"],["كَٱلۡعِهۡنِ","like wool"],["ٱلۡمَنفُوشِ","fluffed up"]]},{"s":47,"a":7,"en":"O you who have believed, if you support Allah, He will support you and plant firmly your feet.","w":[["يَـٰٓأَيُّهَا","O you who believe"],["ٱلَّذِينَ","O you who believe"],["ءَامَنُوٓاْ","O you who believe"],["إِن","If"],["تَنصُرُواْ","you help"],["ٱللَّهَ","Allah"],["يَنصُرۡكُمۡ","He will help you"],["وَيُثَبِّتۡ","and make firm"],["أَقۡدَامَكُمۡ","your feet"]]},{"s":88,"a":21,"en":"So remind, [O Muhammad]; you are only a reminder.","w":[["فَذَكِّرۡ","So remind"],["إِنَّمَآ","only"],["أَنتَ","you"],["مُذَكِّرٞ","(are) a reminder"]]},{"s":72,"a":15,"en":"But as for the unjust, they will be, for Hell, firewood.'","w":[["وَأَمَّا","And as for"],["ٱلۡقَٰسِطُونَ","the unjust"],["فَكَانُواْ","they will be"],["لِجَهَنَّمَ","for Hell"],["حَطَبٗا","firewood"]]},{"s":48,"a":3,"en":"And [that] Allah may aid you with a mighty victory.","w":[["وَيَنصُرَكَ","And Allah may help you"],["ٱللَّهُ","And Allah may help you"],["نَصۡرًا","(with) a help"],["عَزِيزًا","mighty"]]},{"s":27,"a":70,"en":"And grieve not over them or be in distress from what they conspire.","w":[["وَلَا","And (do) not"],["تَحۡزَنۡ","grieve"],["عَلَيۡهِمۡ","over them"],["وَلَا","and not"],["تَكُن","be"],["فِي","in"],["ضَيۡقٖ","distress"],["مِّمَّا","from what"],["يَمۡكُرُونَ","they plot"]]},{"s":62,"a":7,"en":"But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers.","w":[["وَلَا","But not"],["يَتَمَنَّوۡنَهُۥٓ","they will wish for it"],["أَبَدَۢا","ever"],["بِمَا","for what"],["قَدَّمَتۡ","(have) sent forth"],["أَيۡدِيهِمۡۚ","their hands"],["وَٱللَّهُ","And Allah"],["عَلِيمُۢ","(is) All-Knowing"],["بِٱلظَّـٰلِمِينَ","of the wrongdoers"]]},{"s":56,"a":62,"en":"And you have already known the first creation, so will you not remember?","w":[["وَلَقَدۡ","And certainly"],["عَلِمۡتُمُ","you know"],["ٱلنَّشۡأَةَ","the creation"],["ٱلۡأُولَىٰ","the first"],["فَلَوۡلَا","so why not"],["تَذَكَّرُونَ","you take heed"]]},{"s":77,"a":30,"en":"Proceed to a shadow [of smoke] having three columns","w":[["ٱنطَلِقُوٓاْ","Proceed"],["إِلَىٰ","to"],["ظِلّٖ","a shadow"],["ذِي","having"],["ثَلَٰثِ","three"],["شُعَبٖ","columns"]]},{"s":110,"a":2,"en":"And you see the people entering into the religion of Allah in multitudes,","w":[["وَرَأَيۡتَ","And you see"],["ٱلنَّاسَ","the people"],["يَدۡخُلُونَ","entering"],["فِي","into"],["دِينِ","(the) religion"],["ٱللَّهِ","(of) Allah"],["أَفۡوَاجٗا","(in) multitudes"]]},{"s":83,"a":6,"en":"The Day when mankind will stand before the Lord of the worlds?","w":[["يَوۡمَ","(The) Day"],["يَقُومُ","will stand"],["ٱلنَّاسُ","mankind"],["لِرَبِّ","before (the) Lord"],["ٱلۡعَٰلَمِينَ","(of) the worlds"]]},{"s":90,"a":7,"en":"Does he think that no one has seen him?","w":[["أَيَحۡسَبُ","Does he think"],["أَن","that"],["لَّمۡ","not"],["يَرَهُۥٓ","sees him"],["أَحَدٌ","anyone"]]},{"s":103,"a":3,"en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","w":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلۡحَقِّ","to the truth"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلصَّبۡرِ","to [the] patience"]]},{"s":113,"a":4,"en":"And from the evil of the blowers in knots","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["ٱلنَّفَّـٰثَٰتِ","(of) the blowers"],["فِي","in"],["ٱلۡعُقَدِ","the knots"]]},{"s":102,"a":7,"en":"Then you will surely see it with the eye of certainty.","w":[["ثُمَّ","Then"],["لَتَرَوُنَّهَا","surely you will see it"],["عَيۡنَ","(with the) eye"],["ٱلۡيَقِينِ","(of) certainty"]]}]
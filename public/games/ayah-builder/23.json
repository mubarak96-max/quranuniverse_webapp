[{"s":14,"a":20,"en":"And that is not difficult for Allah.","w":[["وَمَا","And not"],["ذَٰلِكَ","(is) that"],["عَلَى","on"],["ٱللَّهِ","Allah"],["بِعَزِيزٖ","great"]]},{"s":94,"a":6,"en":"Indeed, with hardship [will be] ease.","w":[["إِنَّ","Indeed"],["مَعَ","with"],["ٱلۡعُسۡرِ","the hardship"],["يُسۡرٗا","(is) ease"]]},{"s":104,"a":3,"en":"He thinks that his wealth will make him immortal.","w":[["يَحۡسَبُ","Thinking"],["أَنَّ","that"],["مَالَهُۥٓ","his wealth"],["أَخۡلَدَهُۥ","will make him immortal"]]},{"s":82,"a":18,"en":"Then, what can make you know what is the Day of Recompense?","w":[["ثُمَّ","Then"],["مَآ","what"],["أَدۡرَىٰكَ","can make you know"],["مَا","what"],["يَوۡمُ","(is the) Day"],["ٱلدِّينِ","(of) the Judgment"]]},{"s":87,"a":14,"en":"He has certainly succeeded who purifies himself","w":[["قَدۡ","Certainly"],["أَفۡلَحَ","has succeeded"],["مَن","(one) who"],["تَزَكَّىٰ","purifies (himself)"]]},{"s":42,"a":34,"en":"Or He could destroy them for what they earned; but He pardons much.","w":[["أَوۡ","Or"],["يُوبِقۡهُنَّ","He could destroy them"],["بِمَا","for what"],["كَسَبُواْ","they have earned"],["وَيَعۡفُ","but He pardons"],["عَن","[from]"],["كَثِيرٖ","much"]]},{"s":22,"a":57,"en":"And they who disbelieved and denied Our signs - for those there will be a humiliating punishment.","w":[["وَٱلَّذِينَ","And those who"],["كَفَرُواْ","disbelieved"],["وَكَذَّبُواْ","and denied"],["بِـَٔايَٰتِنَا","Our Verses"],["فَأُوْلَـٰٓئِكَ","then those"],["لَهُمۡ","for them"],["عَذَابٞ","(will be) a punishment"],["مُّهِينٞ","humiliating"]]},{"s":61,"a":2,"en":"O you who have believed, why do you say what you do not do?","w":[["يَـٰٓأَيُّهَا","O"],["ٱلَّذِينَ","(you) who"],["ءَامَنُواْ","believe"],["لِمَ","Why"],["تَقُولُونَ","(do) you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":105,"a":4,"en":"Striking them with stones of hard clay,","w":[["تَرۡمِيهِم","Striking them"],["بِحِجَارَةٖ","with stones"],["مِّن","of"],["سِجِّيلٖ","baked clay"]]},{"s":31,"a":24,"en":"We grant them enjoyment for a little; then We will force them to a massive punishment.","w":[["نُمَتِّعُهُمۡ","We grant them enjoyment"],["قَلِيلٗا","(for) a little"],["ثُمَّ","then"],["نَضۡطَرُّهُمۡ","We will force them"],["إِلَىٰ","to"],["عَذَابٍ","a punishment"],["غَلِيظٖ","severe"]]},{"s":89,"a":25,"en":"So on that Day, none will punish [as severely] as His punishment,","w":[["فَيَوۡمَئِذٖ","So that Day"],["لَّا","not"],["يُعَذِّبُ","will punish"],["عَذَابَهُۥٓ","(as) His punishment"],["أَحَدٞ","anyone"]]},{"s":46,"a":6,"en":"And when the people are gathered [that Day], they [who were invoked] will be enemies to them, and they will be deniers of their worship.","w":[["وَإِذَا","And when"],["حُشِرَ","are gathered"],["ٱلنَّاسُ","the people"],["كَانُواْ","they will be"],["لَهُمۡ","for them"],["أَعۡدَآءٗ","enemies"],["وَكَانُواْ","and they will be"],["بِعِبَادَتِهِمۡ","of their worship"],["كَٰفِرِينَ","deniers"]]},{"s":29,"a":11,"en":"And Allah will surely make evident those who believe, and He will surely make evident the hypocrites.","w":[["وَلَيَعۡلَمَنَّ","And Allah will surely make evident"],["ٱللَّهُ","And Allah will surely make evident"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَلَيَعۡلَمَنَّ","And He will surely make evident"],["ٱلۡمُنَٰفِقِينَ","the hypocrites"]]},{"s":3,"a":17,"en":"The patient, the true, the obedient, those who spend [in the way of Allah], and those who seek forgiveness before dawn.","w":[["ٱلصَّـٰبِرِينَ","The patient"],["وَٱلصَّـٰدِقِينَ","and the truthful"],["وَٱلۡقَٰنِتِينَ","and the obedient"],["وَٱلۡمُنفِقِينَ","and those who spend"],["وَٱلۡمُسۡتَغۡفِرِينَ","and those who seek forgiveness"],["بِٱلۡأَسۡحَارِ","[in the] before dawn"]]},{"s":21,"a":111,"en":"And I know not; perhaps it is a trial for you and enjoyment for a time.\"","w":[["وَإِنۡ","And not"],["أَدۡرِي","I know"],["لَعَلَّهُۥ","perhaps it may be"],["فِتۡنَةٞ","a trial"],["لَّكُمۡ","for you"],["وَمَتَٰعٌ","and an enjoyment"],["إِلَىٰ","for"],["حِينٖ","a time"]]},{"s":109,"a":4,"en":"Nor will I be a worshipper of what you worship.","w":[["وَلَآ","And not"],["أَنَا۠","I am"],["عَابِدٞ","a worshipper"],["مَّا","(of) what"],["عَبَدتُّمۡ","you worship"]]},{"s":93,"a":4,"en":"And the Hereafter is better for you than the first [life].","w":[["وَلَلۡأٓخِرَةُ","And surely the Hereafter"],["خَيۡرٞ","(is) better"],["لَّكَ","for you"],["مِنَ","than"],["ٱلۡأُولَىٰ","the first"]]},{"s":2,"a":53,"en":"And [recall] when We gave Moses the Scripture and criterion that perhaps you would be guided.","w":[["وَإِذۡ","And when"],["ءَاتَيۡنَا","We gave"],["مُوسَى","Musa"],["ٱلۡكِتَٰبَ","the Book"],["وَٱلۡفُرۡقَانَ","and the Criterion"],["لَعَلَّكُمۡ","perhaps you"],["تَهۡتَدُونَ","(would be) guided"]]},{"s":64,"a":13,"en":"Allah - there is no deity except Him. And upon Allah let the believers rely.","w":[["ٱللَّهُ","Allah"],["لَآ","(there is) no"],["إِلَٰهَ","god"],["إِلَّا","except"],["هُوَۚ","Him"],["وَعَلَى","And upon"],["ٱللَّهِ","Allah"],["فَلۡيَتَوَكَّلِ","let put (their) trust"],["ٱلۡمُؤۡمِنُونَ","the believers"]]},{"s":41,"a":7,"en":"Those who do not give zakah, and in the Hereafter they are disbelievers.","w":[["ٱلَّذِينَ","Those who"],["لَا","(do) not"],["يُؤۡتُونَ","give"],["ٱلزَّكَوٰةَ","the zakah"],["وَهُم","and they"],["بِٱلۡأٓخِرَةِ","in the Hereafter"],["هُمۡ","they"],["كَٰفِرُونَ","(are) disbelievers"]]},{"s":17,"a":11,"en":"And man supplicates for evil as he supplicates for good, and man is ever hasty.","w":[["وَيَدۡعُ","And prays"],["ٱلۡإِنسَٰنُ","the man"],["بِٱلشَّرِّ","for evil"],["دُعَآءَهُۥ","(as) he prays"],["بِٱلۡخَيۡرِۖ","for the good"],["وَكَانَ","And is"],["ٱلۡإِنسَٰنُ","the man"],["عَجُولٗا","ever hasty"]]},{"s":98,"a":7,"en":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["أُوْلَـٰٓئِكَ","those"],["هُمۡ","they"],["خَيۡرُ","(are the) best"],["ٱلۡبَرِيَّةِ","(of) the creatures"]]},{"s":34,"a":38,"en":"And the ones who strive against Our verses to cause [them] failure - those will be brought into the punishment [to remain].","w":[["وَٱلَّذِينَ","And those who"],["يَسۡعَوۡنَ","strive"],["فِيٓ","against"],["ءَايَٰتِنَا","Our Verses"],["مُعَٰجِزِينَ","(to) cause failure"],["أُوْلَـٰٓئِكَ","those"],["فِي","into"],["ٱلۡعَذَابِ","the punishment"],["مُحۡضَرُونَ","(will be) brought"]]},{"s":37,"a":33,"en":"So indeed they, that Day, will be sharing in the punishment.","w":[["فَإِنَّهُمۡ","Then indeed,they"],["يَوۡمَئِذٖ","that Day"],["فِي","in"],["ٱلۡعَذَابِ","the punishment"],["مُشۡتَرِكُونَ","(will be) sharers"]]},{"s":100,"a":8,"en":"And indeed he is, in love of wealth, intense.","w":[["وَإِنَّهُۥ","And indeed he"],["لِحُبِّ","in (the) love"],["ٱلۡخَيۡرِ","(of) wealth"],["لَشَدِيدٌ","(is) surely intense"]]},{"s":30,"a":17,"en":"So exalted is Allah when you reach the evening and when you reach the morning.","w":[["فَسُبۡحَٰنَ","So glory be to"],["ٱللَّهِ","Allah"],["حِينَ","when"],["تُمۡسُونَ","you reach the evening"],["وَحِينَ","and when"],["تُصۡبِحُونَ","you reach the morning"]]},{"s":97,"a":2,"en":"And what can make you know what is the Night of Decree?","w":[["وَمَآ","And what"],["أَدۡرَىٰكَ","can make you know"],["مَا","what"],["لَيۡلَةُ","(the) Night"],["ٱلۡقَدۡرِ","(of) Power (is)"]]},{"s":73,"a":14,"en":"On the Day the earth and the mountains will convulse and the mountains will become a heap of sand pouring down.","w":[["يَوۡمَ","(On the) Day"],["تَرۡجُفُ","will quake"],["ٱلۡأَرۡضُ","the earth"],["وَٱلۡجِبَالُ","and the mountains"],["وَكَانَتِ","and will become"],["ٱلۡجِبَالُ","the mountains"],["كَثِيبٗا","a heap of sand"],["مَّهِيلًا","pouring down"]]},{"s":32,"a":6,"en":"That is the Knower of the unseen and the witnessed, the Exalted in Might, the Merciful,","w":[["ذَٰلِكَ","That"],["عَٰلِمُ","(is the) Knower"],["ٱلۡغَيۡبِ","(of) the hidden"],["وَٱلشَّهَٰدَةِ","and the witnessed"],["ٱلۡعَزِيزُ","the All-Mighty"],["ٱلرَّحِيمُ","the Most Merciful"]]},{"s":70,"a":38,"en":"Does every person among them aspire to enter a garden of pleasure?","w":[["أَيَطۡمَعُ","Does long"],["كُلُّ","every"],["ٱمۡرِيٕٖ","person"],["مِّنۡهُمۡ","among them"],["أَن","that"],["يُدۡخَلَ","he enters"],["جَنَّةَ","a Garden"],["نَعِيمٖ","(of) Delight"]]}]
[{"s":8,"a":51,"en":"That is for what your hands have put forth [of evil] and because Allah is not ever unjust to His servants.\"","w":[["ذَٰلِكَ","That"],["بِمَا","(is) for what"],["قَدَّمَتۡ","sent forth"],["أَيۡدِيكُمۡ","your hands"],["وَأَنَّ","And indeed"],["ٱللَّهَ","Allah"],["لَيۡسَ","(is) not"],["بِظَلَّـٰمٖ","unjust"],["لِّلۡعَبِيدِ","to His slaves"]]},{"s":6,"a":67,"en":"For every happening is a finality; and you are going to know.","w":[["لِّكُلِّ","For every"],["نَبَإٖ","news"],["مُّسۡتَقَرّٞۚ","(is) a fixed time"],["وَسَوۡفَ","and soon"],["تَعۡلَمُونَ","you will know"]]},{"s":55,"a":23,"en":"So which of the favors of your Lord would you deny?","w":[["فَبِأَيِّ","So which"],["ءَالَآءِ","(of the) favors"],["رَبِّكُمَا","(of) your Lord"],["تُكَذِّبَانِ","will you both deny"]]},{"s":92,"a":20,"en":"But only seeking the countenance of his Lord, Most High.","w":[["إِلَّا","Except"],["ٱبۡتِغَآءَ","seeking"],["وَجۡهِ","(the) Countenance"],["رَبِّهِ","(of) his Lord"],["ٱلۡأَعۡلَىٰ","the Most High"]]},{"s":86,"a":2,"en":"And what can make you know what is the night comer?","w":[["وَمَآ","And what"],["أَدۡرَىٰكَ","can make you know"],["مَا","what"],["ٱلطَّارِقُ","the night comer (is)"]]},{"s":69,"a":44,"en":"And if Muhammad had made up about Us some [false] sayings,","w":[["وَلَوۡ","And if"],["تَقَوَّلَ","he (had) fabricated"],["عَلَيۡنَا","against Us"],["بَعۡضَ","some"],["ٱلۡأَقَاوِيلِ","sayings"]]},{"s":38,"a":18,"en":"Indeed, We subjected the mountains [to praise] with him, exalting [Allah] in the [late] afternoon and [after] sunrise.","w":[["إِنَّا","Indeed,We"],["سَخَّرۡنَا","subjected"],["ٱلۡجِبَالَ","the mountains"],["مَعَهُۥ","with him"],["يُسَبِّحۡنَ","glorifying"],["بِٱلۡعَشِيِّ","in the evening"],["وَٱلۡإِشۡرَاقِ","and [the] sunrise"]]},{"s":106,"a":3,"en":"Let them worship the Lord of this House,","w":[["فَلۡيَعۡبُدُواْ","So let them worship"],["رَبَّ","(the) Lord"],["هَٰذَا","(of) this"],["ٱلۡبَيۡتِ","House"]]},{"s":26,"a":88,"en":"The Day when there will not benefit [anyone] wealth or children","w":[["يَوۡمَ","(The) Day"],["لَا","not"],["يَنفَعُ","will benefit"],["مَالٞ","wealth"],["وَلَا","and not"],["بَنُونَ","sons"]]},{"s":12,"a":2,"en":"Indeed, We have sent it down as an Arabic Qur'an that you might understand.","w":[["إِنَّآ","Indeed,We"],["أَنزَلۡنَٰهُ","We have sent it down"],["قُرۡءَٰنًا","(as) a Quran in Arabic"],["عَرَبِيّٗا","(as) a Quran in Arabic"],["لَّعَلَّكُمۡ","so that you may"],["تَعۡقِلُونَ","understand"]]},{"s":10,"a":63,"en":"Those who believed and were fearing Allah","w":[["ٱلَّذِينَ","Those who"],["ءَامَنُواْ","believe"],["وَكَانُواْ","and are"],["يَتَّقُونَ","conscious (of Allah)"]]},{"s":81,"a":24,"en":"And Muhammad is not a withholder of [knowledge of] the unseen.","w":[["وَمَا","And not"],["هُوَ","he (is)"],["عَلَى","on"],["ٱلۡغَيۡبِ","the unseen"],["بِضَنِينٖ","a withholder"]]},{"s":50,"a":20,"en":"And the Horn will be blown. That is the Day of [carrying out] the threat.","w":[["وَنُفِخَ","And will be blown"],["فِي","[in]"],["ٱلصُّورِۚ","the trumpet"],["ذَٰلِكَ","That"],["يَوۡمُ","(is the) Day"],["ٱلۡوَعِيدِ","(of) the Warning"]]},{"s":5,"a":98,"en":"Know that Allah is severe in penalty and that Allah is Forgiving and Merciful.","w":[["ٱعۡلَمُوٓاْ","Know"],["أَنَّ","that"],["ٱللَّهَ","Allah"],["شَدِيدُ","(is) severe"],["ٱلۡعِقَابِ","(in) punishment"],["وَأَنَّ","and that"],["ٱللَّهَ","Allah"],["غَفُورٞ","(is) Oft-Forgiving"],["رَّحِيمٞ","Most Merciful"]]},{"s":39,"a":39,"en":"Say, \"O my people, work according to your position, [for] indeed, I am working; and you are going to know","w":[["قُلۡ","Say"],["يَٰقَوۡمِ","O my people"],["ٱعۡمَلُواْ","Work"],["عَلَىٰ","(according) to"],["مَكَانَتِكُمۡ","your position"],["إِنِّي","indeed,I am"],["عَٰمِلٞۖ","working"],["فَسَوۡفَ","then soon"],["تَعۡلَمُونَ","you will know"]]},{"s":11,"a":55,"en":"Other than Him. So plot against me all together; then do not give me respite.","w":[["مِن","Other than Him"],["دُونِهِۦۖ","Other than Him"],["فَكِيدُونِي","So plot against me"],["جَمِيعٗا","all together"],["ثُمَّ","then"],["لَا","(do) not"],["تُنظِرُونِ","give me respite"]]},{"s":111,"a":3,"en":"He will [enter to] burn in a Fire of [blazing] flame","w":[["سَيَصۡلَىٰ","He will be burnt"],["نَارٗا","(in) a Fire"],["ذَاتَ","of"],["لَهَبٖ","Blazing Flames"]]},{"s":7,"a":97,"en":"Then, did the people of the cities feel secure from Our punishment coming to them at night while they were asleep?","w":[["أَفَأَمِنَ","Then did feel secure"],["أَهۡلُ","(the) people"],["ٱلۡقُرَىٰٓ","(of) the cities"],["أَن","that"],["يَأۡتِيَهُم","comes to them"],["بَأۡسُنَا","Our punishment"],["بَيَٰتٗا","(at) night"],["وَهُمۡ","while they"],["نَآئِمُونَ","(were) asleep"]]},{"s":108,"a":3,"en":"Indeed, your enemy is the one cut off.","w":[["إِنَّ","Indeed"],["شَانِئَكَ","your enemy"],["هُوَ","he (is)"],["ٱلۡأَبۡتَرُ","the one cut off"]]},{"s":1,"a":7,"en":"The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray.","w":[["صِرَٰطَ","(The) path"],["ٱلَّذِينَ","(of) those"],["أَنۡعَمۡتَ","You have bestowed (Your) Favors"],["عَلَيۡهِمۡ","on them"],["غَيۡرِ","not (of)"],["ٱلۡمَغۡضُوبِ","those who earned (Your) wrath"],["عَلَيۡهِمۡ","on themselves"],["وَلَا","and not"],["ٱلضَّآلِّينَ","(of) those who go astray"]]},{"s":28,"a":62,"en":"And [warn of] the Day He will call them and say, \"Where are My 'partners' which you used to claim?\"","w":[["وَيَوۡمَ","And (the) Day"],["يُنَادِيهِمۡ","He will call them"],["فَيَقُولُ","and say"],["أَيۡنَ","Where"],["شُرَكَآءِيَ","(are) My partners"],["ٱلَّذِينَ","whom"],["كُنتُمۡ","you used (to)"],["تَزۡعُمُونَ","claim"]]},{"s":18,"a":83,"en":"And they ask you, [O Muhammad], about Dhul-Qarnayn. Say, \"I will recite to you about him a report.\"","w":[["وَيَسۡـَٔلُونَكَ","And they ask you"],["عَن","about"],["ذِي","Dhul-qarnain"],["ٱلۡقَرۡنَيۡنِۖ","Dhul-qarnain"],["قُلۡ","Say"],["سَأَتۡلُواْ","I will recite"],["عَلَيۡكُم","to you"],["مِّنۡهُ","about him"],["ذِكۡرًا","a remembrance"]]},{"s":76,"a":29,"en":"Indeed, this is a reminder, so he who wills may take to his Lord a way.","w":[["إِنَّ","Indeed"],["هَٰذِهِۦ","this"],["تَذۡكِرَةٞۖ","(is) a reminder"],["فَمَن","so whoever"],["شَآءَ","wills"],["ٱتَّخَذَ","let him take"],["إِلَىٰ","to"],["رَبِّهِۦ","his Lord"],["سَبِيلٗا","a way"]]},{"s":96,"a":15,"en":"No! If he does not desist, We will surely drag him by the forelock -","w":[["كَلَّا","Nay"],["لَئِن","If"],["لَّمۡ","not"],["يَنتَهِ","he desists"],["لَنَسۡفَعَۢا","surely We will drag him"],["بِٱلنَّاصِيَةِ","by the forelock"]]},{"s":9,"a":22,"en":"[They will be] abiding therein forever. Indeed, Allah has with Him a great reward.","w":[["خَٰلِدِينَ","(They will) abide"],["فِيهَآ","in it"],["أَبَدًاۚ","forever"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["عِندَهُۥٓ","with Him"],["أَجۡرٌ","(is) a reward"],["عَظِيمٞ","great"]]},{"s":40,"a":36,"en":"And Pharaoh said, \"O Haman, construct for me a tower that I might reach the ways -","w":[["وَقَالَ","And said"],["فِرۡعَوۡنُ","Firaun"],["يَٰهَٰمَٰنُ","O Haman"],["ٱبۡنِ","Construct"],["لِي","for me"],["صَرۡحٗا","a tower"],["لَّعَلِّيٓ","that I may"],["أَبۡلُغُ","reach"],["ٱلۡأَسۡبَٰبَ","the ways"]]},{"s":91,"a":10,"en":"And he has failed who instills it [with corruption].","w":[["وَقَدۡ","And indeed"],["خَابَ","he fails"],["مَن","who"],["دَسَّىٰهَا","buries it"]]},{"s":4,"a":70,"en":"That is the bounty from Allah, and sufficient is Allah as Knower.","w":[["ذَٰلِكَ","That"],["ٱلۡفَضۡلُ","(is) the Bounty"],["مِنَ","of"],["ٱللَّهِۚ","Allah"],["وَكَفَىٰ","and sufficient"],["بِٱللَّهِ","Allah"],["عَلِيمٗا","(as) All-Knower"]]},{"s":24,"a":10,"en":"And if not for the favor of Allah upon you and His mercy... and because Allah is Accepting of repentance and Wise.","w":[["وَلَوۡلَا","And if not"],["فَضۡلُ","(for) the Grace of Allah"],["ٱللَّهِ","(for) the Grace of Allah"],["عَلَيۡكُمۡ","upon you"],["وَرَحۡمَتُهُۥ","and His Mercy"],["وَأَنَّ","and that"],["ٱللَّهَ","Allah"],["تَوَّابٌ","(is) Oft-Returning (to Mercy)"],["حَكِيمٌ","All-Wise"]]},{"s":74,"a":44,"en":"Nor did we used to feed the poor.","w":[["وَلَمۡ","And not"],["نَكُ","we used to"],["نُطۡعِمُ","feed"],["ٱلۡمِسۡكِينَ","the poor"]]}]
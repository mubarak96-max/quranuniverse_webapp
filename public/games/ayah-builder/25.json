[{"s":114,"a":4,"en":"From the evil of the retreating whisperer -","w":[["مِن","From"],["شَرِّ","(the) evil"],["ٱلۡوَسۡوَاسِ","(of) the whisperer"],["ٱلۡخَنَّاسِ","the one who withdraws"]]},{"s":52,"a":34,"en":"Then let them produce a statement like it, if they should be truthful.","w":[["فَلۡيَأۡتُواْ","Then let them bring"],["بِحَدِيثٖ","a statement"],["مِّثۡلِهِۦٓ","like it"],["إِن","if"],["كَانُواْ","they are"],["صَٰدِقِينَ","truthful"]]},{"s":35,"a":19,"en":"Not equal are the blind and the seeing,","w":[["وَمَا","And not"],["يَسۡتَوِي","equal"],["ٱلۡأَعۡمَىٰ","(are) the blind"],["وَٱلۡبَصِيرُ","and the seeing"]]},{"s":58,"a":21,"en":"Allah has written, \"I will surely overcome, I and My messengers.\" Indeed, Allah is Powerful and Exalted in Might.","w":[["كَتَبَ","Allah has decreed"],["ٱللَّهُ","Allah has decreed"],["لَأَغۡلِبَنَّ","Surely,I will overcome"],["أَنَا۠","I"],["وَرُسُلِيٓۚ","and My Messengers"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["قَوِيٌّ","(is) All-Strong"],["عَزِيزٞ","All-Mighty"]]},{"s":53,"a":12,"en":"So will you dispute with him over what he saw?","w":[["أَفَتُمَٰرُونَهُۥ","Then will you dispute with him"],["عَلَىٰ","about"],["مَا","what"],["يَرَىٰ","he saw"]]},{"s":54,"a":27,"en":"Indeed, We are sending the she-camel as trial for them, so watch them and be patient.","w":[["إِنَّا","Indeed,We"],["مُرۡسِلُواْ","(are) sending"],["ٱلنَّاقَةِ","the she-camel"],["فِتۡنَةٗ","(as) a trial"],["لَّهُمۡ","for them"],["فَٱرۡتَقِبۡهُمۡ","so watch them"],["وَٱصۡطَبِرۡ","and be patient"]]},{"s":43,"a":87,"en":"And if you asked them who created them, they would surely say, \"Allah.\" So how are they deluded?","w":[["وَلَئِن","And if"],["سَأَلۡتَهُم","you ask them"],["مَّنۡ","who"],["خَلَقَهُمۡ","created them"],["لَيَقُولُنَّ","they will certainly say"],["ٱللَّهُۖ","Allah"],["فَأَنَّىٰ","Then how"],["يُؤۡفَكُونَ","are they deluded"]]},{"s":33,"a":64,"en":"Indeed, Allah has cursed the disbelievers and prepared for them a Blaze.","w":[["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["لَعَنَ","has cursed"],["ٱلۡكَٰفِرِينَ","the disbelievers"],["وَأَعَدَّ","and has prepared"],["لَهُمۡ","for them"],["سَعِيرًا","a Blaze"]]},{"s":16,"a":82,"en":"But if they turn away, [O Muhammad] - then only upon you is [responsibility for] clear notification.","w":[["فَإِن","Then,if"],["تَوَلَّوۡاْ","they turn away"],["فَإِنَّمَا","then only"],["عَلَيۡكَ","upon you"],["ٱلۡبَلَٰغُ","(is) the conveyance"],["ٱلۡمُبِينُ","the clear"]]},{"s":57,"a":5,"en":"His is the dominion of the heavens and earth. And to Allah are returned [all] matters.","w":[["لَّهُۥ","For Him"],["مُلۡكُ","(is the) dominion"],["ٱلسَّمَٰوَٰتِ","(of) the heavens"],["وَٱلۡأَرۡضِۚ","and the earth"],["وَإِلَى","and to"],["ٱللَّهِ","Allah"],["تُرۡجَعُ","will be returned"],["ٱلۡأُمُورُ","the matters"]]},{"s":112,"a":1,"en":"Say, \"He is Allah, [who is] One,","w":[["قُلۡ","Say"],["هُوَ","He"],["ٱللَّهُ","(is) Allah"],["أَحَدٌ","the One"]]},{"s":44,"a":16,"en":"The Day We will strike with the greatest assault, indeed, We will take retribution.","w":[["يَوۡمَ","(The) Day"],["نَبۡطِشُ","We will seize"],["ٱلۡبَطۡشَةَ","(with) the seizure"],["ٱلۡكُبۡرَىٰٓ","the greatest"],["إِنَّا","indeed,We"],["مُنتَقِمُونَ","(will) take retribution"]]},{"s":95,"a":8,"en":"Is not Allah the most just of judges?","w":[["أَلَيۡسَ","Is not"],["ٱللَّهُ","Allah"],["بِأَحۡكَمِ","(the) Most Just"],["ٱلۡحَٰكِمِينَ","(of) the Judges"]]},{"s":78,"a":21,"en":"Indeed, Hell has been lying in wait","w":[["إِنَّ","Indeed"],["جَهَنَّمَ","Hell"],["كَانَتۡ","is"],["مِرۡصَادٗا","lying in wait"]]},{"s":36,"a":72,"en":"And We have tamed them for them, so some of them they ride, and some of them they eat.","w":[["وَذَلَّلۡنَٰهَا","And We have tamed them"],["لَهُمۡ","for them"],["فَمِنۡهَا","so some of them"],["رَكُوبُهُمۡ","they ride them"],["وَمِنۡهَا","and some of them"],["يَأۡكُلُونَ","they eat"]]},{"s":15,"a":20,"en":"And We have made for you therein means of living and [for] those for whom you are not providers.","w":[["وَجَعَلۡنَا","And We have made"],["لَكُمۡ","for you"],["فِيهَا","therein"],["مَعَٰيِشَ","means of living"],["وَمَن","and whom"],["لَّسۡتُمۡ","you are not"],["لَهُۥ","for him"],["بِرَٰزِقِينَ","providers"]]},{"s":19,"a":13,"en":"And affection from Us and purity, and he was fearing of Allah","w":[["وَحَنَانٗا","And affection"],["مِّن","from"],["لَّدُنَّا","Us"],["وَزَكَوٰةٗۖ","and purity"],["وَكَانَ","and he was"],["تَقِيّٗا","righteous"]]},{"s":99,"a":5,"en":"Because your Lord has commanded it.","w":[["بِأَنَّ","Because"],["رَبَّكَ","your Lord"],["أَوۡحَىٰ","inspired"],["لَهَا","[to] it"]]},{"s":68,"a":52,"en":"But it is not except a reminder to the worlds.","w":[["وَمَا","And not"],["هُوَ","it (is)"],["إِلَّا","but"],["ذِكۡرٞ","a Reminder"],["لِّلۡعَٰلَمِينَ","to the worlds"]]},{"s":85,"a":17,"en":"Has there reached you the story of the soldiers -","w":[["هَلۡ","Has"],["أَتَىٰكَ","come to you"],["حَدِيثُ","(the) story"],["ٱلۡجُنُودِ","(of) the hosts"]]},{"s":36,"a":75,"en":"They are not able to help them, and they [themselves] are for them soldiers in attendance.","w":[["لَا","Not"],["يَسۡتَطِيعُونَ","they are able"],["نَصۡرَهُمۡ","to help them"],["وَهُمۡ","but they"],["لَهُمۡ","for them"],["جُندٞ","(are) hosts"],["مُّحۡضَرُونَ","(who will) be brought"]]},{"s":42,"a":41,"en":"And whoever avenges himself after having been wronged - those have not upon them any cause [for blame].","w":[["وَلَمَنِ","And surely whosoever"],["ٱنتَصَرَ","defends himself"],["بَعۡدَ","after"],["ظُلۡمِهِۦ","he has been wronged"],["فَأُوْلَـٰٓئِكَ","then those"],["مَا","not"],["عَلَيۡهِم","(is) against them"],["مِّن","any"],["سَبِيلٍ","way"]]},{"s":93,"a":5,"en":"And your Lord is going to give you, and you will be satisfied.","w":[["وَلَسَوۡفَ","And soon"],["يُعۡطِيكَ","will give you"],["رَبُّكَ","your Lord"],["فَتَرۡضَىٰٓ","then you will be satisfied"]]},{"s":79,"a":46,"en":"It will be, on the Day they see it, as though they had not remained [in the world] except for an afternoon or a morning thereof.","w":[["كَأَنَّهُمۡ","As though they"],["يَوۡمَ","(the) Day"],["يَرَوۡنَهَا","they see it"],["لَمۡ","not"],["يَلۡبَثُوٓاْ","they had remained"],["إِلَّا","except"],["عَشِيَّةً","an evening"],["أَوۡ","or"],["ضُحَىٰهَا","a morning thereof"]]},{"s":76,"a":7,"en":"They [are those who] fulfill [their] vows and fear a Day whose evil will be widespread.","w":[["يُوفُونَ","They fulfill"],["بِٱلنَّذۡرِ","the vows"],["وَيَخَافُونَ","and fear"],["يَوۡمٗا","a Day"],["كَانَ","(which) is"],["شَرُّهُۥ","its evil"],["مُسۡتَطِيرٗا","widespread"]]},{"s":55,"a":78,"en":"Blessed is the name of your Lord, Owner of Majesty and Honor.","w":[["تَبَٰرَكَ","Blessed is"],["ٱسۡمُ","(the) name"],["رَبِّكَ","(of) your Lord"],["ذِي","Owner"],["ٱلۡجَلَٰلِ","(of) Majesty"],["وَٱلۡإِكۡرَامِ","and Honor"]]},{"s":50,"a":40,"en":"And [in part] of the night exalt Him and after prostration.","w":[["وَمِنَ","And of"],["ٱلَّيۡلِ","the night"],["فَسَبِّحۡهُ","glorify Him"],["وَأَدۡبَٰرَ","and after"],["ٱلسُّجُودِ","the prostration"]]},{"s":18,"a":108,"en":"Wherein they abide eternally. They will not desire from it any transfer.","w":[["خَٰلِدِينَ","Abiding forever"],["فِيهَا","in it"],["لَا","Not"],["يَبۡغُونَ","they will desire"],["عَنۡهَا","from it"],["حِوَلٗا","any transfer"]]},{"s":24,"a":17,"en":"Allah warns you against returning to the likes of this [conduct], ever, if you should be believers.","w":[["يَعِظُكُمُ","Allah warns you"],["ٱللَّهُ","Allah warns you"],["أَن","that"],["تَعُودُواْ","you return"],["لِمِثۡلِهِۦٓ","(to the) like of it"],["أَبَدًا","ever"],["إِن","if"],["كُنتُم","you are"],["مُّؤۡمِنِينَ","believers"]]},{"s":71,"a":3,"en":"[Saying], 'Worship Allah, fear Him and obey me.","w":[["أَنِ","That"],["ٱعۡبُدُواْ","Worship"],["ٱللَّهَ","Allah"],["وَٱتَّقُوهُ","and fear Him"],["وَأَطِيعُونِ","and obey me"]]}]
[{"s":49,"a":8,"en":"[It is] as bounty from Allah and favor. And Allah is Knowing and Wise.","w":[["فَضۡلٗا","A Bounty"],["مِّنَ","from Allah"],["ٱللَّهِ","from Allah"],["وَنِعۡمَةٗۚ","and favor"],["وَٱللَّهُ","And Allah"],["عَلِيمٌ","(is) All-Knower"],["حَكِيمٞ","All-Wise"]]},{"s":99,"a":1,"en":"When the earth is shaken with its [final] earthquake","w":[["إِذَا","When"],["زُلۡزِلَتِ","is shaken"],["ٱلۡأَرۡضُ","the earth"],["زِلۡزَالَهَا","(with) its earthquake"]]},{"s":29,"a":37,"en":"But they denied him, so the earthquake seized them, and they became within their home [corpses] fallen prone.","w":[["فَكَذَّبُوهُ","But they denied him"],["فَأَخَذَتۡهُمُ","so seized them"],["ٱلرَّجۡفَةُ","the earthquake"],["فَأَصۡبَحُواْ","and they became"],["فِي","in"],["دَارِهِمۡ","their home"],["جَٰثِمِينَ","fallen prone"]]},{"s":80,"a":22,"en":"Then when He wills, He will resurrect him.","w":[["ثُمَّ","Then"],["إِذَا","when"],["شَآءَ","He wills"],["أَنشَرَهُۥ","He will resurrect him"]]},{"s":40,"a":2,"en":"The revelation of the Book is from Allah, the Exalted in Might, the Knowing.","w":[["تَنزِيلُ","(The) revelation"],["ٱلۡكِتَٰبِ","(of) the Book"],["مِنَ","(is) from"],["ٱللَّهِ","Allah"],["ٱلۡعَزِيزِ","the All-Mighty"],["ٱلۡعَلِيمِ","the All-Knower"]]},{"s":48,"a":7,"en":"And to Allah belong the soldiers of the heavens and the earth. And ever is Allah Exalted in Might and Wise.","w":[["وَلِلَّهِ","And for Allah"],["جُنُودُ","(are the) hosts"],["ٱلسَّمَٰوَٰتِ","(of) the heavens"],["وَٱلۡأَرۡضِۚ","and the earth"],["وَكَانَ","and Allah"],["ٱللَّهُ","and Allah"],["عَزِيزًا","(is) All-Mighty"],["حَكِيمًا","All-Wise"]]},{"s":106,"a":3,"en":"Let them worship the Lord of this House,","w":[["فَلۡيَعۡبُدُواْ","So let them worship"],["رَبَّ","(the) Lord"],["هَٰذَا","(of) this"],["ٱلۡبَيۡتِ","House"]]},{"s":82,"a":13,"en":"Indeed, the righteous will be in pleasure,","w":[["إِنَّ","Indeed"],["ٱلۡأَبۡرَارَ","the righteous"],["لَفِي","(will be) surely in"],["نَعِيمٖ","bliss"]]},{"s":109,"a":4,"en":"Nor will I be a worshipper of what you worship.","w":[["وَلَآ","And not"],["أَنَا۠","I am"],["عَابِدٞ","a worshipper"],["مَّا","(of) what"],["عَبَدتُّمۡ","you worship"]]},{"s":81,"a":23,"en":"And he has already seen Gabriel in the clear horizon.","w":[["وَلَقَدۡ","And certainly"],["رَءَاهُ","he saw him"],["بِٱلۡأُفُقِ","in the horizon"],["ٱلۡمُبِينِ","the clear"]]},{"s":107,"a":3,"en":"And does not encourage the feeding of the poor.","w":[["وَلَا","And (does) not"],["يَحُضُّ","feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلۡمِسۡكِينِ","the poor"]]},{"s":6,"a":9,"en":"And if We had made him an angel, We would have made him [appear as] a man, and We would have covered them with that in which they cover themselves.","w":[["وَلَوۡ","And if"],["جَعَلۡنَٰهُ","We had made him"],["مَلَكٗا","an Angel"],["لَّجَعَلۡنَٰهُ","certainly We (would) have made him"],["رَجُلٗا","a man"],["وَلَلَبَسۡنَا","and certainly We (would) have obscured"],["عَلَيۡهِم","to them"],["مَّا","what"],["يَلۡبِسُونَ","they are obscuring"]]},{"s":105,"a":1,"en":"Have you not considered, [O Muhammad], how your Lord dealt with the companions of the elephant?","w":[["أَلَمۡ","Have not"],["تَرَ","you seen"],["كَيۡفَ","how"],["فَعَلَ","dealt"],["رَبُّكَ","your Lord"],["بِأَصۡحَٰبِ","with (the) Companions"],["ٱلۡفِيلِ","(of the) Elephant"]]},{"s":17,"a":11,"en":"And man supplicates for evil as he supplicates for good, and man is ever hasty.","w":[["وَيَدۡعُ","And prays"],["ٱلۡإِنسَٰنُ","the man"],["بِٱلشَّرِّ","for evil"],["دُعَآءَهُۥ","(as) he prays"],["بِٱلۡخَيۡرِۖ","for the good"],["وَكَانَ","And is"],["ٱلۡإِنسَٰنُ","the man"],["عَجُولٗا","ever hasty"]]},{"s":104,"a":2,"en":"Who collects wealth and [continuously] counts it.","w":[["ٱلَّذِي","The one who"],["جَمَعَ","collects"],["مَالٗا","wealth"],["وَعَدَّدَهُۥ","and counts it"]]},{"s":95,"a":8,"en":"Is not Allah the most just of judges?","w":[["أَلَيۡسَ","Is not"],["ٱللَّهُ","Allah"],["بِأَحۡكَمِ","(the) Most Just"],["ٱلۡحَٰكِمِينَ","(of) the Judges"]]},{"s":90,"a":17,"en":"And then being among those who believed and advised one another to patience and advised one another to compassion.","w":[["ثُمَّ","Then"],["كَانَ","he is"],["مِنَ","of"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلصَّبۡرِ","to patience"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلۡمَرۡحَمَةِ","to compassion"]]},{"s":54,"a":13,"en":"And We carried him on a [construction of] planks and nails,","w":[["وَحَمَلۡنَٰهُ","And We carried him"],["عَلَىٰ","on"],["ذَاتِ","(ark) made of planks"],["أَلۡوَٰحٖ","(ark) made of planks"],["وَدُسُرٖ","and nails"]]},{"s":87,"a":7,"en":"Except what Allah should will. Indeed, He knows what is declared and what is hidden.","w":[["إِلَّا","Except"],["مَا","what"],["شَآءَ","wills"],["ٱللَّهُۚ","Allah"],["إِنَّهُۥ","Indeed,He"],["يَعۡلَمُ","knows"],["ٱلۡجَهۡرَ","the manifest"],["وَمَا","and what"],["يَخۡفَىٰ","is hidden"]]},{"s":62,"a":7,"en":"But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers.","w":[["وَلَا","But not"],["يَتَمَنَّوۡنَهُۥٓ","they will wish for it"],["أَبَدَۢا","ever"],["بِمَا","for what"],["قَدَّمَتۡ","(have) sent forth"],["أَيۡدِيهِمۡۚ","their hands"],["وَٱللَّهُ","And Allah"],["عَلِيمُۢ","(is) All-Knowing"],["بِٱلظَّـٰلِمِينَ","of the wrongdoers"]]},{"s":102,"a":5,"en":"No! If you only knew with knowledge of certainty...","w":[["كَلَّا","Nay"],["لَوۡ","If"],["تَعۡلَمُونَ","you know"],["عِلۡمَ","(with) a knowledge"],["ٱلۡيَقِينِ","(of) certainty"]]},{"s":33,"a":45,"en":"O Prophet, indeed We have sent you as a witness and a bringer of good tidings and a warner.","w":[["يَـٰٓأَيُّهَا","O Prophet"],["ٱلنَّبِيُّ","O Prophet"],["إِنَّآ","Indeed,We"],["أَرۡسَلۡنَٰكَ","have sent you"],["شَٰهِدٗا","(as) a witness"],["وَمُبَشِّرٗا","and a bearer of glad tidings"],["وَنَذِيرٗا","and (as) a warner"]]},{"s":101,"a":4,"en":"It is the Day when people will be like moths, dispersed,","w":[["يَوۡمَ","(The) Day"],["يَكُونُ","will be"],["ٱلنَّاسُ","the mankind"],["كَٱلۡفَرَاشِ","like moths"],["ٱلۡمَبۡثُوثِ","scattered"]]},{"s":74,"a":15,"en":"Then he desires that I should add more.","w":[["ثُمَّ","Then"],["يَطۡمَعُ","he desires"],["أَنۡ","that"],["أَزِيدَ","I (should) add more"]]},{"s":110,"a":2,"en":"And you see the people entering into the religion of Allah in multitudes,","w":[["وَرَأَيۡتَ","And you see"],["ٱلنَّاسَ","the people"],["يَدۡخُلُونَ","entering"],["فِي","into"],["دِينِ","(the) religion"],["ٱللَّهِ","(of) Allah"],["أَفۡوَاجٗا","(in) multitudes"]]},{"s":37,"a":93,"en":"And he turned upon them a blow with [his] right hand.","w":[["فَرَاغَ","Then he turned"],["عَلَيۡهِمۡ","upon them"],["ضَرۡبَۢا","striking"],["بِٱلۡيَمِينِ","with the right hand"]]},{"s":86,"a":5,"en":"So let man observe from what he was created.","w":[["فَلۡيَنظُرِ","So let see"],["ٱلۡإِنسَٰنُ","man"],["مِمَّ","from what"],["خُلِقَ","he is created"]]},{"s":5,"a":102,"en":"A people asked such [questions] before you; then they became thereby disbelievers.","w":[["قَدۡ","Indeed"],["سَأَلَهَا","asked them"],["قَوۡمٞ","a people"],["مِّن","from"],["قَبۡلِكُمۡ","before you"],["ثُمَّ","then"],["أَصۡبَحُواْ","they became"],["بِهَا","thereby"],["كَٰفِرِينَ","disbelievers"]]},{"s":89,"a":28,"en":"Return to your Lord, well-pleased and pleasing [to Him],","w":[["ٱرۡجِعِيٓ","Return"],["إِلَىٰ","to"],["رَبِّكِ","your Lord"],["رَاضِيَةٗ","well pleased"],["مَّرۡضِيَّةٗ","and pleasing"]]},{"s":46,"a":2,"en":"The revelation of the Book is from Allah, the Exalted in Might, the Wise.","w":[["تَنزِيلُ","(The) revelation"],["ٱلۡكِتَٰبِ","(of) the Book"],["مِنَ","(is) from"],["ٱللَّهِ","Allah"],["ٱلۡعَزِيزِ","the All-Mighty"],["ٱلۡحَكِيمِ","the All-Wise"]]}]
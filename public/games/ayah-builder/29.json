[{"s":21,"a":95,"en":"And there is prohibition upon [the people of] a city which We have destroyed that they will [ever] return","w":[["وَحَرَٰمٌ","And (there is) prohibition"],["عَلَىٰ","upon"],["قَرۡيَةٍ","a city"],["أَهۡلَكۡنَٰهَآ","which We have destroyed"],["أَنَّهُمۡ","that they"],["لَا","not"],["يَرۡجِعُونَ","will return"]]},{"s":3,"a":12,"en":"Say to those who disbelieve, \"You will be overcome and gathered together to Hell, and wretched is the resting place.\"","w":[["قُل","Say"],["لِّلَّذِينَ","to those who"],["كَفَرُواْ","disbelieve [d]"],["سَتُغۡلَبُونَ","You will be overcome"],["وَتُحۡشَرُونَ","and you will be gathered"],["إِلَىٰ","to"],["جَهَنَّمَۖ","Hell"],["وَبِئۡسَ","[and] an evil"],["ٱلۡمِهَادُ","[the] resting place"]]},{"s":10,"a":56,"en":"He gives life and causes death, and to Him you will be returned","w":[["هُوَ","He"],["يُحۡيِۦ","gives life"],["وَيُمِيتُ","and causes death"],["وَإِلَيۡهِ","and to Him"],["تُرۡجَعُونَ","you will be returned"]]},{"s":45,"a":7,"en":"Woe to every sinful liar","w":[["وَيۡلٞ","Woe"],["لِّكُلِّ","to every"],["أَفَّاكٍ","liar"],["أَثِيمٖ","sinful"]]},{"s":92,"a":8,"en":"But as for he who withholds and considers himself free of need","w":[["وَأَمَّا","But as for"],["مَنۢ","(him) who"],["بَخِلَ","withholds"],["وَٱسۡتَغۡنَىٰ","and considers himself free from need"]]},{"s":4,"a":118,"en":"Whom Allah has cursed. For he had said, \"I will surely take from among Your servants a specific portion.","w":[["لَّعَنَهُ","He was cursed"],["ٱللَّهُۘ","by Allah"],["وَقَالَ","and he said"],["لَأَتَّخِذَنَّ","I will surely take"],["مِنۡ","from"],["عِبَادِكَ","your slaves"],["نَصِيبٗا","a portion"],["مَّفۡرُوضٗا","appointed"]]},{"s":61,"a":2,"en":"O you who have believed, why do you say what you do not do?","w":[["يَـٰٓأَيُّهَا","O"],["ٱلَّذِينَ","(you) who"],["ءَامَنُواْ","believe"],["لِمَ","Why"],["تَقُولُونَ","(do) you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":75,"a":3,"en":"Does man think that We will not assemble his bones?","w":[["أَيَحۡسَبُ","Does think"],["ٱلۡإِنسَٰنُ","[the] man"],["أَلَّن","that not"],["نَّجۡمَعَ","We will assemble"],["عِظَامَهُۥ","his bones"]]},{"s":23,"a":61,"en":"It is those who hasten to good deeds, and they outstrip [others] therein.","w":[["أُوْلَـٰٓئِكَ","(It is) those"],["يُسَٰرِعُونَ","who hasten"],["فِي","in"],["ٱلۡخَيۡرَٰتِ","the good (deeds)"],["وَهُمۡ","and they"],["لَهَا","in them"],["سَٰبِقُونَ","(are) foremost"]]},{"s":14,"a":20,"en":"And that is not difficult for Allah.","w":[["وَمَا","And not"],["ذَٰلِكَ","(is) that"],["عَلَى","on"],["ٱللَّهِ","Allah"],["بِعَزِيزٖ","great"]]},{"s":16,"a":117,"en":"[It is but] a brief enjoyment, and they will have a painful punishment.","w":[["مَتَٰعٞ","An enjoyment"],["قَلِيلٞ","little"],["وَلَهُمۡ","and for them"],["عَذَابٌ","(is) a punishment"],["أَلِيمٞ","painful"]]},{"s":57,"a":1,"en":"Whatever is in the heavens and earth exalts Allah, and He is the Exalted in Might, the Wise.","w":[["سَبَّحَ","Glorifies"],["لِلَّهِ","[to] Allah"],["مَا","whatever"],["فِي","(is) in"],["ٱلسَّمَٰوَٰتِ","the heavens"],["وَٱلۡأَرۡضِۖ","and the earth"],["وَهُوَ","and He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":27,"a":71,"en":"And they say, \"When is [the fulfillment of] this promise, if you should be truthful?\"","w":[["وَيَقُولُونَ","And they say"],["مَتَىٰ","When"],["هَٰذَا","(will) this"],["ٱلۡوَعۡدُ","promise (be fulfilled)"],["إِن","if"],["كُنتُمۡ","you are"],["صَٰدِقِينَ","truthful"]]},{"s":35,"a":19,"en":"Not equal are the blind and the seeing,","w":[["وَمَا","And not"],["يَسۡتَوِي","equal"],["ٱلۡأَعۡمَىٰ","(are) the blind"],["وَٱلۡبَصِيرُ","and the seeing"]]},{"s":4,"a":120,"en":"Satan promises them and arouses desire in them. But Satan does not promise them except delusion.","w":[["يَعِدُهُمۡ","He promises them"],["وَيُمَنِّيهِمۡۖ","and arouses desires in them"],["وَمَا","and not"],["يَعِدُهُمُ","promises them"],["ٱلشَّيۡطَٰنُ","the Shaitaan"],["إِلَّا","except"],["غُرُورًا","deception"]]},{"s":31,"a":9,"en":"Wherein they abide eternally; [it is] the promise of Allah [which is] truth. And He is the Exalted in Might, the Wise.","w":[["خَٰلِدِينَ","(To) abide forever"],["فِيهَاۖ","in it"],["وَعۡدَ","(The) Promise of Allah"],["ٱللَّهِ","(The) Promise of Allah"],["حَقّٗاۚ","(is) true"],["وَهُوَ","And He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":50,"a":12,"en":"The people of Noah denied before them, and the companions of the well and Thamud","w":[["كَذَّبَتۡ","Denied"],["قَبۡلَهُمۡ","before them"],["قَوۡمُ","(the) people"],["نُوحٖ","(of) Nuh"],["وَأَصۡحَٰبُ","and (the) companions"],["ٱلرَّسِّ","(of) Ar-Raas"],["وَثَمُودُ","and Thamud"]]},{"s":52,"a":45,"en":"So leave them until they meet their Day in which they will be struck insensible -","w":[["فَذَرۡهُمۡ","So leave them"],["حَتَّىٰ","until"],["يُلَٰقُواْ","they meet"],["يَوۡمَهُمُ","their Day"],["ٱلَّذِي","which"],["فِيهِ","in it"],["يُصۡعَقُونَ","they will faint"]]},{"s":20,"a":119,"en":"And indeed, you will not be thirsty therein or be hot from the sun.\"","w":[["وَأَنَّكَ","And that you"],["لَا","not"],["تَظۡمَؤُاْ","will suffer from thirst"],["فِيهَا","therein"],["وَلَا","and not"],["تَضۡحَىٰ","exposed to the sun's heat"]]},{"s":18,"a":67,"en":"He said, \"Indeed, with me you will never be able to have patience.","w":[["قَالَ","He said"],["إِنَّكَ","Indeed,you"],["لَن","never"],["تَسۡتَطِيعَ","will be able"],["مَعِيَ","with me"],["صَبۡرٗا","(to have) patience"]]},{"s":97,"a":4,"en":"The angels and the Spirit descend therein by permission of their Lord for every matter.","w":[["تَنَزَّلُ","Descend"],["ٱلۡمَلَـٰٓئِكَةُ","the Angels"],["وَٱلرُّوحُ","and the Spirit"],["فِيهَا","therein"],["بِإِذۡنِ","by (the) permission"],["رَبِّهِم","(of) their Lord"],["مِّن","for"],["كُلِّ","every"],["أَمۡرٖ","affair"]]},{"s":68,"a":31,"en":"They said, \"O woe to us; indeed we were transgressors.","w":[["قَالُواْ","They said"],["يَٰوَيۡلَنَآ","O woe to us"],["إِنَّا","Indeed,we"],["كُنَّا","[we] were"],["طَٰغِينَ","transgressors"]]},{"s":47,"a":1,"en":"Those who disbelieve and avert [people] from the way of Allah - He will waste their deeds.","w":[["ٱلَّذِينَ","Those who"],["كَفَرُواْ","disbelieve"],["وَصَدُّواْ","and turn away"],["عَن","from"],["سَبِيلِ","(the) way of Allah"],["ٱللَّهِ","(the) way of Allah"],["أَضَلَّ","He will cause to be lost"],["أَعۡمَٰلَهُمۡ","their deeds"]]},{"s":21,"a":60,"en":"They said, \"We heard a young man mention them who is called Abraham.\"","w":[["قَالُواْ","They said"],["سَمِعۡنَا","We heard"],["فَتٗى","a youth"],["يَذۡكُرُهُمۡ","mention them"],["يُقَالُ","he is called"],["لَهُۥٓ","he is called"],["إِبۡرَٰهِيمُ","Ibrahim"]]},{"s":82,"a":19,"en":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah.","w":[["يَوۡمَ","(The) Day"],["لَا","not"],["تَمۡلِكُ","will have power"],["نَفۡسٞ","a soul"],["لِّنَفۡسٖ","for a soul"],["شَيۡـٔٗاۖ","anything"],["وَٱلۡأَمۡرُ","and the Command"],["يَوۡمَئِذٖ","that Day"],["لِّلَّهِ","(will be) with Allah"]]},{"s":30,"a":26,"en":"And to Him belongs whoever is in the heavens and earth. All are to Him devoutly obedient.","w":[["وَلَهُۥ","And to Him (belongs)"],["مَن","whoever"],["فِي","(is) in"],["ٱلسَّمَٰوَٰتِ","the heavens"],["وَٱلۡأَرۡضِۖ","and the earth"],["كُلّٞ","All"],["لَّهُۥ","to Him"],["قَٰنِتُونَ","(are) obedient"]]},{"s":75,"a":6,"en":"He asks, \"When is the Day of Resurrection?\"","w":[["يَسۡـَٔلُ","He asks"],["أَيَّانَ","When"],["يَوۡمُ","(is the) Day"],["ٱلۡقِيَٰمَةِ","(of) the Resurrection"]]},{"s":29,"a":43,"en":"And these examples We present to the people, but none will understand them except those of knowledge.","w":[["وَتِلۡكَ","And these"],["ٱلۡأَمۡثَٰلُ","examples"],["نَضۡرِبُهَا","We set forth"],["لِلنَّاسِۖ","to mankind"],["وَمَا","but not"],["يَعۡقِلُهَآ","will understand them"],["إِلَّا","except"],["ٱلۡعَٰلِمُونَ","those of knowledge"]]},{"s":113,"a":3,"en":"And from the evil of darkness when it settles","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["غَاسِقٍ","(of) darkness"],["إِذَا","when"],["وَقَبَ","it spreads"]]},{"s":56,"a":24,"en":"As reward for what they used to do.","w":[["جَزَآءَۢ","A reward"],["بِمَا","for what"],["كَانُواْ","they used (to)"],["يَعۡمَلُونَ","do"]]}]
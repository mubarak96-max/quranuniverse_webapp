[{"s":64,"a":18,"en":"Knower of the unseen and the witnessed, the Exalted in Might, the Wise.","w":[["عَٰلِمُ","(The) Knower"],["ٱلۡغَيۡبِ","(of) the unseen"],["وَٱلشَّهَٰدَةِ","and the witnessed"],["ٱلۡعَزِيزُ","the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":55,"a":27,"en":"And there will remain the Face of your Lord, Owner of Majesty and Honor.","w":[["وَيَبۡقَىٰ","But will remain"],["وَجۡهُ","(the) Face"],["رَبِّكَ","(of) your Lord"],["ذُو","(the) Owner"],["ٱلۡجَلَٰلِ","(of) Majesty"],["وَٱلۡإِكۡرَامِ","and Honor"]]},{"s":83,"a":6,"en":"The Day when mankind will stand before the Lord of the worlds?","w":[["يَوۡمَ","(The) Day"],["يَقُومُ","will stand"],["ٱلنَّاسُ","mankind"],["لِرَبِّ","before (the) Lord"],["ٱلۡعَٰلَمِينَ","(of) the worlds"]]},{"s":53,"a":4,"en":"It is not but a revelation revealed,","w":[["إِنۡ","Not"],["هُوَ","it"],["إِلَّا","(is) except"],["وَحۡيٞ","a revelation"],["يُوحَىٰ","revealed"]]},{"s":102,"a":7,"en":"Then you will surely see it with the eye of certainty.","w":[["ثُمَّ","Then"],["لَتَرَوُنَّهَا","surely you will see it"],["عَيۡنَ","(with the) eye"],["ٱلۡيَقِينِ","(of) certainty"]]},{"s":81,"a":19,"en":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","w":[["إِنَّهُۥ","Indeed,it"],["لَقَوۡلُ","(is) surely a word"],["رَسُولٖ","(of) a Messenger"],["كَرِيمٖ","noble"]]},{"s":41,"a":41,"en":"Indeed, those who disbelieve in the message after it has come to them... And indeed, it is a mighty Book.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["كَفَرُواْ","disbelieve"],["بِٱلذِّكۡرِ","in the Reminder"],["لَمَّا","when"],["جَآءَهُمۡۖ","it comes to them"],["وَإِنَّهُۥ","And indeed,it"],["لَكِتَٰبٌ","(is) surely a Book"],["عَزِيزٞ","mighty"]]},{"s":45,"a":2,"en":"The revelation of the Book is from Allah, the Exalted in Might, the Wise.","w":[["تَنزِيلُ","(The) revelation"],["ٱلۡكِتَٰبِ","(of) the Book"],["مِنَ","(is) from"],["ٱللَّهِ","Allah"],["ٱلۡعَزِيزِ","the All-Mighty"],["ٱلۡحَكِيمِ","the All-Wise"]]},{"s":48,"a":1,"en":"Indeed, We have given you, [O Muhammad], a clear conquest","w":[["إِنَّا","Indeed"],["فَتَحۡنَا","We have given victory"],["لَكَ","to you"],["فَتۡحٗا","a victory"],["مُّبِينٗا","clear"]]},{"s":19,"a":86,"en":"And will drive the criminals to Hell in thirst","w":[["وَنَسُوقُ","And We will drive"],["ٱلۡمُجۡرِمِينَ","the criminals"],["إِلَىٰ","to"],["جَهَنَّمَ","Hell"],["وِرۡدٗا","thirsty"]]},{"s":58,"a":21,"en":"Allah has written, \"I will surely overcome, I and My messengers.\" Indeed, Allah is Powerful and Exalted in Might.","w":[["كَتَبَ","Allah has decreed"],["ٱللَّهُ","Allah has decreed"],["لَأَغۡلِبَنَّ","Surely,I will overcome"],["أَنَا۠","I"],["وَرُسُلِيٓۚ","and My Messengers"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["قَوِيٌّ","(is) All-Strong"],["عَزِيزٞ","All-Mighty"]]},{"s":92,"a":5,"en":"As for he who gives and fears Allah","w":[["فَأَمَّا","Then as for"],["مَنۡ","(him) who"],["أَعۡطَىٰ","gives"],["وَٱتَّقَىٰ","and fears"]]},{"s":62,"a":7,"en":"But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers.","w":[["وَلَا","But not"],["يَتَمَنَّوۡنَهُۥٓ","they will wish for it"],["أَبَدَۢا","ever"],["بِمَا","for what"],["قَدَّمَتۡ","(have) sent forth"],["أَيۡدِيهِمۡۚ","their hands"],["وَٱللَّهُ","And Allah"],["عَلِيمُۢ","(is) All-Knowing"],["بِٱلظَّـٰلِمِينَ","of the wrongdoers"]]},{"s":9,"a":82,"en":"So let them laugh a little and [then] weep much as recompense for what they used to earn.","w":[["فَلۡيَضۡحَكُواْ","So let them laugh"],["قَلِيلٗا","a little"],["وَلۡيَبۡكُواْ","and let them weep"],["كَثِيرٗا","much"],["جَزَآءَۢ","(as) a recompense"],["بِمَا","for what"],["كَانُواْ","they used to"],["يَكۡسِبُونَ","earn"]]},{"s":105,"a":2,"en":"Did He not make their plan into misguidance?","w":[["أَلَمۡ","Did not"],["يَجۡعَلۡ","He make"],["كَيۡدَهُمۡ","their plan"],["فِي","go"],["تَضۡلِيلٖ","astray"]]},{"s":99,"a":3,"en":"And man says, \"What is [wrong] with it?\" -","w":[["وَقَالَ","And says"],["ٱلۡإِنسَٰنُ","man"],["مَا","What"],["لَهَا","(is) with it"]]},{"s":22,"a":21,"en":"And for [striking] them are maces of iron.","w":[["وَلَهُم","And for them"],["مَّقَٰمِعُ","(are) hooked rods"],["مِنۡ","of"],["حَدِيدٖ","iron"]]},{"s":44,"a":22,"en":"And [finally] he called to his Lord that these were a criminal people.","w":[["فَدَعَا","So he called"],["رَبَّهُۥٓ","his Lord"],["أَنَّ","That"],["هَـٰٓؤُلَآءِ","these"],["قَوۡمٞ","(are) a people"],["مُّجۡرِمُونَ","criminals"]]},{"s":36,"a":24,"en":"Indeed, I would then be in manifest error.","w":[["إِنِّيٓ","Indeed,I"],["إِذٗا","then"],["لَّفِي","surely would be in"],["ضَلَٰلٖ","an error"],["مُّبِينٍ","clear"]]},{"s":26,"a":136,"en":"They said, \"It is all the same to us whether you advise or are not of the advisors.","w":[["قَالُواْ","They said"],["سَوَآءٌ","(It is) same"],["عَلَيۡنَآ","to us"],["أَوَعَظۡتَ","whether you advise"],["أَمۡ","or"],["لَمۡ","not"],["تَكُن","you are"],["مِّنَ","of"],["ٱلۡوَٰعِظِينَ","the advisors"]]},{"s":88,"a":19,"en":"And at the mountains - how they are erected?","w":[["وَإِلَى","And towards"],["ٱلۡجِبَالِ","the mountains"],["كَيۡفَ","how"],["نُصِبَتۡ","they are fixed"]]},{"s":103,"a":3,"en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","w":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلۡحَقِّ","to the truth"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلصَّبۡرِ","to [the] patience"]]},{"s":101,"a":10,"en":"And what can make you know what that is?","w":[["وَمَآ","And what"],["أَدۡرَىٰكَ","will make you know"],["مَا","what"],["هِيَهۡ","it is"]]},{"s":69,"a":24,"en":"[They will be told], \"Eat and drink in satisfaction for what you put forth in the days past.\"","w":[["كُلُواْ","Eat"],["وَٱشۡرَبُواْ","and drink"],["هَنِيٓـَٔۢا","(in) satisfaction"],["بِمَآ","for what"],["أَسۡلَفۡتُمۡ","you sent before you"],["فِي","in"],["ٱلۡأَيَّامِ","the days"],["ٱلۡخَالِيَةِ","past"]]},{"s":17,"a":49,"en":"And they say, \"When we are bones and crumbled particles, will we [truly] be resurrected as a new creation?\"","w":[["وَقَالُوٓاْ","And they say"],["أَءِذَا","Is it when"],["كُنَّا","we are"],["عِظَٰمٗا","bones"],["وَرُفَٰتًا","and crumbled particles"],["أَءِنَّا","will we"],["لَمَبۡعُوثُونَ","surely (be) resurrected"],["خَلۡقٗا","(as) a creation"],["جَدِيدٗا","new"]]},{"s":33,"a":47,"en":"And give good tidings to the believers that they will have from Allah great bounty.","w":[["وَبَشِّرِ","And give glad tidings"],["ٱلۡمُؤۡمِنِينَ","(to) the believers"],["بِأَنَّ","that"],["لَهُم","for them"],["مِّنَ","(is) from"],["ٱللَّهِ","Allah"],["فَضۡلٗا","a Bounty"],["كَبِيرٗا","great"]]},{"s":37,"a":143,"en":"And had he not been of those who exalt Allah,","w":[["فَلَوۡلَآ","And if not"],["أَنَّهُۥ","that he"],["كَانَ","was"],["مِنَ","of"],["ٱلۡمُسَبِّحِينَ","those who glorify"]]},{"s":15,"a":31,"en":"Except Iblees, he refused to be with those who prostrated.","w":[["إِلَّآ","Except"],["إِبۡلِيسَ","Iblis"],["أَبَىٰٓ","He refused"],["أَن","to"],["يَكُونَ","be"],["مَعَ","with"],["ٱلسَّـٰجِدِينَ","those who prostrated"]]},{"s":49,"a":4,"en":"Indeed, those who call you, [O Muhammad], from behind the chambers - most of them do not use reason.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["يُنَادُونَكَ","call you"],["مِن","from"],["وَرَآءِ","behind"],["ٱلۡحُجُرَٰتِ","the private chambers"],["أَكۡثَرُهُمۡ","most of them"],["لَا","(do) not"],["يَعۡقِلُونَ","understand"]]},{"s":80,"a":24,"en":"Then let mankind look at his food -","w":[["فَلۡيَنظُرِ","Then let look"],["ٱلۡإِنسَٰنُ","the man"],["إِلَىٰ","at"],["طَعَامِهِۦٓ","his food"]]}]
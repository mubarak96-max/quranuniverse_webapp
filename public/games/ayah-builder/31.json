[{"s":38,"a":1,"en":"Sad. By the Qur'an containing reminder...","w":[["صٓۚ","Saad"],["وَٱلۡقُرۡءَانِ","By the Quran"],["ذِي","full (of) reminder"],["ٱلذِّكۡرِ","full (of) reminder"]]},{"s":95,"a":6,"en":"Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.","w":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["فَلَهُمۡ","then for them"],["أَجۡرٌ","(is a) reward"],["غَيۡرُ","never"],["مَمۡنُونٖ","ending"]]},{"s":86,"a":7,"en":"Emerging from between the backbone and the ribs.","w":[["يَخۡرُجُ","Coming forth"],["مِنۢ","from"],["بَيۡنِ","between"],["ٱلصُّلۡبِ","the backbone"],["وَٱلتَّرَآئِبِ","and the ribs"]]},{"s":89,"a":26,"en":"And none will bind [as severely] as His binding [of the evildoers].","w":[["وَلَا","And not"],["يُوثِقُ","will bind"],["وَثَاقَهُۥٓ","(as) His binding"],["أَحَدٞ","anyone"]]},{"s":23,"a":89,"en":"They will say, \"[All belongs] to Allah.\" Say, \"Then how are you deluded?\"","w":[["سَيَقُولُونَ","They will say"],["لِلَّهِۚ","Allah"],["قُلۡ","Say"],["فَأَنَّىٰ","Then how"],["تُسۡحَرُونَ","are you deluded"]]},{"s":11,"a":71,"en":"And his Wife was standing, and she smiled. Then We gave her good tidings of Isaac and after Isaac, Jacob.","w":[["وَٱمۡرَأَتُهُۥ","And his wife"],["قَآئِمَةٞ","(was) standing"],["فَضَحِكَتۡ","and she laughed"],["فَبَشَّرۡنَٰهَا","Then We gave her glad tidings"],["بِإِسۡحَٰقَ","of Isaac"],["وَمِن","and after"],["وَرَآءِ","and after"],["إِسۡحَٰقَ","Isaac"],["يَعۡقُوبَ","(of) Yaqub"]]},{"s":61,"a":13,"en":"And [you will obtain] another [favor] that you love - victory from Allah and an imminent conquest; and give good tidings to the believers.","w":[["وَأُخۡرَىٰ","And another"],["تُحِبُّونَهَاۖ","that you love"],["نَصۡرٞ","a help"],["مِّنَ","from"],["ٱللَّهِ","Allah"],["وَفَتۡحٞ","and a victory"],["قَرِيبٞۗ","near"],["وَبَشِّرِ","and give glad tidings"],["ٱلۡمُؤۡمِنِينَ","(to) the believers"]]},{"s":1,"a":7,"en":"The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray.","w":[["صِرَٰطَ","(The) path"],["ٱلَّذِينَ","(of) those"],["أَنۡعَمۡتَ","You have bestowed (Your) Favors"],["عَلَيۡهِمۡ","on them"],["غَيۡرِ","not (of)"],["ٱلۡمَغۡضُوبِ","those who earned (Your) wrath"],["عَلَيۡهِمۡ","on themselves"],["وَلَا","and not"],["ٱلضَّآلِّينَ","(of) those who go astray"]]},{"s":100,"a":10,"en":"And that within the breasts is obtained,","w":[["وَحُصِّلَ","And is made apparent"],["مَا","what"],["فِي","(is) in"],["ٱلصُّدُورِ","the breasts"]]},{"s":84,"a":8,"en":"He will be judged with an easy account","w":[["فَسَوۡفَ","Then soon"],["يُحَاسَبُ","his account will be taken"],["حِسَابٗا","an account"],["يَسِيرٗا","easy"]]},{"s":70,"a":43,"en":"The Day they will emerge from the graves rapidly as if they were, toward an erected idol, hastening.","w":[["يَوۡمَ","(The) Day"],["يَخۡرُجُونَ","they will come out"],["مِنَ","from"],["ٱلۡأَجۡدَاثِ","the graves"],["سِرَاعٗا","rapidly"],["كَأَنَّهُمۡ","as if they (were)"],["إِلَىٰ","to"],["نُصُبٖ","a goal"],["يُوفِضُونَ","hastening"]]},{"s":85,"a":8,"en":"And they resented them not except because they believed in Allah, the Exalted in Might, the Praiseworthy,","w":[["وَمَا","And not"],["نَقَمُواْ","they resented"],["مِنۡهُمۡ","[of] them"],["إِلَّآ","except"],["أَن","that"],["يُؤۡمِنُواْ","they believed"],["بِٱللَّهِ","in Allah"],["ٱلۡعَزِيزِ","the All-Mighty"],["ٱلۡحَمِيدِ","the Praiseworthy"]]},{"s":65,"a":9,"en":"And it tasted the bad consequence of its affair, and the outcome of its affair was loss.","w":[["فَذَاقَتۡ","So it tasted"],["وَبَالَ","(the bad) consequence"],["أَمۡرِهَا","(of) its affair"],["وَكَانَ","and was"],["عَٰقِبَةُ","(the) end"],["أَمۡرِهَا","(of) its affair"],["خُسۡرًا","loss"]]},{"s":24,"a":10,"en":"And if not for the favor of Allah upon you and His mercy... and because Allah is Accepting of repentance and Wise.","w":[["وَلَوۡلَا","And if not"],["فَضۡلُ","(for) the Grace of Allah"],["ٱللَّهِ","(for) the Grace of Allah"],["عَلَيۡكُمۡ","upon you"],["وَرَحۡمَتُهُۥ","and His Mercy"],["وَأَنَّ","and that"],["ٱللَّهَ","Allah"],["تَوَّابٌ","(is) Oft-Returning (to Mercy)"],["حَكِيمٌ","All-Wise"]]},{"s":7,"a":182,"en":"But those who deny Our signs - We will progressively lead them [to destruction] from where they do not know.","w":[["وَٱلَّذِينَ","But those who"],["كَذَّبُواْ","denied"],["بِـَٔايَٰتِنَا","Our Signs"],["سَنَسۡتَدۡرِجُهُم","We will gradually lead them"],["مِّنۡ","from"],["حَيۡثُ","where"],["لَا","not"],["يَعۡلَمُونَ","they know"]]},{"s":8,"a":14,"en":"\"That [is yours], so taste it.\" And indeed for the disbelievers is the punishment of the Fire.","w":[["ذَٰلِكُمۡ","That"],["فَذُوقُوهُ","So taste it"],["وَأَنَّ","And that"],["لِلۡكَٰفِرِينَ","for the disbelievers"],["عَذَابَ","(is the) punishment"],["ٱلنَّارِ","(of) the Fire"]]},{"s":54,"a":26,"en":"They will know tomorrow who is the insolent liar.","w":[["سَيَعۡلَمُونَ","They will know"],["غَدٗا","tomorrow"],["مَّنِ","who"],["ٱلۡكَذَّابُ","(is) the liar"],["ٱلۡأَشِرُ","the insolent one"]]},{"s":108,"a":3,"en":"Indeed, your enemy is the one cut off.","w":[["إِنَّ","Indeed"],["شَانِئَكَ","your enemy"],["هُوَ","he (is)"],["ٱلۡأَبۡتَرُ","the one cut off"]]},{"s":73,"a":18,"en":"The heaven will break apart therefrom; ever is His promise fulfilled.","w":[["ٱلسَّمَآءُ","The heaven"],["مُنفَطِرُۢ","(will) break apart"],["بِهِۦۚ","therefrom"],["كَانَ","is"],["وَعۡدُهُۥ","His Promise"],["مَفۡعُولًا","to be fulfilled"]]},{"s":5,"a":102,"en":"A people asked such [questions] before you; then they became thereby disbelievers.","w":[["قَدۡ","Indeed"],["سَأَلَهَا","asked them"],["قَوۡمٞ","a people"],["مِّن","from"],["قَبۡلِكُمۡ","before you"],["ثُمَّ","then"],["أَصۡبَحُواْ","they became"],["بِهَا","thereby"],["كَٰفِرِينَ","disbelievers"]]},{"s":104,"a":2,"en":"Who collects wealth and [continuously] counts it.","w":[["ٱلَّذِي","The one who"],["جَمَعَ","collects"],["مَالٗا","wealth"],["وَعَدَّدَهُۥ","and counts it"]]},{"s":112,"a":1,"en":"Say, \"He is Allah, [who is] One,","w":[["قُلۡ","Say"],["هُوَ","He"],["ٱللَّهُ","(is) Allah"],["أَحَدٌ","the One"]]},{"s":12,"a":91,"en":"They said, \"By Allah, certainly has Allah preferred you over us, and indeed, we have been sinners.\"","w":[["قَالُواْ","They said"],["تَٱللَّهِ","By Allah"],["لَقَدۡ","certainly"],["ءَاثَرَكَ","Allah has preferred you"],["ٱللَّهُ","Allah has preferred you"],["عَلَيۡنَا","over us"],["وَإِن","and indeed"],["كُنَّا","we have been"],["لَخَٰطِـِٔينَ","sinners"]]},{"s":98,"a":7,"en":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["أُوْلَـٰٓئِكَ","those"],["هُمۡ","they"],["خَيۡرُ","(are the) best"],["ٱلۡبَرِيَّةِ","(of) the creatures"]]},{"s":6,"a":13,"en":"And to Him belongs that which reposes by night and by day, and He is the Hearing, the Knowing.","w":[["۞وَلَهُۥ","And for Him"],["مَا","(is) whatever"],["سَكَنَ","dwells"],["فِي","in"],["ٱلَّيۡلِ","the night"],["وَٱلنَّهَارِۚ","and the day"],["وَهُوَ","and He"],["ٱلسَّمِيعُ","(is) All-Hearing"],["ٱلۡعَلِيمُ","All-Knowing"]]},{"s":110,"a":2,"en":"And you see the people entering into the religion of Allah in multitudes,","w":[["وَرَأَيۡتَ","And you see"],["ٱلنَّاسَ","the people"],["يَدۡخُلُونَ","entering"],["فِي","into"],["دِينِ","(the) religion"],["ٱللَّهِ","(of) Allah"],["أَفۡوَاجٗا","(in) multitudes"]]},{"s":90,"a":1,"en":"I swear by this city, Makkah -","w":[["لَآ","Nay"],["أُقۡسِمُ","I swear"],["بِهَٰذَا","by this"],["ٱلۡبَلَدِ","city"]]},{"s":107,"a":2,"en":"For that is the one who drives away the orphan","w":[["فَذَٰلِكَ","Then that"],["ٱلَّذِي","(is) the one who"],["يَدُعُّ","repulses"],["ٱلۡيَتِيمَ","the orphan"]]},{"s":10,"a":82,"en":"And Allah will establish the truth by His words, even if the criminals dislike it.\"","w":[["وَيُحِقُّ","And Allah will establish"],["ٱللَّهُ","And Allah will establish"],["ٱلۡحَقَّ","the truth"],["بِكَلِمَٰتِهِۦ","by His words"],["وَلَوۡ","even if"],["كَرِهَ","dislike it"],["ٱلۡمُجۡرِمُونَ","the criminals"]]},{"s":87,"a":1,"en":"Exalt the name of your Lord, the Most High,","w":[["سَبِّحِ","Glorify"],["ٱسۡمَ","(the) name"],["رَبِّكَ","(of) your Lord"],["ٱلۡأَعۡلَى","the Most High"]]}]
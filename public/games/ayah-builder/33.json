[{"s":101,"a":4,"en":"It is the Day when people will be like moths, dispersed,","w":[["يَوۡمَ","(The) Day"],["يَكُونُ","will be"],["ٱلنَّاسُ","the mankind"],["كَٱلۡفَرَاشِ","like moths"],["ٱلۡمَبۡثُوثِ","scattered"]]},{"s":4,"a":151,"en":"Those are the disbelievers, truly. And We have prepared for the disbelievers a humiliating punishment.","w":[["أُوْلَـٰٓئِكَ","Those"],["هُمُ","they"],["ٱلۡكَٰفِرُونَ","(are) the disbelievers"],["حَقّٗاۚ","truly"],["وَأَعۡتَدۡنَا","And We have prepared"],["لِلۡكَٰفِرِينَ","for the disbelievers"],["عَذَابٗا","a punishment"],["مُّهِينٗا","humiliating"]]},{"s":67,"a":18,"en":"And already had those before them denied, and how [terrible] was My reproach.","w":[["وَلَقَدۡ","And indeed"],["كَذَّبَ","denied"],["ٱلَّذِينَ","those"],["مِن","from"],["قَبۡلِهِمۡ","before them"],["فَكَيۡفَ","and how"],["كَانَ","was"],["نَكِيرِ","My rejection"]]},{"s":106,"a":4,"en":"Who has fed them, [saving them] from hunger and made them safe, [saving them] from fear.","w":[["ٱلَّذِيٓ","The One Who"],["أَطۡعَمَهُم","feeds them"],["مِّن","[from]"],["جُوعٖ","(against) hunger"],["وَءَامَنَهُم","and gives them security"],["مِّنۡ","from"],["خَوۡفِۭ","fear"]]},{"s":92,"a":18,"en":"[He] who gives [from] his wealth to purify himself","w":[["ٱلَّذِي","The one who"],["يُؤۡتِي","gives"],["مَالَهُۥ","his wealth"],["يَتَزَكَّىٰ","(to) purify himself"]]},{"s":40,"a":81,"en":"And He shows you His signs. So which of the signs of Allah do you deny?","w":[["وَيُرِيكُمۡ","And He shows you"],["ءَايَٰتِهِۦ","His Signs"],["فَأَيَّ","Then which"],["ءَايَٰتِ","(of the) Signs"],["ٱللَّهِ","(of) Allah"],["تُنكِرُونَ","will you deny"]]},{"s":82,"a":14,"en":"And indeed, the wicked will be in Hellfire.","w":[["وَإِنَّ","And indeed"],["ٱلۡفُجَّارَ","the wicked"],["لَفِي","(will be) surely in"],["جَحِيمٖ","Hellfire"]]},{"s":43,"a":5,"en":"Then should We turn the message away, disregarding you, because you are a transgressing people?","w":[["أَفَنَضۡرِبُ","Then should We take away"],["عَنكُمُ","from you"],["ٱلذِّكۡرَ","the Reminder"],["صَفۡحًا","disregarding (you)"],["أَن","because"],["كُنتُمۡ","you are"],["قَوۡمٗا","a people"],["مُّسۡرِفِينَ","transgressing"]]},{"s":33,"a":11,"en":"There the believers were tested and shaken with a severe shaking.","w":[["هُنَالِكَ","There"],["ٱبۡتُلِيَ","were tried"],["ٱلۡمُؤۡمِنُونَ","the believers"],["وَزُلۡزِلُواْ","and shaken"],["زِلۡزَالٗا","(with a) shake"],["شَدِيدٗا","severe"]]},{"s":22,"a":74,"en":"They have not appraised Allah with true appraisal. Indeed, Allah is Powerful and Exalted in Might.","w":[["مَا","Not"],["قَدَرُواْ","they (have) estimated"],["ٱللَّهَ","Allah"],["حَقَّ","(with) due"],["قَدۡرِهِۦٓۚ","[His] estimation"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["لَقَوِيٌّ","(is) surely All-Strong"],["عَزِيزٌ","All-Mighty"]]},{"s":61,"a":13,"en":"And [you will obtain] another [favor] that you love - victory from Allah and an imminent conquest; and give good tidings to the believers.","w":[["وَأُخۡرَىٰ","And another"],["تُحِبُّونَهَاۖ","that you love"],["نَصۡرٞ","a help"],["مِّنَ","from"],["ٱللَّهِ","Allah"],["وَفَتۡحٞ","and a victory"],["قَرِيبٞۗ","near"],["وَبَشِّرِ","and give glad tidings"],["ٱلۡمُؤۡمِنِينَ","(to) the believers"]]},{"s":54,"a":12,"en":"And caused the earth to burst with springs, and the waters met for a matter already predestined.","w":[["وَفَجَّرۡنَا","And We caused to burst"],["ٱلۡأَرۡضَ","the earth"],["عُيُونٗا","(with) springs"],["فَٱلۡتَقَى","so met"],["ٱلۡمَآءُ","the water (s)"],["عَلَىٰٓ","for"],["أَمۡرٖ","a matter"],["قَدۡ","already"],["قُدِرَ","predestined"]]},{"s":7,"a":183,"en":"And I will give them time. Indeed, my plan is firm.","w":[["وَأُمۡلِي","And I will give respite"],["لَهُمۡۚ","to them"],["إِنَّ","Indeed"],["كَيۡدِي","My plan"],["مَتِينٌ","(is) firm"]]},{"s":17,"a":10,"en":"And that those who do not believe in the Hereafter - We have prepared for them a painful punishment.","w":[["وَأَنَّ","And that"],["ٱلَّذِينَ","those who"],["لَا","(do) not"],["يُؤۡمِنُونَ","believe"],["بِٱلۡأٓخِرَةِ","in the Hereafter"],["أَعۡتَدۡنَا","We have prepared"],["لَهُمۡ","for them"],["عَذَابًا","a punishment"],["أَلِيمٗا","painful"]]},{"s":70,"a":3,"en":"[It is] from Allah, owner of the ways of ascent.","w":[["مِّنَ","From"],["ٱللَّهِ","Allah"],["ذِي","Owner"],["ٱلۡمَعَارِجِ","(of) the ways of ascent"]]},{"s":74,"a":53,"en":"No! But they do not fear the Hereafter.","w":[["كَلَّاۖ","Nay"],["بَل","But"],["لَّا","not"],["يَخَافُونَ","they fear"],["ٱلۡأٓخِرَةَ","the Hereafter"]]},{"s":97,"a":4,"en":"The angels and the Spirit descend therein by permission of their Lord for every matter.","w":[["تَنَزَّلُ","Descend"],["ٱلۡمَلَـٰٓئِكَةُ","the Angels"],["وَٱلرُّوحُ","and the Spirit"],["فِيهَا","therein"],["بِإِذۡنِ","by (the) permission"],["رَبِّهِم","(of) their Lord"],["مِّن","for"],["كُلِّ","every"],["أَمۡرٖ","affair"]]},{"s":98,"a":7,"en":"Indeed, they who have believed and done righteous deeds - those are the best of creatures.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["أُوْلَـٰٓئِكَ","those"],["هُمۡ","they"],["خَيۡرُ","(are the) best"],["ٱلۡبَرِيَّةِ","(of) the creatures"]]},{"s":58,"a":21,"en":"Allah has written, \"I will surely overcome, I and My messengers.\" Indeed, Allah is Powerful and Exalted in Might.","w":[["كَتَبَ","Allah has decreed"],["ٱللَّهُ","Allah has decreed"],["لَأَغۡلِبَنَّ","Surely,I will overcome"],["أَنَا۠","I"],["وَرُسُلِيٓۚ","and My Messengers"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["قَوِيٌّ","(is) All-Strong"],["عَزِيزٞ","All-Mighty"]]},{"s":24,"a":42,"en":"And to Allah belongs the dominion of the heavens and the earth, and to Allah is the destination.","w":[["وَلِلَّهِ","And to Allah (belongs)"],["مُلۡكُ","(the) dominion"],["ٱلسَّمَٰوَٰتِ","(of) the heavens"],["وَٱلۡأَرۡضِۖ","and the earth"],["وَإِلَى","And to"],["ٱللَّهِ","Allah"],["ٱلۡمَصِيرُ","(is) the destination"]]},{"s":95,"a":7,"en":"So what yet causes you to deny the Recompense?","w":[["فَمَا","Then what"],["يُكَذِّبُكَ","causes you to deny"],["بَعۡدُ","after (this)"],["بِٱلدِّينِ","the judgment"]]},{"s":107,"a":5,"en":"[But] who are heedless of their prayer -","w":[["ٱلَّذِينَ","Those who"],["هُمۡ","[they]"],["عَن","about"],["صَلَاتِهِمۡ","their prayers"],["سَاهُونَ","(are) neglectful"]]},{"s":11,"a":21,"en":"Those are the ones who will have lost themselves, and lost from them is what they used to invent.","w":[["أُوْلَـٰٓئِكَ","Those"],["ٱلَّذِينَ","(are) the ones who"],["خَسِرُوٓاْ","(have) lost"],["أَنفُسَهُمۡ","their souls"],["وَضَلَّ","and lost"],["عَنۡهُم","from them"],["مَّا","(is) what"],["كَانُواْ","they used"],["يَفۡتَرُونَ","(to) invent"]]},{"s":91,"a":9,"en":"He has succeeded who purifies it,","w":[["قَدۡ","Indeed"],["أَفۡلَحَ","he succeeds"],["مَن","who"],["زَكَّىٰهَا","purifies it"]]},{"s":25,"a":50,"en":"And We have certainly distributed it among them that they might be reminded, but most of the people refuse except disbelief.","w":[["وَلَقَدۡ","And verily"],["صَرَّفۡنَٰهُ","We have distributed it"],["بَيۡنَهُمۡ","among them"],["لِيَذَّكَّرُواْ","that they may remember"],["فَأَبَىٰٓ","but refuse"],["أَكۡثَرُ","most"],["ٱلنَّاسِ","(of) the people"],["إِلَّا","except"],["كُفُورٗا","disbelief"]]},{"s":105,"a":3,"en":"And He sent against them birds in flocks,","w":[["وَأَرۡسَلَ","And He sent"],["عَلَيۡهِمۡ","against them"],["طَيۡرًا","birds"],["أَبَابِيلَ","(in) flocks"]]},{"s":109,"a":6,"en":"For you is your religion, and for me is my religion.\"","w":[["لَكُمۡ","For you"],["دِينُكُمۡ","(is) your religion"],["وَلِيَ","and for me"],["دِينِ","(is) my religion"]]},{"s":102,"a":8,"en":"Then you will surely be asked that Day about pleasure.","w":[["ثُمَّ","Then"],["لَتُسۡـَٔلُنَّ","surely you will be asked"],["يَوۡمَئِذٍ","that Day"],["عَنِ","about"],["ٱلنَّعِيمِ","the pleasures"]]},{"s":52,"a":40,"en":"Or do you, [O Muhammad], ask of them a payment, so they are by debt burdened down?","w":[["أَمۡ","Or"],["تَسۡـَٔلُهُمۡ","(do) you ask from them"],["أَجۡرٗا","a payment"],["فَهُم","so they"],["مِّن","from"],["مَّغۡرَمٖ","a debt"],["مُّثۡقَلُونَ","(are) overburdened"]]},{"s":72,"a":8,"en":"And we have sought [to reach] the heaven but found it filled with powerful guards and burning flames.","w":[["وَأَنَّا","And that we"],["لَمَسۡنَا","sought to touch"],["ٱلسَّمَآءَ","the heaven"],["فَوَجَدۡنَٰهَا","but we found it"],["مُلِئَتۡ","filled (with)"],["حَرَسٗا","guards"],["شَدِيدٗا","severe"],["وَشُهُبٗا","and flaming fires"]]}]
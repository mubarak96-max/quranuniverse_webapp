[{"s":42,"a":41,"en":"And whoever avenges himself after having been wronged - those have not upon them any cause [for blame].","w":[["وَلَمَنِ","And surely whosoever"],["ٱنتَصَرَ","defends himself"],["بَعۡدَ","after"],["ظُلۡمِهِۦ","he has been wronged"],["فَأُوْلَـٰٓئِكَ","then those"],["مَا","not"],["عَلَيۡهِم","(is) against them"],["مِّن","any"],["سَبِيلٍ","way"]]},{"s":2,"a":157,"en":"Those are the ones upon whom are blessings from their Lord and mercy. And it is those who are the [rightly] guided.","w":[["أُوْلَـٰٓئِكَ","Those"],["عَلَيۡهِمۡ","on them"],["صَلَوَٰتٞ","(are) blessings"],["مِّن","from"],["رَّبِّهِمۡ","their Lord"],["وَرَحۡمَةٞۖ","and Mercy"],["وَأُوْلَـٰٓئِكَ","And those"],["هُمُ","[they]"],["ٱلۡمُهۡتَدُونَ","(are) the guided ones"]]},{"s":112,"a":1,"en":"Say, \"He is Allah, [who is] One,","w":[["قُلۡ","Say"],["هُوَ","He"],["ٱللَّهُ","(is) Allah"],["أَحَدٌ","the One"]]},{"s":86,"a":5,"en":"So let man observe from what he was created.","w":[["فَلۡيَنظُرِ","So let see"],["ٱلۡإِنسَٰنُ","man"],["مِمَّ","from what"],["خُلِقَ","he is created"]]},{"s":71,"a":18,"en":"Then He will return you into it and extract you [another] extraction.","w":[["ثُمَّ","Then"],["يُعِيدُكُمۡ","He will return you"],["فِيهَا","into it"],["وَيُخۡرِجُكُمۡ","and bring you forth"],["إِخۡرَاجٗا","(a new) bringing forth"]]},{"s":12,"a":1,"en":"Alif, Lam, Ra. These are the verses of the clear Book.","w":[["الٓرۚ","Alif Laam Ra"],["تِلۡكَ","These"],["ءَايَٰتُ","(are the) Verses"],["ٱلۡكِتَٰبِ","(of) the Book"],["ٱلۡمُبِينِ","[the] clear"]]},{"s":73,"a":3,"en":"Half of it - or subtract from it a little","w":[["نِّصۡفَهُۥٓ","Half of it"],["أَوِ","or"],["ٱنقُصۡ","lessen"],["مِنۡهُ","from it"],["قَلِيلًا","a little"]]},{"s":111,"a":5,"en":"Around her neck is a rope of [twisted] fiber.","w":[["فِي","In"],["جِيدِهَا","her neck"],["حَبۡلٞ","(will be) a rope"],["مِّن","of"],["مَّسَدِۭ","palm-fiber"]]},{"s":38,"a":88,"en":"And you will surely know [the truth of] its information after a time.\"","w":[["وَلَتَعۡلَمُنَّ","And surely you will know"],["نَبَأَهُۥ","its information"],["بَعۡدَ","after"],["حِينِۭ","a time"]]},{"s":77,"a":48,"en":"And when it is said to them, \"Bow [in prayer],\" they do not bow.","w":[["وَإِذَا","And when"],["قِيلَ","it is said"],["لَهُمُ","to them"],["ٱرۡكَعُواْ","Bow"],["لَا","not"],["يَرۡكَعُونَ","they bow"]]},{"s":3,"a":141,"en":"And that Allah may purify the believers [through trials] and destroy the disbelievers.","w":[["وَلِيُمَحِّصَ","And so that may purify"],["ٱللَّهُ","Allah"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَيَمۡحَقَ","and destroy"],["ٱلۡكَٰفِرِينَ","the disbelievers"]]},{"s":39,"a":62,"en":"Allah is the Creator of all things, and He is, over all things, Disposer of affairs.","w":[["ٱللَّهُ","Allah"],["خَٰلِقُ","(is the) Creator"],["كُلِّ","(of) all"],["شَيۡءٖۖ","things"],["وَهُوَ","and He"],["عَلَىٰ","(is) over"],["كُلِّ","all"],["شَيۡءٖ","things"],["وَكِيلٞ","a Guardian"]]},{"s":78,"a":30,"en":"\"So taste [the penalty], and never will We increase you except in torment.\"","w":[["فَذُوقُواْ","So taste"],["فَلَن","and never"],["نَّزِيدَكُمۡ","We will increase you"],["إِلَّا","except"],["عَذَابًا","(in) punishment"]]},{"s":96,"a":19,"en":"No! Do not obey him. But prostrate and draw near [to Allah].","w":[["كَلَّا","Nay"],["لَا","(Do) not"],["تُطِعۡهُ","obey him"],["وَٱسۡجُدۡۤ","But prostrate"],["وَٱقۡتَرِب۩","and draw near (to Allah)"]]},{"s":10,"a":86,"en":"And save us by Your mercy from the disbelieving people.\"","w":[["وَنَجِّنَا","And save us"],["بِرَحۡمَتِكَ","by Your Mercy"],["مِنَ","from"],["ٱلۡقَوۡمِ","the people"],["ٱلۡكَٰفِرِينَ","the disbelievers"]]},{"s":76,"a":4,"en":"Indeed, We have prepared for the disbelievers chains and shackles and a blaze.","w":[["إِنَّآ","Indeed,We"],["أَعۡتَدۡنَا","[We] have prepared"],["لِلۡكَٰفِرِينَ","for the disbelievers"],["سَلَٰسِلَاْ","chains"],["وَأَغۡلَٰلٗا","and shackles"],["وَسَعِيرًا","and a Blazing Fire"]]},{"s":100,"a":6,"en":"Indeed mankind, to his Lord, is ungrateful.","w":[["إِنَّ","Indeed"],["ٱلۡإِنسَٰنَ","mankind"],["لِرَبِّهِۦ","to his Lord"],["لَكَنُودٞ","(is) surely ungrateful"]]},{"s":18,"a":67,"en":"He said, \"Indeed, with me you will never be able to have patience.","w":[["قَالَ","He said"],["إِنَّكَ","Indeed,you"],["لَن","never"],["تَسۡتَطِيعَ","will be able"],["مَعِيَ","with me"],["صَبۡرٗا","(to have) patience"]]},{"s":6,"a":67,"en":"For every happening is a finality; and you are going to know.","w":[["لِّكُلِّ","For every"],["نَبَإٖ","news"],["مُّسۡتَقَرّٞۚ","(is) a fixed time"],["وَسَوۡفَ","and soon"],["تَعۡلَمُونَ","you will know"]]},{"s":31,"a":9,"en":"Wherein they abide eternally; [it is] the promise of Allah [which is] truth. And He is the Exalted in Might, the Wise.","w":[["خَٰلِدِينَ","(To) abide forever"],["فِيهَاۖ","in it"],["وَعۡدَ","(The) Promise of Allah"],["ٱللَّهِ","(The) Promise of Allah"],["حَقّٗاۚ","(is) true"],["وَهُوَ","And He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":79,"a":12,"en":"They say, \"That, then, would be a losing return.\"","w":[["قَالُواْ","They say"],["تِلۡكَ","This"],["إِذٗا","then"],["كَرَّةٌ","(would be) a return"],["خَاسِرَةٞ","losing"]]},{"s":28,"a":52,"en":"Those to whom We gave the Scripture before it - they are believers in it.","w":[["ٱلَّذِينَ","Those who"],["ءَاتَيۡنَٰهُمُ","We gave them"],["ٱلۡكِتَٰبَ","the Scripture"],["مِن","before it"],["قَبۡلِهِۦ","before it"],["هُم","they"],["بِهِۦ","in it"],["يُؤۡمِنُونَ","believe"]]},{"s":16,"a":4,"en":"He created man from a sperm-drop; then at once, he is a clear adversary.","w":[["خَلَقَ","He created"],["ٱلۡإِنسَٰنَ","the human kind"],["مِن","from"],["نُّطۡفَةٖ","a minute quantity of semen"],["فَإِذَا","then behold"],["هُوَ","he"],["خَصِيمٞ","(is) an opponent"],["مُّبِينٞ","clear"]]},{"s":94,"a":1,"en":"Did We not expand for you, [O Muhammad], your breast?","w":[["أَلَمۡ","Have not"],["نَشۡرَحۡ","We expanded"],["لَكَ","for you"],["صَدۡرَكَ","your breast"]]},{"s":83,"a":25,"en":"They will be given to drink [pure] wine [which was] sealed.","w":[["يُسۡقَوۡنَ","They will be given to drink"],["مِن","of"],["رَّحِيقٖ","a pure wine"],["مَّخۡتُومٍ","sealed"]]},{"s":110,"a":1,"en":"When the victory of Allah has come and the conquest,","w":[["إِذَا","When"],["جَآءَ","comes"],["نَصۡرُ","(the) Help"],["ٱللَّهِ","(of) Allah"],["وَٱلۡفَتۡحُ","and the Victory"]]},{"s":113,"a":5,"en":"And from the evil of an envier when he envies.\"","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["حَاسِدٍ","(of) an envier"],["إِذَا","when"],["حَسَدَ","he envies"]]},{"s":99,"a":3,"en":"And man says, \"What is [wrong] with it?\" -","w":[["وَقَالَ","And says"],["ٱلۡإِنسَٰنُ","man"],["مَا","What"],["لَهَا","(is) with it"]]},{"s":9,"a":82,"en":"So let them laugh a little and [then] weep much as recompense for what they used to earn.","w":[["فَلۡيَضۡحَكُواْ","So let them laugh"],["قَلِيلٗا","a little"],["وَلۡيَبۡكُواْ","and let them weep"],["كَثِيرٗا","much"],["جَزَآءَۢ","(as) a recompense"],["بِمَا","for what"],["كَانُواْ","they used to"],["يَكۡسِبُونَ","earn"]]},{"s":75,"a":39,"en":"And made of him two mates, the male and the female.","w":[["فَجَعَلَ","Then made"],["مِنۡهُ","of him"],["ٱلزَّوۡجَيۡنِ","two kinds"],["ٱلذَّكَرَ","(the) male"],["وَٱلۡأُنثَىٰٓ","and the female"]]}]
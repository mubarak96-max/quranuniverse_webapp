[{"s":81,"a":19,"en":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","w":[["إِنَّهُۥ","Indeed,it"],["لَقَوۡلُ","(is) surely a word"],["رَسُولٖ","(of) a Messenger"],["كَرِيمٖ","noble"]]},{"s":23,"a":3,"en":"And they who turn away from ill speech","w":[["وَٱلَّذِينَ","Those who"],["هُمۡ","[they]"],["عَنِ","from"],["ٱللَّغۡوِ","the vain talk"],["مُعۡرِضُونَ","turn away"]]},{"s":15,"a":80,"en":"And certainly did the companions of Thamud deny the messengers.","w":[["وَلَقَدۡ","And certainly"],["كَذَّبَ","denied"],["أَصۡحَٰبُ","(the) companions"],["ٱلۡحِجۡرِ","(of) the Rocky Tract"],["ٱلۡمُرۡسَلِينَ","the Messengers"]]},{"s":26,"a":16,"en":"Go to Pharaoh and say, 'We are the messengers of the Lord of the worlds,","w":[["فَأۡتِيَا","So go both of you"],["فِرۡعَوۡنَ","(to) Firaun"],["فَقُولَآ","and say"],["إِنَّا","'Indeed,we"],["رَسُولُ","(are the) Messenger"],["رَبِّ","(of the) Lord"],["ٱلۡعَٰلَمِينَ","(of) the worlds"]]},{"s":37,"a":27,"en":"And they will approach one another blaming each other.","w":[["وَأَقۡبَلَ","And will approach"],["بَعۡضُهُمۡ","some of them"],["عَلَىٰ","to"],["بَعۡضٖ","others"],["يَتَسَآءَلُونَ","questioning one another"]]},{"s":19,"a":71,"en":"And there is none of you except he will come to it. This is upon your Lord an inevitability decreed.","w":[["وَإِن","And (there is) not"],["مِّنكُمۡ","(any) of you"],["إِلَّا","but"],["وَارِدُهَاۚ","(will be) passing over it"],["كَانَ","(This) is"],["عَلَىٰ","upon"],["رَبِّكَ","your Lord"],["حَتۡمٗا","an inevitability"],["مَّقۡضِيّٗا","decreed"]]},{"s":14,"a":16,"en":"Before him is Hell, and he will be given a drink of purulent water.","w":[["مِّن","of him"],["وَرَآئِهِۦ","Ahead"],["جَهَنَّمُ","(is) Hell"],["وَيُسۡقَىٰ","and he will be made to drink"],["مِن","of"],["مَّآءٖ","water"],["صَدِيدٖ","purulent"]]},{"s":44,"a":48,"en":"Then pour over his head from the torment of scalding water.\"","w":[["ثُمَّ","Then"],["صُبُّواْ","pour"],["فَوۡقَ","over"],["رَأۡسِهِۦ","his head"],["مِنۡ","of"],["عَذَابِ","(the) punishment"],["ٱلۡحَمِيمِ","(of) the scalding water"]]},{"s":13,"a":9,"en":"[He is] Knower of the unseen and the witnessed, the Grand, the Exalted.","w":[["عَٰلِمُ","Knower"],["ٱلۡغَيۡبِ","(of) the unseen"],["وَٱلشَّهَٰدَةِ","and the witnessed"],["ٱلۡكَبِيرُ","the Most Great"],["ٱلۡمُتَعَالِ","the Most High"]]},{"s":35,"a":16,"en":"If He wills, He can do away with you and bring forth a new creation.","w":[["إِن","If"],["يَشَأۡ","He wills"],["يُذۡهِبۡكُمۡ","He (can) do away with you"],["وَيَأۡتِ","and bring"],["بِخَلۡقٖ","in a creation"],["جَدِيدٖ","new"]]},{"s":56,"a":86,"en":"Then why do you not, if you are not to be recompensed,","w":[["فَلَوۡلَآ","Then why not"],["إِن","if"],["كُنتُمۡ","you are"],["غَيۡرَ","not"],["مَدِينِينَ","to be recompensed"]]},{"s":64,"a":13,"en":"Allah - there is no deity except Him. And upon Allah let the believers rely.","w":[["ٱللَّهُ","Allah"],["لَآ","(there is) no"],["إِلَٰهَ","god"],["إِلَّا","except"],["هُوَۚ","Him"],["وَعَلَى","And upon"],["ٱللَّهِ","Allah"],["فَلۡيَتَوَكَّلِ","let put (their) trust"],["ٱلۡمُؤۡمِنُونَ","the believers"]]},{"s":114,"a":1,"en":"Say, \"I seek refuge in the Lord of mankind,","w":[["قُلۡ","Say"],["أَعُوذُ","I seek refuge"],["بِرَبِّ","in (the) Lord"],["ٱلنَّاسِ","(of) mankind"]]},{"s":62,"a":7,"en":"But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers.","w":[["وَلَا","But not"],["يَتَمَنَّوۡنَهُۥٓ","they will wish for it"],["أَبَدَۢا","ever"],["بِمَا","for what"],["قَدَّمَتۡ","(have) sent forth"],["أَيۡدِيهِمۡۚ","their hands"],["وَٱللَّهُ","And Allah"],["عَلِيمُۢ","(is) All-Knowing"],["بِٱلظَّـٰلِمِينَ","of the wrongdoers"]]},{"s":45,"a":36,"en":"Then, to Allah belongs [all] praise - Lord of the heavens and Lord of the earth, Lord of the worlds.","w":[["فَلِلَّهِ","Then for Allah"],["ٱلۡحَمۡدُ","(is) all the praise"],["رَبِّ","(the) Lord"],["ٱلسَّمَٰوَٰتِ","(of) the heavens"],["وَرَبِّ","and (the) Lord"],["ٱلۡأَرۡضِ","(of) the earth"],["رَبِّ","(the) lord"],["ٱلۡعَٰلَمِينَ","(of) the worlds"]]},{"s":48,"a":13,"en":"And whoever has not believed in Allah and His Messenger - then indeed, We have prepared for the disbelievers a Blaze.","w":[["وَمَن","And whoever"],["لَّمۡ","(has) not believed"],["يُؤۡمِنۢ","(has) not believed"],["بِٱللَّهِ","in Allah"],["وَرَسُولِهِۦ","and His Messenger"],["فَإِنَّآ","then indeed,We"],["أَعۡتَدۡنَا","[We] have prepared"],["لِلۡكَٰفِرِينَ","for the disbelievers"],["سَعِيرٗا","a Blazing Fire"]]},{"s":8,"a":14,"en":"\"That [is yours], so taste it.\" And indeed for the disbelievers is the punishment of the Fire.","w":[["ذَٰلِكُمۡ","That"],["فَذُوقُوهُ","So taste it"],["وَأَنَّ","And that"],["لِلۡكَٰفِرِينَ","for the disbelievers"],["عَذَابَ","(is the) punishment"],["ٱلنَّارِ","(of) the Fire"]]},{"s":68,"a":14,"en":"Because he is a possessor of wealth and children,","w":[["أَن","Because"],["كَانَ","(he) is"],["ذَا","a possessor"],["مَالٖ","(of) wealth"],["وَبَنِينَ","and children"]]},{"s":65,"a":9,"en":"And it tasted the bad consequence of its affair, and the outcome of its affair was loss.","w":[["فَذَاقَتۡ","So it tasted"],["وَبَالَ","(the bad) consequence"],["أَمۡرِهَا","(of) its affair"],["وَكَانَ","and was"],["عَٰقِبَةُ","(the) end"],["أَمۡرِهَا","(of) its affair"],["خُسۡرًا","loss"]]},{"s":87,"a":13,"en":"Neither dying therein nor living.","w":[["ثُمَّ","Then"],["لَا","not"],["يَمُوتُ","he will die"],["فِيهَا","therein"],["وَلَا","and not"],["يَحۡيَىٰ","will live"]]},{"s":21,"a":67,"en":"Uff to you and to what you worship instead of Allah. Then will you not use reason?\"","w":[["أُفّٖ","Uff"],["لَّكُمۡ","to you"],["وَلِمَا","and to what"],["تَعۡبُدُونَ","you worship"],["مِن","besides"],["دُونِ","besides"],["ٱللَّهِۚ","Allah"],["أَفَلَا","Then will not"],["تَعۡقِلُونَ","you use reason"]]},{"s":27,"a":77,"en":"And indeed, it is guidance and mercy for the believers.","w":[["وَإِنَّهُۥ","And indeed,it"],["لَهُدٗى","(is) surely a guidance"],["وَرَحۡمَةٞ","and a mercy"],["لِّلۡمُؤۡمِنِينَ","for the believers"]]},{"s":80,"a":40,"en":"And [other] faces, that Day, will have upon them dust.","w":[["وَوُجُوهٞ","And faces"],["يَوۡمَئِذٍ","that Day"],["عَلَيۡهَا","upon them"],["غَبَرَةٞ","(will be) dust"]]},{"s":57,"a":3,"en":"He is the First and the Last, the Ascendant and the Intimate, and He is, of all things, Knowing.","w":[["هُوَ","He"],["ٱلۡأَوَّلُ","(is) the First"],["وَٱلۡأٓخِرُ","and the Last"],["وَٱلظَّـٰهِرُ","and the Apparent"],["وَٱلۡبَاطِنُۖ","and the Unapparent"],["وَهُوَ","and He"],["بِكُلِّ","(is) of every"],["شَيۡءٍ","thing"],["عَلِيمٌ","All-Knower"]]},{"s":53,"a":58,"en":"Of it, [from those] besides Allah, there is no remover.","w":[["لَيۡسَ","Not is"],["لَهَا","for it"],["مِن","besides"],["دُونِ","besides"],["ٱللَّهِ","Allah"],["كَاشِفَةٌ","any remover"]]},{"s":84,"a":20,"en":"So what is [the matter] with them [that] they do not believe,","w":[["فَمَا","So what"],["لَهُمۡ","(is) for them"],["لَا","not"],["يُؤۡمِنُونَ","they believe"]]},{"s":69,"a":5,"en":"So as for Thamud, they were destroyed by the overpowering [blast].","w":[["فَأَمَّا","So as for"],["ثَمُودُ","Thamud"],["فَأُهۡلِكُواْ","they were destroyed"],["بِٱلطَّاغِيَةِ","by the overpowering (blast)"]]},{"s":49,"a":4,"en":"Indeed, those who call you, [O Muhammad], from behind the chambers - most of them do not use reason.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["يُنَادُونَكَ","call you"],["مِن","from"],["وَرَآءِ","behind"],["ٱلۡحُجُرَٰتِ","the private chambers"],["أَكۡثَرُهُمۡ","most of them"],["لَا","(do) not"],["يَعۡقِلُونَ","understand"]]},{"s":90,"a":19,"en":"But they who disbelieved in Our signs - those are the companions of the left.","w":[["وَٱلَّذِينَ","But those who"],["كَفَرُواْ","disbelieve"],["بِـَٔايَٰتِنَا","in Our Verses"],["هُمۡ","they"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡمَشۡـَٔمَةِ","(of) the left (hand)"]]},{"s":29,"a":30,"en":"He said, \"My Lord, support me against the corrupting people.\"","w":[["قَالَ","He said"],["رَبِّ","My Lord"],["ٱنصُرۡنِي","Help me"],["عَلَى","against"],["ٱلۡقَوۡمِ","the people"],["ٱلۡمُفۡسِدِينَ","the corrupters"]]}]
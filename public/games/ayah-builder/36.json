[{"s":103,"a":3,"en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","w":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلۡحَقِّ","to the truth"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلصَّبۡرِ","to [the] patience"]]},{"s":5,"a":10,"en":"But those who disbelieve and deny Our signs - those are the companions of Hellfire.","w":[["وَٱلَّذِينَ","And those who"],["كَفَرُواْ","disbelieve"],["وَكَذَّبُواْ","and deny"],["بِـَٔايَٰتِنَآ","Our Signs"],["أُوْلَـٰٓئِكَ","those"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡجَحِيمِ","(of) the Hellfire"]]},{"s":47,"a":1,"en":"Those who disbelieve and avert [people] from the way of Allah - He will waste their deeds.","w":[["ٱلَّذِينَ","Those who"],["كَفَرُواْ","disbelieve"],["وَصَدُّواْ","and turn away"],["عَن","from"],["سَبِيلِ","(the) way of Allah"],["ٱللَّهِ","(the) way of Allah"],["أَضَلَّ","He will cause to be lost"],["أَعۡمَٰلَهُمۡ","their deeds"]]},{"s":20,"a":4,"en":"A revelation from He who created the earth and highest heavens,","w":[["تَنزِيلٗا","A revelation"],["مِّمَّنۡ","from (He) Who"],["خَلَقَ","created"],["ٱلۡأَرۡضَ","the earth"],["وَٱلسَّمَٰوَٰتِ","and the heavens"],["ٱلۡعُلَى","[the] high"]]},{"s":32,"a":30,"en":"So turn away from them and wait. Indeed, they are waiting.","w":[["فَأَعۡرِضۡ","So turn away"],["عَنۡهُمۡ","from them"],["وَٱنتَظِرۡ","and wait"],["إِنَّهُم","Indeed,they"],["مُّنتَظِرُونَ","(are) waiting"]]},{"s":41,"a":13,"en":"But if they turn away, then say, \"I have warned you of a thunderbolt like the thunderbolt [that struck] 'Aad and Thamud.","w":[["فَإِنۡ","But if"],["أَعۡرَضُواْ","they turn away"],["فَقُلۡ","then say"],["أَنذَرۡتُكُمۡ","I have warned you"],["صَٰعِقَةٗ","(of) a thunderbolt"],["مِّثۡلَ","like"],["صَٰعِقَةِ","(the) thunderbolt"],["عَادٖ","(of) Aad"],["وَثَمُودَ","and Thamud"]]},{"s":51,"a":31,"en":"[Abraham] said, \"Then what is your business [here], O messengers?\"","w":[["۞قَالَ","He said"],["فَمَا","Then what"],["خَطۡبُكُمۡ","(is) your mission"],["أَيُّهَا","O messengers"],["ٱلۡمُرۡسَلُونَ","O messengers"]]},{"s":55,"a":55,"en":"So which of the favors of your Lord would you deny?","w":[["فَبِأَيِّ","So which"],["ءَالَآءِ","(of the) favors"],["رَبِّكُمَا","(of) your Lord"],["تُكَذِّبَانِ","will you both deny"]]},{"s":1,"a":5,"en":"It is You we worship and You we ask for help.","w":[["إِيَّاكَ","You Alone"],["نَعۡبُدُ","we worship"],["وَإِيَّاكَ","and You Alone"],["نَسۡتَعِينُ","we ask for help"]]},{"s":108,"a":3,"en":"Indeed, your enemy is the one cut off.","w":[["إِنَّ","Indeed"],["شَانِئَكَ","your enemy"],["هُوَ","he (is)"],["ٱلۡأَبۡتَرُ","the one cut off"]]},{"s":104,"a":2,"en":"Who collects wealth and [continuously] counts it.","w":[["ٱلَّذِي","The one who"],["جَمَعَ","collects"],["مَالٗا","wealth"],["وَعَدَّدَهُۥ","and counts it"]]},{"s":93,"a":4,"en":"And the Hereafter is better for you than the first [life].","w":[["وَلَلۡأٓخِرَةُ","And surely the Hereafter"],["خَيۡرٞ","(is) better"],["لَّكَ","for you"],["مِنَ","than"],["ٱلۡأُولَىٰ","the first"]]},{"s":30,"a":17,"en":"So exalted is Allah when you reach the evening and when you reach the morning.","w":[["فَسُبۡحَٰنَ","So glory be to"],["ٱللَّهِ","Allah"],["حِينَ","when"],["تُمۡسُونَ","you reach the evening"],["وَحِينَ","and when"],["تُصۡبِحُونَ","you reach the morning"]]},{"s":88,"a":26,"en":"Then indeed, upon Us is their account.","w":[["ثُمَّ","Then"],["إِنَّ","indeed"],["عَلَيۡنَا","upon Us"],["حِسَابَهُم","(is) their account"]]},{"s":36,"a":26,"en":"It was said, \"Enter Paradise.\" He said, \"I wish my people could know","w":[["قِيلَ","It was said"],["ٱدۡخُلِ","Enter"],["ٱلۡجَنَّةَۖ","Paradise"],["قَالَ","He said"],["يَٰلَيۡتَ","I wish"],["قَوۡمِي","my people"],["يَعۡلَمُونَ","knew"]]},{"s":34,"a":48,"en":"Say, \"Indeed, my Lord projects the truth. Knower of the unseen.\"","w":[["قُلۡ","Say"],["إِنَّ","Indeed"],["رَبِّي","my Lord"],["يَقۡذِفُ","projects"],["بِٱلۡحَقِّ","the truth"],["عَلَّـٰمُ","(the) All-Knower"],["ٱلۡغُيُوبِ","(of) the unseen"]]},{"s":89,"a":23,"en":"And brought [within view], that Day, is Hell - that Day, man will remember, but what good to him will be the remembrance?","w":[["وَجِاْيٓءَ","And is brought"],["يَوۡمَئِذِۭ","that Day"],["بِجَهَنَّمَۚ","Hell"],["يَوۡمَئِذٖ","That Day"],["يَتَذَكَّرُ","will remember"],["ٱلۡإِنسَٰنُ","man"],["وَأَنَّىٰ","but how"],["لَهُ","(will be) for him"],["ٱلذِّكۡرَىٰ","the remembrance"]]},{"s":85,"a":12,"en":"Indeed, the vengeance of your Lord is severe.","w":[["إِنَّ","Indeed"],["بَطۡشَ","(the) Grip"],["رَبِّكَ","(of) your Lord"],["لَشَدِيدٌ","(is) surely strong"]]},{"s":50,"a":17,"en":"When the two receivers receive, seated on the right and on the left.","w":[["إِذۡ","When"],["يَتَلَقَّى","receive"],["ٱلۡمُتَلَقِّيَانِ","the two receivers"],["عَنِ","on"],["ٱلۡيَمِينِ","the right"],["وَعَنِ","and on"],["ٱلشِّمَالِ","the left"],["قَعِيدٞ","seated"]]},{"s":46,"a":2,"en":"The revelation of the Book is from Allah, the Exalted in Might, the Wise.","w":[["تَنزِيلُ","(The) revelation"],["ٱلۡكِتَٰبِ","(of) the Book"],["مِنَ","(is) from"],["ٱللَّهِ","Allah"],["ٱلۡعَزِيزِ","the All-Mighty"],["ٱلۡحَكِيمِ","the All-Wise"]]},{"s":83,"a":32,"en":"And when they saw them, they would say, \"Indeed, those are truly lost.\"","w":[["وَإِذَا","And when"],["رَأَوۡهُمۡ","they saw them"],["قَالُوٓاْ","they said"],["إِنَّ","Indeed"],["هَـٰٓؤُلَآءِ","these"],["لَضَآلُّونَ","surely have gone astray"]]},{"s":56,"a":44,"en":"Neither cool nor beneficial.","w":[["لَّا","Not"],["بَارِدٖ","cool"],["وَلَا","and not"],["كَرِيمٍ","pleasant"]]},{"s":25,"a":33,"en":"And they do not come to you with an argument except that We bring you the truth and the best explanation.","w":[["وَلَا","And not"],["يَأۡتُونَكَ","they come to you"],["بِمَثَلٍ","with an example"],["إِلَّا","but"],["جِئۡنَٰكَ","We bring you"],["بِٱلۡحَقِّ","the truth"],["وَأَحۡسَنَ","and (the) best"],["تَفۡسِيرًا","explanation"]]},{"s":88,"a":17,"en":"Then do they not look at the camels - how they are created?","w":[["أَفَلَا","Then do not"],["يَنظُرُونَ","they look"],["إِلَى","towards"],["ٱلۡإِبِلِ","the camels"],["كَيۡفَ","how"],["خُلِقَتۡ","they are created"]]},{"s":68,"a":33,"en":"Such is the punishment [of this world]. And the punishment of the Hereafter is greater, if they only knew.","w":[["كَذَٰلِكَ","Such"],["ٱلۡعَذَابُۖ","(is) the punishment"],["وَلَعَذَابُ","And surely the punishment"],["ٱلۡأٓخِرَةِ","(of) the Hereafter"],["أَكۡبَرُۚ","(is) greater"],["لَوۡ","if"],["كَانُواْ","they"],["يَعۡلَمُونَ","know"]]},{"s":48,"a":8,"en":"Indeed, We have sent you as a witness and a bringer of good tidings and a warner","w":[["إِنَّآ","Indeed,We"],["أَرۡسَلۡنَٰكَ","[We] have sent you"],["شَٰهِدٗا","(as) a witness"],["وَمُبَشِّرٗا","and (as) a bearer of glad tidings"],["وَنَذِيرٗا","and (as) a warner"]]},{"s":102,"a":4,"en":"Then no! You are going to know.","w":[["ثُمَّ","Then"],["كَلَّا","nay"],["سَوۡفَ","Soon"],["تَعۡلَمُونَ","you will know"]]},{"s":95,"a":7,"en":"So what yet causes you to deny the Recompense?","w":[["فَمَا","Then what"],["يُكَذِّبُكَ","causes you to deny"],["بَعۡدُ","after (this)"],["بِٱلدِّينِ","the judgment"]]},{"s":91,"a":13,"en":"And the messenger of Allah [Salih] said to them, \"[Do not harm] the she-camel of Allah or [prevent her from] her drink.\"","w":[["فَقَالَ","But said"],["لَهُمۡ","to them"],["رَسُولُ","(the) Messenger"],["ٱللَّهِ","(of) Allah"],["نَاقَةَ","(It is the) she-camel"],["ٱللَّهِ","(of) Allah"],["وَسُقۡيَٰهَا","and her drink"]]},{"s":3,"a":197,"en":"[It is but] a small enjoyment; then their [final] refuge is Hell, and wretched is the resting place.","w":[["مَتَٰعٞ","An enjoyment"],["قَلِيلٞ","little"],["ثُمَّ","then"],["مَأۡوَىٰهُمۡ","their abode"],["جَهَنَّمُۖ","(is) hell"],["وَبِئۡسَ","[and] a wretched"],["ٱلۡمِهَادُ","[the] resting place"]]}]
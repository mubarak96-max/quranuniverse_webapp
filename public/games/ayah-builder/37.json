[{"s":34,"a":35,"en":"And they said, \"We are more [than the believers] in wealth and children, and we are not to be punished.\"","w":[["وَقَالُواْ","And they say"],["نَحۡنُ","We"],["أَكۡثَرُ","(have) more"],["أَمۡوَٰلٗا","wealth"],["وَأَوۡلَٰدٗا","and children"],["وَمَا","and not"],["نَحۡنُ","we"],["بِمُعَذَّبِينَ","will be punished"]]},{"s":64,"a":18,"en":"Knower of the unseen and the witnessed, the Exalted in Might, the Wise.","w":[["عَٰلِمُ","(The) Knower"],["ٱلۡغَيۡبِ","(of) the unseen"],["وَٱلشَّهَٰدَةِ","and the witnessed"],["ٱلۡعَزِيزُ","the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":41,"a":3,"en":"A Book whose verses have been detailed, an Arabic Qur'an for a people who know,","w":[["كِتَٰبٞ","A Book"],["فُصِّلَتۡ","are detailed"],["ءَايَٰتُهُۥ","its Verses"],["قُرۡءَانًا","a Quran"],["عَرَبِيّٗا","(in) Arabic"],["لِّقَوۡمٖ","for a people"],["يَعۡلَمُونَ","(who) know"]]},{"s":32,"a":6,"en":"That is the Knower of the unseen and the witnessed, the Exalted in Might, the Merciful,","w":[["ذَٰلِكَ","That"],["عَٰلِمُ","(is the) Knower"],["ٱلۡغَيۡبِ","(of) the hidden"],["وَٱلشَّهَٰدَةِ","and the witnessed"],["ٱلۡعَزِيزُ","the All-Mighty"],["ٱلرَّحِيمُ","the Most Merciful"]]},{"s":71,"a":24,"en":"And already they have misled many. And, [my Lord], do not increase the wrongdoers except in error.\"","w":[["وَقَدۡ","And indeed"],["أَضَلُّواْ","they have led astray"],["كَثِيرٗاۖ","many"],["وَلَا","And not"],["تَزِدِ","increase"],["ٱلظَّـٰلِمِينَ","the wrongdoers"],["إِلَّا","except"],["ضَلَٰلٗا","(in) error"]]},{"s":28,"a":66,"en":"But the information will be unapparent to them that Day, so they will not [be able to] ask one another.","w":[["فَعَمِيَتۡ","But (will) be obscure"],["عَلَيۡهِمُ","to them"],["ٱلۡأَنۢبَآءُ","the information"],["يَوۡمَئِذٖ","that day"],["فَهُمۡ","so they"],["لَا","will not ask one another"],["يَتَسَآءَلُونَ","will not ask one another"]]},{"s":82,"a":19,"en":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah.","w":[["يَوۡمَ","(The) Day"],["لَا","not"],["تَمۡلِكُ","will have power"],["نَفۡسٞ","a soul"],["لِّنَفۡسٖ","for a soul"],["شَيۡـٔٗاۖ","anything"],["وَٱلۡأَمۡرُ","and the Command"],["يَوۡمَئِذٖ","that Day"],["لِّلَّهِ","(will be) with Allah"]]},{"s":8,"a":3,"en":"The ones who establish prayer, and from what We have provided them, they spend.","w":[["ٱلَّذِينَ","Those who"],["يُقِيمُونَ","establish"],["ٱلصَّلَوٰةَ","the prayer"],["وَمِمَّا","and out of what"],["رَزَقۡنَٰهُمۡ","We have provided them"],["يُنفِقُونَ","they spend"]]},{"s":105,"a":3,"en":"And He sent against them birds in flocks,","w":[["وَأَرۡسَلَ","And He sent"],["عَلَيۡهِمۡ","against them"],["طَيۡرًا","birds"],["أَبَابِيلَ","(in) flocks"]]},{"s":57,"a":1,"en":"Whatever is in the heavens and earth exalts Allah, and He is the Exalted in Might, the Wise.","w":[["سَبَّحَ","Glorifies"],["لِلَّهِ","[to] Allah"],["مَا","whatever"],["فِي","(is) in"],["ٱلسَّمَٰوَٰتِ","the heavens"],["وَٱلۡأَرۡضِۖ","and the earth"],["وَهُوَ","and He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":26,"a":119,"en":"So We saved him and those with him in the laden ship.","w":[["فَأَنجَيۡنَٰهُ","So We saved him"],["وَمَن","and who"],["مَّعَهُۥ","(were) with him"],["فِي","in"],["ٱلۡفُلۡكِ","the ship"],["ٱلۡمَشۡحُونِ","laden"]]},{"s":103,"a":2,"en":"Indeed, mankind is in loss,","w":[["إِنَّ","Indeed"],["ٱلۡإِنسَٰنَ","mankind"],["لَفِي","(is) surely,in"],["خُسۡرٍ","loss"]]},{"s":62,"a":3,"en":"And [to] others of them who have not yet joined them. And He is the Exalted in Might, the Wise.","w":[["وَءَاخَرِينَ","And others"],["مِنۡهُمۡ","among them"],["لَمَّا","who have not yet"],["يَلۡحَقُواْ","joined"],["بِهِمۡۚ","them"],["وَهُوَ","and He"],["ٱلۡعَزِيزُ","(is) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]},{"s":114,"a":5,"en":"Who whispers [evil] into the breasts of mankind -","w":[["ٱلَّذِي","The one who"],["يُوَسۡوِسُ","whispers"],["فِي","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]]},{"s":15,"a":24,"en":"And We have already known the preceding [generations] among you, and We have already known the later [ones to come].","w":[["وَلَقَدۡ","And verily"],["عَلِمۡنَا","We know"],["ٱلۡمُسۡتَقۡدِمِينَ","the preceding ones"],["مِنكُمۡ","among you"],["وَلَقَدۡ","and verily"],["عَلِمۡنَا","We know"],["ٱلۡمُسۡتَـٔۡخِرِينَ","the later ones"]]},{"s":4,"a":28,"en":"And Allah wants to lighten for you [your difficulties]; and mankind was created weak.","w":[["يُرِيدُ","Wishes"],["ٱللَّهُ","Allah"],["أَن","to"],["يُخَفِّفَ","lighten"],["عَنكُمۡۚ","for you"],["وَخُلِقَ","and was created"],["ٱلۡإِنسَٰنُ","the mankind"],["ضَعِيفٗا","weak"]]},{"s":39,"a":39,"en":"Say, \"O my people, work according to your position, [for] indeed, I am working; and you are going to know","w":[["قُلۡ","Say"],["يَٰقَوۡمِ","O my people"],["ٱعۡمَلُواْ","Work"],["عَلَىٰ","(according) to"],["مَكَانَتِكُمۡ","your position"],["إِنِّي","indeed,I am"],["عَٰمِلٞۖ","working"],["فَسَوۡفَ","then soon"],["تَعۡلَمُونَ","you will know"]]},{"s":101,"a":5,"en":"And the mountains will be like wool, fluffed up.","w":[["وَتَكُونُ","And will be"],["ٱلۡجِبَالُ","the mountains"],["كَٱلۡعِهۡنِ","like wool"],["ٱلۡمَنفُوشِ","fluffed up"]]},{"s":96,"a":14,"en":"Does he not know that Allah sees?","w":[["أَلَمۡ","Does not"],["يَعۡلَم","he know"],["بِأَنَّ","that"],["ٱللَّهَ","Allah"],["يَرَىٰ","sees"]]},{"s":84,"a":21,"en":"And when the Qur'an is recited to them, they do not prostrate [to Allah]?","w":[["وَإِذَا","And when"],["قُرِئَ","is recited"],["عَلَيۡهِمُ","to them"],["ٱلۡقُرۡءَانُ","the Quran"],["لَا","not"],["يَسۡجُدُونَۤ۩","they prostrate"]]},{"s":2,"a":147,"en":"The truth is from your Lord, so never be among the doubters.","w":[["ٱلۡحَقُّ","The Truth"],["مِن","(is) from"],["رَّبِّكَ","your Lord"],["فَلَا","so (do) not"],["تَكُونَنَّ","be"],["مِنَ","among"],["ٱلۡمُمۡتَرِينَ","the doubters"]]},{"s":93,"a":11,"en":"But as for the favor of your Lord, report [it].","w":[["وَأَمَّا","But as for"],["بِنِعۡمَةِ","(the) Favor"],["رَبِّكَ","(of) your Lord"],["فَحَدِّثۡ","narrate"]]},{"s":110,"a":3,"en":"Then exalt [Him] with praise of your Lord and ask forgiveness of Him. Indeed, He is ever Accepting of repentance.","w":[["فَسَبِّحۡ","Then glorify"],["بِحَمۡدِ","with (the) praises"],["رَبِّكَ","(of) your Lord"],["وَٱسۡتَغۡفِرۡهُۚ","and ask His forgiveness"],["إِنَّهُۥ","Indeed,He"],["كَانَ","is"],["تَوَّابَۢا","Oft-Returning"]]},{"s":79,"a":35,"en":"The Day when man will remember that for which he strove,","w":[["يَوۡمَ","(The) Day"],["يَتَذَكَّرُ","will remember"],["ٱلۡإِنسَٰنُ","man"],["مَا","what"],["سَعَىٰ","he strove (for)"]]},{"s":65,"a":9,"en":"And it tasted the bad consequence of its affair, and the outcome of its affair was loss.","w":[["فَذَاقَتۡ","So it tasted"],["وَبَالَ","(the bad) consequence"],["أَمۡرِهَا","(of) its affair"],["وَكَانَ","and was"],["عَٰقِبَةُ","(the) end"],["أَمۡرِهَا","(of) its affair"],["خُسۡرًا","loss"]]},{"s":47,"a":7,"en":"O you who have believed, if you support Allah, He will support you and plant firmly your feet.","w":[["يَـٰٓأَيُّهَا","O you who believe"],["ٱلَّذِينَ","O you who believe"],["ءَامَنُوٓاْ","O you who believe"],["إِن","If"],["تَنصُرُواْ","you help"],["ٱللَّهَ","Allah"],["يَنصُرۡكُمۡ","He will help you"],["وَيُثَبِّتۡ","and make firm"],["أَقۡدَامَكُمۡ","your feet"]]},{"s":61,"a":2,"en":"O you who have believed, why do you say what you do not do?","w":[["يَـٰٓأَيُّهَا","O"],["ٱلَّذِينَ","(you) who"],["ءَامَنُواْ","believe"],["لِمَ","Why"],["تَقُولُونَ","(do) you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":74,"a":45,"en":"And we used to enter into vain discourse with those who engaged [in it],","w":[["وَكُنَّا","And we used to"],["نَخُوضُ","indulge in vain talk"],["مَعَ","with"],["ٱلۡخَآئِضِينَ","the vain talkers"]]},{"s":46,"a":19,"en":"And for all there are degrees [of reward and punishment] for what they have done, and [it is] so that He may fully compensate them for their deeds, and they will not be wronged.","w":[["وَلِكُلّٖ","And for all"],["دَرَجَٰتٞ","(are) degrees"],["مِّمَّا","for what"],["عَمِلُواْۖ","they did"],["وَلِيُوَفِّيَهُمۡ","and that He may fully compensate them"],["أَعۡمَٰلَهُمۡ","(for) their deeds"],["وَهُمۡ","and they"],["لَا","will not be wronged"],["يُظۡلَمُونَ","will not be wronged"]]},{"s":109,"a":2,"en":"I do not worship what you worship.","w":[["لَآ","Not"],["أَعۡبُدُ","I worship"],["مَا","what"],["تَعۡبُدُونَ","you worship"]]}]
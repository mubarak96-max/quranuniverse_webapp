[{"s":9,"a":22,"en":"[They will be] abiding therein forever. Indeed, Allah has with Him a great reward.","w":[["خَٰلِدِينَ","(They will) abide"],["فِيهَآ","in it"],["أَبَدًاۚ","forever"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["عِندَهُۥٓ","with Him"],["أَجۡرٌ","(is) a reward"],["عَظِيمٞ","great"]]},{"s":102,"a":8,"en":"Then you will surely be asked that Day about pleasure.","w":[["ثُمَّ","Then"],["لَتُسۡـَٔلُنَّ","surely you will be asked"],["يَوۡمَئِذٍ","that Day"],["عَنِ","about"],["ٱلنَّعِيمِ","the pleasures"]]},{"s":12,"a":7,"en":"Certainly were there in Joseph and his brothers signs for those who ask,","w":[["۞لَّقَدۡ","Certainly"],["كَانَ","were"],["فِي","in"],["يُوسُفَ","Yusuf"],["وَإِخۡوَتِهِۦٓ","and his brothers"],["ءَايَٰتٞ","signs"],["لِّلسَّآئِلِينَ","for those who ask"]]},{"s":57,"a":3,"en":"He is the First and the Last, the Ascendant and the Intimate, and He is, of all things, Knowing.","w":[["هُوَ","He"],["ٱلۡأَوَّلُ","(is) the First"],["وَٱلۡأٓخِرُ","and the Last"],["وَٱلظَّـٰهِرُ","and the Apparent"],["وَٱلۡبَاطِنُۖ","and the Unapparent"],["وَهُوَ","and He"],["بِكُلِّ","(is) of every"],["شَيۡءٍ","thing"],["عَلِيمٌ","All-Knower"]]},{"s":55,"a":43,"en":"This is Hell, which the criminals deny.","w":[["هَٰذِهِۦ","This"],["جَهَنَّمُ","(is) Hell"],["ٱلَّتِي","which"],["يُكَذِّبُ","deny"],["بِهَا","[of it]"],["ٱلۡمُجۡرِمُونَ","the criminals"]]},{"s":27,"a":67,"en":"And those who disbelieve say, \"When we have become dust as well as our forefathers, will we indeed be brought out [of the graves]?","w":[["وَقَالَ","And say"],["ٱلَّذِينَ","those who"],["كَفَرُوٓاْ","disbelieve"],["أَءِذَا","What,when"],["كُنَّا","we have become"],["تُرَٰبٗا","dust"],["وَءَابَآؤُنَآ","and our forefathers"],["أَئِنَّا","will we"],["لَمُخۡرَجُونَ","surely be brought out"]]},{"s":74,"a":42,"en":"[And asking them], \"What put you into Saqar?\"","w":[["مَا","What"],["سَلَكَكُمۡ","led you"],["فِي","into"],["سَقَرَ","Hell"]]},{"s":37,"a":18,"en":"Say, \"Yes, and you will be [rendered] contemptible.\"","w":[["قُلۡ","Say"],["نَعَمۡ","Yes"],["وَأَنتُمۡ","and you"],["دَٰخِرُونَ","(will be) humiliated"]]},{"s":84,"a":13,"en":"Indeed, he had [once] been among his people in happiness;","w":[["إِنَّهُۥ","Indeed,he"],["كَانَ","had been"],["فِيٓ","among"],["أَهۡلِهِۦ","his people"],["مَسۡرُورًا","happy"]]},{"s":38,"a":84,"en":"[Allah] said, \"The truth [is My oath], and the truth I say -","w":[["قَالَ","He said"],["فَٱلۡحَقُّ","Then (it is) the truth"],["وَٱلۡحَقَّ","and the truth"],["أَقُولُ","I say"]]},{"s":48,"a":9,"en":"That you [people] may believe in Allah and His Messenger and honor him and respect the Prophet and exalt Allah morning and afternoon.","w":[["لِّتُؤۡمِنُواْ","That you may believe"],["بِٱللَّهِ","in Allah"],["وَرَسُولِهِۦ","and His Messenger"],["وَتُعَزِّرُوهُ","and (may) honor him"],["وَتُوَقِّرُوهُۚ","and respect him"],["وَتُسَبِّحُوهُ","and glorify Him"],["بُكۡرَةٗ","morning"],["وَأَصِيلًا","and evening"]]},{"s":101,"a":6,"en":"Then as for one whose scales are heavy [with good deeds],","w":[["فَأَمَّا","Then as for"],["مَن","(him) whose"],["ثَقُلَتۡ","(are) heavy"],["مَوَٰزِينُهُۥ","his scales"]]},{"s":21,"a":71,"en":"And We delivered him and Lot to the land which We had blessed for the worlds.","w":[["وَنَجَّيۡنَٰهُ","And We delivered him"],["وَلُوطًا","and Lut"],["إِلَى","to"],["ٱلۡأَرۡضِ","the land"],["ٱلَّتِي","which"],["بَٰرَكۡنَا","We (had) blessed"],["فِيهَا","[in it]"],["لِلۡعَٰلَمِينَ","for the worlds"]]},{"s":44,"a":18,"en":"[Saying], \"Render to me the servants of Allah. Indeed, I am to you a trustworthy messenger,\"","w":[["أَنۡ","That"],["أَدُّوٓاْ","Deliver"],["إِلَيَّ","to me"],["عِبَادَ","(the) servants"],["ٱللَّهِۖ","(of) Allah"],["إِنِّي","Indeed,I am"],["لَكُمۡ","to you"],["رَسُولٌ","a Messenger"],["أَمِينٞ","trustworthy"]]},{"s":111,"a":5,"en":"Around her neck is a rope of [twisted] fiber.","w":[["فِي","In"],["جِيدِهَا","her neck"],["حَبۡلٞ","(will be) a rope"],["مِّن","of"],["مَّسَدِۭ","palm-fiber"]]},{"s":89,"a":6,"en":"Have you not considered how your Lord dealt with 'Aad -","w":[["أَلَمۡ","Did not"],["تَرَ","you see"],["كَيۡفَ","how"],["فَعَلَ","dealt"],["رَبُّكَ","your Lord"],["بِعَادٍ","with Aad"]]},{"s":52,"a":39,"en":"Or has He daughters while you have sons?","w":[["أَمۡ","Or"],["لَهُ","for Him"],["ٱلۡبَنَٰتُ","(are) daughters"],["وَلَكُمُ","while for you"],["ٱلۡبَنُونَ","(are) sons"]]},{"s":82,"a":9,"en":"No! But you deny the Recompense.","w":[["كَلَّا","Nay"],["بَلۡ","But"],["تُكَذِّبُونَ","you deny"],["بِٱلدِّينِ","the Judgment"]]},{"s":113,"a":2,"en":"From the evil of that which He created","w":[["مِن","From"],["شَرِّ","(the) evil"],["مَا","(of) what"],["خَلَقَ","He created"]]},{"s":105,"a":2,"en":"Did He not make their plan into misguidance?","w":[["أَلَمۡ","Did not"],["يَجۡعَلۡ","He make"],["كَيۡدَهُمۡ","their plan"],["فِي","go"],["تَضۡلِيلٖ","astray"]]},{"s":109,"a":3,"en":"Nor are you worshippers of what I worship.","w":[["وَلَآ","And not"],["أَنتُمۡ","you"],["عَٰبِدُونَ","(are) worshippers"],["مَآ","(of) what"],["أَعۡبُدُ","I worship"]]},{"s":103,"a":3,"en":"Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.","w":[["إِلَّا","Except"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلۡحَقِّ","to the truth"],["وَتَوَاصَوۡاْ","and enjoin (each other)"],["بِٱلصَّبۡرِ","to [the] patience"]]},{"s":2,"a":252,"en":"These are the verses of Allah which We recite to you, [O Muhammad], in truth. And indeed, you are from among the messengers.","w":[["تِلۡكَ","These"],["ءَايَٰتُ","(are the) Verses"],["ٱللَّهِ","(of) Allah"],["نَتۡلُوهَا","We recite them"],["عَلَيۡكَ","to you"],["بِٱلۡحَقِّۚ","in [the] truth"],["وَإِنَّكَ","And indeed,you"],["لَمِنَ","(are) surely of"],["ٱلۡمُرۡسَلِينَ","the Messengers"]]},{"s":68,"a":30,"en":"Then they approached one another, blaming each other.","w":[["فَأَقۡبَلَ","Then approached"],["بَعۡضُهُمۡ","some of them"],["عَلَىٰ","to"],["بَعۡضٖ","others"],["يَتَلَٰوَمُونَ","blaming each other"]]},{"s":69,"a":49,"en":"And indeed, We know that among you are deniers.","w":[["وَإِنَّا","And indeed,We"],["لَنَعۡلَمُ","surely know"],["أَنَّ","that"],["مِنكُم","among you"],["مُّكَذِّبِينَ","(are) deniers"]]},{"s":87,"a":7,"en":"Except what Allah should will. Indeed, He knows what is declared and what is hidden.","w":[["إِلَّا","Except"],["مَا","what"],["شَآءَ","wills"],["ٱللَّهُۚ","Allah"],["إِنَّهُۥ","Indeed,He"],["يَعۡلَمُ","knows"],["ٱلۡجَهۡرَ","the manifest"],["وَمَا","and what"],["يَخۡفَىٰ","is hidden"]]},{"s":73,"a":10,"en":"And be patient over what they say and avoid them with gracious avoidance.","w":[["وَٱصۡبِرۡ","And be patient"],["عَلَىٰ","over"],["مَا","what"],["يَقُولُونَ","they say"],["وَٱهۡجُرۡهُمۡ","and avoid them"],["هَجۡرٗا","an avoidance"],["جَمِيلٗا","gracious"]]},{"s":106,"a":2,"en":"Their accustomed security [in] the caravan of winter and summer -","w":[["إِۦلَٰفِهِمۡ","Their familiarity"],["رِحۡلَةَ","(with the) journey"],["ٱلشِّتَآءِ","(of) winter"],["وَٱلصَّيۡفِ","and summer"]]},{"s":75,"a":2,"en":"And I swear by the reproaching soul [to the certainty of resurrection].","w":[["وَلَآ","And nay"],["أُقۡسِمُ","I swear"],["بِٱلنَّفۡسِ","by the soul"],["ٱللَّوَّامَةِ","self-accusing"]]},{"s":114,"a":5,"en":"Who whispers [evil] into the breasts of mankind -","w":[["ٱلَّذِي","The one who"],["يُوَسۡوِسُ","whispers"],["فِي","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]]}]
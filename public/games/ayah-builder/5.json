[{"s":19,"a":84,"en":"So be not impatient over them. We only count out to them a [limited] number.","w":[["فَلَا","So (do) not"],["تَعۡجَلۡ","make haste"],["عَلَيۡهِمۡۖ","against them"],["إِنَّمَا","Only"],["نَعُدُّ","We count"],["لَهُمۡ","for them"],["عَدّٗا","a number"]]},{"s":24,"a":9,"en":"And the fifth [oath will be] that the wrath of Allah be upon her if he was of the truthful.","w":[["وَٱلۡخَٰمِسَةَ","And the fifth"],["أَنَّ","that"],["غَضَبَ","the wrath of Allah"],["ٱللَّهِ","the wrath of Allah"],["عَلَيۡهَآ","(be) upon her"],["إِن","if"],["كَانَ","he is"],["مِنَ","of"],["ٱلصَّـٰدِقِينَ","the truthful"]]},{"s":4,"a":28,"en":"And Allah wants to lighten for you [your difficulties]; and mankind was created weak.","w":[["يُرِيدُ","Wishes"],["ٱللَّهُ","Allah"],["أَن","to"],["يُخَفِّفَ","lighten"],["عَنكُمۡۚ","for you"],["وَخُلِقَ","and was created"],["ٱلۡإِنسَٰنُ","the mankind"],["ضَعِيفٗا","weak"]]},{"s":25,"a":35,"en":"And We had certainly given Moses the Scripture and appointed with him his brother Aaron as an assistant.","w":[["وَلَقَدۡ","And verily"],["ءَاتَيۡنَا","We gave"],["مُوسَى","Musa"],["ٱلۡكِتَٰبَ","the Scripture"],["وَجَعَلۡنَا","and We appointed"],["مَعَهُۥٓ","with him"],["أَخَاهُ","his brother"],["هَٰرُونَ","Harun"],["وَزِيرٗا","(as) an assistant"]]},{"s":13,"a":24,"en":"\"Peace be upon you for what you patiently endured. And excellent is the final home.\"","w":[["سَلَٰمٌ","(Saying),\" Peace"],["عَلَيۡكُم","(be) upon you"],["بِمَا","for what"],["صَبَرۡتُمۡۚ","you patiently endured"],["فَنِعۡمَ","And excellent"],["عُقۡبَى","(is) the final attainment"],["ٱلدَّارِ","(of) the Home"]]},{"s":34,"a":29,"en":"And they say, \"When is this promise, if you should be truthful?\"","w":[["وَيَقُولُونَ","And they say"],["مَتَىٰ","When"],["هَٰذَا","(is) this"],["ٱلۡوَعۡدُ","promise"],["إِن","if"],["كُنتُمۡ","you are"],["صَٰدِقِينَ","truthful"]]},{"s":64,"a":15,"en":"Your wealth and your children are but a trial, and Allah has with Him a great reward.","w":[["إِنَّمَآ","Only"],["أَمۡوَٰلُكُمۡ","your wealth"],["وَأَوۡلَٰدُكُمۡ","and your children"],["فِتۡنَةٞۚ","(are) a trial"],["وَٱللَّهُ","and Allah"],["عِندَهُۥٓ","with Him"],["أَجۡرٌ","(is) a reward"],["عَظِيمٞ","great"]]},{"s":6,"a":162,"en":"Say, \"Indeed, my prayer, my rites of sacrifice, my living and my dying are for Allah, Lord of the worlds.","w":[["قُلۡ","Say"],["إِنَّ","Indeed"],["صَلَاتِي","my prayer"],["وَنُسُكِي","and my rites of sacrifice"],["وَمَحۡيَايَ","and my living"],["وَمَمَاتِي","and my dying"],["لِلَّهِ","(are) for Allah"],["رَبِّ","Lord"],["ٱلۡعَٰلَمِينَ","(of) the worlds"]]},{"s":79,"a":18,"en":"And say to him, 'Would you [be willing to] purify yourself","w":[["فَقُلۡ","And say"],["هَل","Would"],["لَّكَ","[for] you"],["إِلَىٰٓ","[to]"],["أَن","[that]"],["تَزَكَّىٰ","purify yourself"]]},{"s":18,"a":68,"en":"And how can you have patience for what you do not encompass in knowledge?\"","w":[["وَكَيۡفَ","And how can"],["تَصۡبِرُ","you have patience"],["عَلَىٰ","for"],["مَا","what"],["لَمۡ","not"],["تُحِطۡ","you encompass"],["بِهِۦ","of it"],["خُبۡرٗا","any knowledge"]]},{"s":70,"a":35,"en":"They will be in gardens, honored.","w":[["أُوْلَـٰٓئِكَ","Those"],["فِي","(will be) in"],["جَنَّـٰتٖ","Gardens"],["مُّكۡرَمُونَ","honored"]]},{"s":47,"a":8,"en":"But those who disbelieve - for them is misery, and He will waste their deeds.","w":[["وَٱلَّذِينَ","But those who"],["كَفَرُواْ","disbelieve"],["فَتَعۡسٗا","destruction (is)"],["لَّهُمۡ","for them"],["وَأَضَلَّ","and He will cause to be lost"],["أَعۡمَٰلَهُمۡ","their deeds"]]},{"s":16,"a":5,"en":"And the grazing livestock He has created for you; in them is warmth and [numerous] benefits, and from them you eat.","w":[["وَٱلۡأَنۡعَٰمَ","And the cattle"],["خَلَقَهَاۖ","He created them"],["لَكُمۡ","for you"],["فِيهَا","in them"],["دِفۡءٞ","(is) warmth"],["وَمَنَٰفِعُ","and benefits"],["وَمِنۡهَا","and from them"],["تَأۡكُلُونَ","you eat"]]},{"s":61,"a":3,"en":"Great is hatred in the sight of Allah that you say what you do not do.","w":[["كَبُرَ","Great is"],["مَقۡتًا","hatred"],["عِندَ","with"],["ٱللَّهِ","Allah"],["أَن","that"],["تَقُولُواْ","you say"],["مَا","what"],["لَا","not"],["تَفۡعَلُونَ","you do"]]},{"s":42,"a":19,"en":"Allah is Subtle with His servants; He gives provisions to whom He wills. And He is the Powerful, the Exalted in Might.","w":[["ٱللَّهُ","Allah"],["لَطِيفُۢ","(is) Subtle"],["بِعِبَادِهِۦ","with His slaves"],["يَرۡزُقُ","He gives provision"],["مَن","(to) whom"],["يَشَآءُۖ","He wills"],["وَهُوَ","And He"],["ٱلۡقَوِيُّ","(is) the All-Strong"],["ٱلۡعَزِيزُ","the All-Mighty"]]},{"s":81,"a":24,"en":"And Muhammad is not a withholder of [knowledge of] the unseen.","w":[["وَمَا","And not"],["هُوَ","he (is)"],["عَلَى","on"],["ٱلۡغَيۡبِ","the unseen"],["بِضَنِينٖ","a withholder"]]},{"s":3,"a":76,"en":"But yes, whoever fulfills his commitment and fears Allah - then indeed, Allah loves those who fear Him.","w":[["بَلَىٰۚ","Nay"],["مَنۡ","whoever"],["أَوۡفَىٰ","fulfills"],["بِعَهۡدِهِۦ","his covenant"],["وَٱتَّقَىٰ","and fears (Allah)"],["فَإِنَّ","then indeed"],["ٱللَّهَ","Allah"],["يُحِبُّ","loves"],["ٱلۡمُتَّقِينَ","those who fear (Him)"]]},{"s":51,"a":42,"en":"It left nothing of what it came upon but that it made it like disintegrated ruins.","w":[["مَا","Not"],["تَذَرُ","it left"],["مِن","any"],["شَيۡءٍ","thing"],["أَتَتۡ","it came"],["عَلَيۡهِ","upon it"],["إِلَّا","but"],["جَعَلَتۡهُ","it made it"],["كَٱلرَّمِيمِ","like disintegrated ruins"]]},{"s":43,"a":76,"en":"And We did not wrong them, but it was they who were the wrongdoers.","w":[["وَمَا","And not"],["ظَلَمۡنَٰهُمۡ","We wronged them"],["وَلَٰكِن","but"],["كَانُواْ","they were"],["هُمُ","themselves"],["ٱلظَّـٰلِمِينَ","wrongdoers"]]},{"s":71,"a":17,"en":"And Allah has caused you to grow from the earth a [progressive] growth.","w":[["وَٱللَّهُ","And Allah"],["أَنۢبَتَكُم","has caused you to grow"],["مِّنَ","from"],["ٱلۡأَرۡضِ","the earth"],["نَبَاتٗا","(as) a growth"]]},{"s":72,"a":15,"en":"But as for the unjust, they will be, for Hell, firewood.'","w":[["وَأَمَّا","And as for"],["ٱلۡقَٰسِطُونَ","the unjust"],["فَكَانُواْ","they will be"],["لِجَهَنَّمَ","for Hell"],["حَطَبٗا","firewood"]]},{"s":107,"a":5,"en":"[But] who are heedless of their prayer -","w":[["ٱلَّذِينَ","Those who"],["هُمۡ","[they]"],["عَن","about"],["صَلَاتِهِمۡ","their prayers"],["سَاهُونَ","(are) neglectful"]]},{"s":36,"a":48,"en":"And they say, \"When is this promise, if you should be truthful?\"","w":[["وَيَقُولُونَ","And they say"],["مَتَىٰ","When (is)"],["هَٰذَا","this"],["ٱلۡوَعۡدُ","promise"],["إِن","if"],["كُنتُمۡ","you are"],["صَٰدِقِينَ","truthful"]]},{"s":30,"a":44,"en":"Whoever disbelieves - upon him is [the consequence of] his disbelief. And whoever does righteousness - they are for themselves preparing,","w":[["مَن","Whoever"],["كَفَرَ","disbelieves"],["فَعَلَيۡهِ","then against him"],["كُفۡرُهُۥۖ","(is) his disbelief"],["وَمَنۡ","And whoever"],["عَمِلَ","does"],["صَٰلِحٗا","righteousness"],["فَلِأَنفُسِهِمۡ","then for themselves"],["يَمۡهَدُونَ","they are preparing"]]},{"s":33,"a":61,"en":"Accursed wherever they are found, [being] seized and massacred completely.","w":[["مَّلۡعُونِينَۖ","Accursed"],["أَيۡنَمَا","wherever"],["ثُقِفُوٓاْ","they are found"],["أُخِذُواْ","they are seized"],["وَقُتِّلُواْ","and massacred completely"],["تَقۡتِيلٗا","and massacred completely"]]},{"s":86,"a":7,"en":"Emerging from between the backbone and the ribs.","w":[["يَخۡرُجُ","Coming forth"],["مِنۢ","from"],["بَيۡنِ","between"],["ٱلصُّلۡبِ","the backbone"],["وَٱلتَّرَآئِبِ","and the ribs"]]},{"s":93,"a":9,"en":"So as for the orphan, do not oppress [him].","w":[["فَأَمَّا","So as for"],["ٱلۡيَتِيمَ","the orphan"],["فَلَا","then (do) not"],["تَقۡهَرۡ","oppress"]]},{"s":20,"a":83,"en":"[Allah] said, \"And what made you hasten from your people, O Moses?\"","w":[["۞وَمَآ","And what"],["أَعۡجَلَكَ","made you hasten"],["عَن","from"],["قَوۡمِكَ","your people"],["يَٰمُوسَىٰ","O Musa"]]},{"s":50,"a":33,"en":"Who feared the Most Merciful unseen and came with a heart returning [in repentance].","w":[["مَّنۡ","Who"],["خَشِيَ","feared"],["ٱلرَّحۡمَٰنَ","the Most Gracious"],["بِٱلۡغَيۡبِ","in the unseen"],["وَجَآءَ","and came"],["بِقَلۡبٖ","with a heart"],["مُّنِيبٍ","returning"]]},{"s":80,"a":26,"en":"Then We broke open the earth, splitting [it with sprouts],","w":[["ثُمَّ","Then"],["شَقَقۡنَا","We cleaved"],["ٱلۡأَرۡضَ","the earth"],["شَقّٗا","splitting"]]}]
[{"s":29,"a":66,"en":"So that they will deny what We have granted them, and they will enjoy themselves. But they are going to know.","w":[["لِيَكۡفُرُواْ","So that they may deny"],["بِمَآ","[in] what"],["ءَاتَيۡنَٰهُمۡ","We have given them"],["وَلِيَتَمَتَّعُواْۚ","and they may enjoy (themselves)"],["فَسَوۡفَ","But soon"],["يَعۡلَمُونَ","they will know"]]},{"s":100,"a":11,"en":"Indeed, their Lord with them, that Day, is [fully] Acquainted.","w":[["إِنَّ","Indeed"],["رَبَّهُم","their Lord"],["بِهِمۡ","about them"],["يَوۡمَئِذٖ","that Day"],["لَّخَبِيرُۢ","(is) surely All-Aware"]]},{"s":7,"a":124,"en":"I will surely cut off your hands and your feet on opposite sides; then I will surely crucify you all.\"","w":[["لَأُقَطِّعَنَّ","I will surely cut off"],["أَيۡدِيَكُمۡ","your hands"],["وَأَرۡجُلَكُم","and your feet"],["مِّنۡ","of"],["خِلَٰفٖ","opposite (sides)"],["ثُمَّ","Then"],["لَأُصَلِّبَنَّكُمۡ","I will surely crucify you"],["أَجۡمَعِينَ","all"]]},{"s":95,"a":7,"en":"So what yet causes you to deny the Recompense?","w":[["فَمَا","Then what"],["يُكَذِّبُكَ","causes you to deny"],["بَعۡدُ","after (this)"],["بِٱلدِّينِ","the judgment"]]},{"s":35,"a":17,"en":"And that is for Allah not difficult.","w":[["وَمَا","And not"],["ذَٰلِكَ","that"],["عَلَى","(is) on"],["ٱللَّهِ","Allah"],["بِعَزِيزٖ","difficult"]]},{"s":5,"a":30,"en":"And his soul permitted to him the murder of his brother, so he killed him and became among the losers.","w":[["فَطَوَّعَتۡ","Then prompted"],["لَهُۥ","to him"],["نَفۡسُهُۥ","his soul"],["قَتۡلَ","(to) kill"],["أَخِيهِ","his brother"],["فَقَتَلَهُۥ","so he killed him"],["فَأَصۡبَحَ","and became"],["مِنَ","of"],["ٱلۡخَٰسِرِينَ","the losers"]]},{"s":58,"a":21,"en":"Allah has written, \"I will surely overcome, I and My messengers.\" Indeed, Allah is Powerful and Exalted in Might.","w":[["كَتَبَ","Allah has decreed"],["ٱللَّهُ","Allah has decreed"],["لَأَغۡلِبَنَّ","Surely,I will overcome"],["أَنَا۠","I"],["وَرُسُلِيٓۚ","and My Messengers"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["قَوِيٌّ","(is) All-Strong"],["عَزِيزٞ","All-Mighty"]]},{"s":96,"a":5,"en":"Taught man that which he knew not.","w":[["عَلَّمَ","Taught"],["ٱلۡإِنسَٰنَ","man"],["مَا","what"],["لَمۡ","not"],["يَعۡلَمۡ","he knew"]]},{"s":22,"a":69,"en":"Allah will judge between you on the Day of Resurrection concerning that over which you used to differ.\"","w":[["ٱللَّهُ","Allah"],["يَحۡكُمُ","will judge"],["بَيۡنَكُمۡ","between you"],["يَوۡمَ","(on the) Day"],["ٱلۡقِيَٰمَةِ","(of) the Resurrection"],["فِيمَا","concerning what"],["كُنتُمۡ","you used (to)"],["فِيهِ","in it"],["تَخۡتَلِفُونَ","differ"]]},{"s":110,"a":1,"en":"When the victory of Allah has come and the conquest,","w":[["إِذَا","When"],["جَآءَ","comes"],["نَصۡرُ","(the) Help"],["ٱللَّهِ","(of) Allah"],["وَٱلۡفَتۡحُ","and the Victory"]]},{"s":23,"a":93,"en":"Say, [O Muhammad], \"My Lord, if You should show me that which they are promised,","w":[["قُل","Say"],["رَّبِّ","My Lord"],["إِمَّا","If"],["تُرِيَنِّي","You should show me"],["مَا","what"],["يُوعَدُونَ","they are promised"]]},{"s":78,"a":20,"en":"And the mountains are removed and will be [but] a mirage.","w":[["وَسُيِّرَتِ","And are moved"],["ٱلۡجِبَالُ","the mountains"],["فَكَانَتۡ","and become"],["سَرَابًا","a mirage"]]},{"s":8,"a":59,"en":"And let not those who disbelieve think they will escape. Indeed, they will not cause failure [to Allah].","w":[["وَلَا","And (let) not"],["يَحۡسَبَنَّ","think"],["ٱلَّذِينَ","those who"],["كَفَرُواْ","disbelieve"],["سَبَقُوٓاْۚ","they can outstrip"],["إِنَّهُمۡ","Indeed,they"],["لَا","(can) not"],["يُعۡجِزُونَ","escape"]]},{"s":10,"a":56,"en":"He gives life and causes death, and to Him you will be returned","w":[["هُوَ","He"],["يُحۡيِۦ","gives life"],["وَيُمِيتُ","and causes death"],["وَإِلَيۡهِ","and to Him"],["تُرۡجَعُونَ","you will be returned"]]},{"s":67,"a":7,"en":"When they are thrown into it, they hear from it a [dreadful] inhaling while it boils up.","w":[["إِذَآ","When"],["أُلۡقُواْ","they are thrown"],["فِيهَا","therein"],["سَمِعُواْ","they will hear"],["لَهَا","from it"],["شَهِيقٗا","an inhaling"],["وَهِيَ","while it"],["تَفُورُ","boils up"]]},{"s":15,"a":32,"en":"[Allah] said, O Iblees, what is [the matter] with you that you are not with those who prostrate?\"","w":[["قَالَ","He said"],["يَـٰٓإِبۡلِيسُ","O Iblis"],["مَا","What"],["لَكَ","(is) for you"],["أَلَّا","that not"],["تَكُونَ","you are"],["مَعَ","with"],["ٱلسَّـٰجِدِينَ","those who prostrated"]]},{"s":1,"a":5,"en":"It is You we worship and You we ask for help.","w":[["إِيَّاكَ","You Alone"],["نَعۡبُدُ","we worship"],["وَإِيَّاكَ","and You Alone"],["نَسۡتَعِينُ","we ask for help"]]},{"s":77,"a":39,"en":"So if you have a plan, then plan against Me.","w":[["فَإِن","So if"],["كَانَ","is"],["لَكُمۡ","for you"],["كَيۡدٞ","a plan"],["فَكِيدُونِ","then plan against Me"]]},{"s":97,"a":2,"en":"And what can make you know what is the Night of Decree?","w":[["وَمَآ","And what"],["أَدۡرَىٰكَ","can make you know"],["مَا","what"],["لَيۡلَةُ","(the) Night"],["ٱلۡقَدۡرِ","(of) Power (is)"]]},{"s":85,"a":6,"en":"When they were sitting near it","w":[["إِذۡ","When"],["هُمۡ","they"],["عَلَيۡهَا","by it"],["قُعُودٞ","(were) sitting"]]},{"s":32,"a":8,"en":"Then He made his posterity out of the extract of a liquid disdained.","w":[["ثُمَّ","Then"],["جَعَلَ","He made"],["نَسۡلَهُۥ","his progeny"],["مِن","from"],["سُلَٰلَةٖ","an extract"],["مِّن","of"],["مَّآءٖ","water"],["مَّهِينٖ","despised"]]},{"s":76,"a":28,"en":"We have created them and strengthened their forms, and when We will, We can change their likenesses with [complete] alteration.","w":[["نَّحۡنُ","We"],["خَلَقۡنَٰهُمۡ","created them"],["وَشَدَدۡنَآ","and We strengthened"],["أَسۡرَهُمۡۖ","their forms"],["وَإِذَا","and when"],["شِئۡنَا","We will"],["بَدَّلۡنَآ","We can change"],["أَمۡثَٰلَهُمۡ","their likeness [es]"],["تَبۡدِيلًا","(with) a change"]]},{"s":65,"a":9,"en":"And it tasted the bad consequence of its affair, and the outcome of its affair was loss.","w":[["فَذَاقَتۡ","So it tasted"],["وَبَالَ","(the bad) consequence"],["أَمۡرِهَا","(of) its affair"],["وَكَانَ","and was"],["عَٰقِبَةُ","(the) end"],["أَمۡرِهَا","(of) its affair"],["خُسۡرًا","loss"]]},{"s":90,"a":2,"en":"And you, [O Muhammad], are free of restriction in this city -","w":[["وَأَنتَ","And you"],["حِلُّۢ","(are) free (to dwell)"],["بِهَٰذَا","in this"],["ٱلۡبَلَدِ","city"]]},{"s":49,"a":4,"en":"Indeed, those who call you, [O Muhammad], from behind the chambers - most of them do not use reason.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["يُنَادُونَكَ","call you"],["مِن","from"],["وَرَآءِ","behind"],["ٱلۡحُجُرَٰتِ","the private chambers"],["أَكۡثَرُهُمۡ","most of them"],["لَا","(do) not"],["يَعۡقِلُونَ","understand"]]},{"s":28,"a":65,"en":"And [mention] the Day He will call them and say, \"What did you answer the messengers?\"","w":[["وَيَوۡمَ","And (the) Day"],["يُنَادِيهِمۡ","He will call them"],["فَيَقُولُ","and say"],["مَاذَآ","What"],["أَجَبۡتُمُ","did you answer"],["ٱلۡمُرۡسَلِينَ","the Messengers"]]},{"s":91,"a":9,"en":"He has succeeded who purifies it,","w":[["قَدۡ","Indeed"],["أَفۡلَحَ","he succeeds"],["مَن","who"],["زَكَّىٰهَا","purifies it"]]},{"s":54,"a":41,"en":"And there certainly came to the people of Pharaoh warning.","w":[["وَلَقَدۡ","And certainly"],["جَآءَ","came"],["ءَالَ","(to the) people"],["فِرۡعَوۡنَ","(of) Firaun"],["ٱلنُّذُرُ","warnings"]]},{"s":88,"a":1,"en":"Has there reached you the report of the Overwhelming [event]?","w":[["هَلۡ","Has"],["أَتَىٰكَ","(there) come to you"],["حَدِيثُ","(the) news"],["ٱلۡغَٰشِيَةِ","(of) the Overwhelming"]]},{"s":94,"a":6,"en":"Indeed, with hardship [will be] ease.","w":[["إِنَّ","Indeed"],["مَعَ","with"],["ٱلۡعُسۡرِ","the hardship"],["يُسۡرٗا","(is) ease"]]}]
[{"s":41,"a":13,"en":"But if they turn away, then say, \"I have warned you of a thunderbolt like the thunderbolt [that struck] 'Aad and Thamud.","w":[["فَإِنۡ","But if"],["أَعۡرَضُواْ","they turn away"],["فَقُلۡ","then say"],["أَنذَرۡتُكُمۡ","I have warned you"],["صَٰعِقَةٗ","(of) a thunderbolt"],["مِّثۡلَ","like"],["صَٰعِقَةِ","(the) thunderbolt"],["عَادٖ","(of) Aad"],["وَثَمُودَ","and Thamud"]]},{"s":56,"a":95,"en":"Indeed, this is the true certainty,","w":[["إِنَّ","Indeed"],["هَٰذَا","this"],["لَهُوَ","surely,it"],["حَقُّ","(is the) truth"],["ٱلۡيَقِينِ","certain"]]},{"s":31,"a":8,"en":"Indeed, those who believe and do righteous deeds - for them are the Gardens of Pleasure.","w":[["إِنَّ","Indeed"],["ٱلَّذِينَ","those who"],["ءَامَنُواْ","believe"],["وَعَمِلُواْ","and do"],["ٱلصَّـٰلِحَٰتِ","righteous deeds"],["لَهُمۡ","for them"],["جَنَّـٰتُ","(are) Gardens"],["ٱلنَّعِيمِ","(of) Delight"]]},{"s":11,"a":71,"en":"And his Wife was standing, and she smiled. Then We gave her good tidings of Isaac and after Isaac, Jacob.","w":[["وَٱمۡرَأَتُهُۥ","And his wife"],["قَآئِمَةٞ","(was) standing"],["فَضَحِكَتۡ","and she laughed"],["فَبَشَّرۡنَٰهَا","Then We gave her glad tidings"],["بِإِسۡحَٰقَ","of Isaac"],["وَمِن","and after"],["وَرَآءِ","and after"],["إِسۡحَٰقَ","Isaac"],["يَعۡقُوبَ","(of) Yaqub"]]},{"s":17,"a":87,"en":"Except [We have left it with you] as a mercy from your Lord. Indeed, His favor upon you has ever been great.","w":[["إِلَّا","Except"],["رَحۡمَةٗ","a mercy"],["مِّن","from"],["رَّبِّكَۚ","your Lord"],["إِنَّ","Indeed"],["فَضۡلَهُۥ","His Bounty"],["كَانَ","is"],["عَلَيۡكَ","upon you"],["كَبِيرٗا","great"]]},{"s":104,"a":2,"en":"Who collects wealth and [continuously] counts it.","w":[["ٱلَّذِي","The one who"],["جَمَعَ","collects"],["مَالٗا","wealth"],["وَعَدَّدَهُۥ","and counts it"]]},{"s":98,"a":2,"en":"A Messenger from Allah, reciting purified scriptures","w":[["رَسُولٞ","A Messenger"],["مِّنَ","from"],["ٱللَّهِ","Allah"],["يَتۡلُواْ","reciting"],["صُحُفٗا","pages"],["مُّطَهَّرَةٗ","purified"]]},{"s":62,"a":7,"en":"But they will not wish for it, ever, because of what their hands have put forth. And Allah is Knowing of the wrongdoers.","w":[["وَلَا","But not"],["يَتَمَنَّوۡنَهُۥٓ","they will wish for it"],["أَبَدَۢا","ever"],["بِمَا","for what"],["قَدَّمَتۡ","(have) sent forth"],["أَيۡدِيهِمۡۚ","their hands"],["وَٱللَّهُ","And Allah"],["عَلِيمُۢ","(is) All-Knowing"],["بِٱلظَّـٰلِمِينَ","of the wrongdoers"]]},{"s":53,"a":47,"en":"And that [incumbent] upon Him is the next creation","w":[["وَأَنَّ","And that"],["عَلَيۡهِ","upon Him"],["ٱلنَّشۡأَةَ","(is) the bringing forth"],["ٱلۡأُخۡرَىٰ","another"]]},{"s":83,"a":19,"en":"And what can make you know what is 'illiyyun?","w":[["وَمَآ","And what"],["أَدۡرَىٰكَ","can make you know"],["مَا","what"],["عِلِّيُّونَ","(is) Illiyun"]]},{"s":87,"a":1,"en":"Exalt the name of your Lord, the Most High,","w":[["سَبِّحِ","Glorify"],["ٱسۡمَ","(the) name"],["رَبِّكَ","(of) your Lord"],["ٱلۡأَعۡلَى","the Most High"]]},{"s":91,"a":9,"en":"He has succeeded who purifies it,","w":[["قَدۡ","Indeed"],["أَفۡلَحَ","he succeeds"],["مَن","who"],["زَكَّىٰهَا","purifies it"]]},{"s":104,"a":7,"en":"Which mounts directed at the hearts.","w":[["ٱلَّتِي","Which"],["تَطَّلِعُ","mounts up"],["عَلَى","to"],["ٱلۡأَفۡـِٔدَةِ","the hearts"]]},{"s":24,"a":1,"en":"[This is] a surah which We have sent down and made [that within it] obligatory and revealed therein verses of clear evidence that you might remember.","w":[["سُورَةٌ","A Surah"],["أَنزَلۡنَٰهَا","We (have) sent it down"],["وَفَرَضۡنَٰهَا","and We (have) made it obligatory"],["وَأَنزَلۡنَا","and We (have) revealed"],["فِيهَآ","therein"],["ءَايَٰتِۭ","Verses"],["بَيِّنَٰتٖ","clear"],["لَّعَلَّكُمۡ","so that you may"],["تَذَكَّرُونَ","take heed"]]},{"s":9,"a":119,"en":"O you who have believed, fear Allah and be with those who are true.","w":[["يَـٰٓأَيُّهَا","O you who believe"],["ٱلَّذِينَ","O you who believe"],["ءَامَنُواْ","O you who believe"],["ٱتَّقُواْ","Fear"],["ٱللَّهَ","Allah"],["وَكُونُواْ","and be"],["مَعَ","with"],["ٱلصَّـٰدِقِينَ","those who are truthful"]]},{"s":45,"a":4,"en":"And in the creation of yourselves and what He disperses of moving creatures are signs for people who are certain [in faith].","w":[["وَفِي","And in"],["خَلۡقِكُمۡ","your creation"],["وَمَا","and what"],["يَبُثُّ","He disperses"],["مِن","of"],["دَآبَّةٍ","(the) moving creatures"],["ءَايَٰتٞ","(are) Signs"],["لِّقَوۡمٖ","for a people"],["يُوقِنُونَ","who are certain"]]},{"s":95,"a":7,"en":"So what yet causes you to deny the Recompense?","w":[["فَمَا","Then what"],["يُكَذِّبُكَ","causes you to deny"],["بَعۡدُ","after (this)"],["بِٱلدِّينِ","the judgment"]]},{"s":5,"a":74,"en":"So will they not repent to Allah and seek His forgiveness? And Allah is Forgiving and Merciful.","w":[["أَفَلَا","So will not"],["يَتُوبُونَ","they turn in repentance"],["إِلَى","to"],["ٱللَّهِ","Allah"],["وَيَسۡتَغۡفِرُونَهُۥۚ","and seek His forgiveness"],["وَٱللَّهُ","And Allah"],["غَفُورٞ","(is) Oft-Forgiving"],["رَّحِيمٞ","Most Merciful"]]},{"s":52,"a":40,"en":"Or do you, [O Muhammad], ask of them a payment, so they are by debt burdened down?","w":[["أَمۡ","Or"],["تَسۡـَٔلُهُمۡ","(do) you ask from them"],["أَجۡرٗا","a payment"],["فَهُم","so they"],["مِّن","from"],["مَّغۡرَمٖ","a debt"],["مُّثۡقَلُونَ","(are) overburdened"]]},{"s":110,"a":1,"en":"When the victory of Allah has come and the conquest,","w":[["إِذَا","When"],["جَآءَ","comes"],["نَصۡرُ","(the) Help"],["ٱللَّهِ","(of) Allah"],["وَٱلۡفَتۡحُ","and the Victory"]]},{"s":12,"a":12,"en":"Send him with us tomorrow that he may eat well and play. And indeed, we will be his guardians.","w":[["أَرۡسِلۡهُ","Send him"],["مَعَنَا","with us"],["غَدٗا","tomorrow"],["يَرۡتَعۡ","(to) enjoy"],["وَيَلۡعَبۡ","and play"],["وَإِنَّا","And indeed,we"],["لَهُۥ","for him"],["لَحَٰفِظُونَ","(will) surely (be) guardians"]]},{"s":55,"a":39,"en":"Then on that Day none will be asked about his sin among men or jinn.","w":[["فَيَوۡمَئِذٖ","Then (on) that Day"],["لَّا","not"],["يُسۡـَٔلُ","will be asked"],["عَن","about"],["ذَنۢبِهِۦٓ","his sin"],["إِنسٞ","any man"],["وَلَا","and not"],["جَآنّٞ","any jinn"]]},{"s":6,"a":87,"en":"And [some] among their fathers and their descendants and their brothers - and We chose them and We guided them to a straight path.","w":[["وَمِنۡ","And from"],["ءَابَآئِهِمۡ","their fathers"],["وَذُرِّيَّـٰتِهِمۡ","and their descendents"],["وَإِخۡوَٰنِهِمۡۖ","and their brothers"],["وَٱجۡتَبَيۡنَٰهُمۡ","and We chose them"],["وَهَدَيۡنَٰهُمۡ","and We guided them"],["إِلَىٰ","to"],["صِرَٰطٖ","a path"],["مُّسۡتَقِيمٖ","straight"]]},{"s":103,"a":2,"en":"Indeed, mankind is in loss,","w":[["إِنَّ","Indeed"],["ٱلۡإِنسَٰنَ","mankind"],["لَفِي","(is) surely,in"],["خُسۡرٍ","loss"]]},{"s":27,"a":85,"en":"And the decree will befall them for the wrong they did, and they will not [be able to] speak.","w":[["وَوَقَعَ","And (will be) fulfilled"],["ٱلۡقَوۡلُ","the word"],["عَلَيۡهِم","against them"],["بِمَا","because"],["ظَلَمُواْ","they wronged"],["فَهُمۡ","and they"],["لَا","(will) not"],["يَنطِقُونَ","speak"]]},{"s":93,"a":3,"en":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you].","w":[["مَا","Not"],["وَدَّعَكَ","has forsaken you"],["رَبُّكَ","your Lord"],["وَمَا","and not"],["قَلَىٰ","He is displeased"]]},{"s":8,"a":51,"en":"That is for what your hands have put forth [of evil] and because Allah is not ever unjust to His servants.\"","w":[["ذَٰلِكَ","That"],["بِمَا","(is) for what"],["قَدَّمَتۡ","sent forth"],["أَيۡدِيكُمۡ","your hands"],["وَأَنَّ","And indeed"],["ٱللَّهَ","Allah"],["لَيۡسَ","(is) not"],["بِظَلَّـٰمٖ","unjust"],["لِّلۡعَبِيدِ","to His slaves"]]},{"s":107,"a":3,"en":"And does not encourage the feeding of the poor.","w":[["وَلَا","And (does) not"],["يَحُضُّ","feel the urge"],["عَلَىٰ","to"],["طَعَامِ","feed"],["ٱلۡمِسۡكِينِ","the poor"]]},{"s":80,"a":7,"en":"And not upon you [is any blame] if he will not be purified.","w":[["وَمَا","And not"],["عَلَيۡكَ","upon you"],["أَلَّا","that not"],["يَزَّكَّىٰ","he purifies himself"]]},{"s":67,"a":24,"en":"Say, \"It is He who has multiplied you throughout the earth, and to Him you will be gathered.\"","w":[["قُلۡ","Say"],["هُوَ","He"],["ٱلَّذِي","(is) the One Who"],["ذَرَأَكُمۡ","multiplied you"],["فِي","in"],["ٱلۡأَرۡضِ","the earth"],["وَإِلَيۡهِ","and to Him"],["تُحۡشَرُونَ","you will be gathered"]]}]
[[{"s":1,"a":1,"en":"In the name of Allah, the Entirely Merciful, the Especially Merciful.","w":[["بِسۡمِ","In (the) name"],["ٱللَّهِ","(of) Allah"],["ٱلرَّحۡمَٰنِ","the Most Gracious"],["ٱلرَّحِيمِ","the Most Merciful"]]},{"s":1,"a":2,"en":"[All] praise is [due] to Allah, Lord of the worlds -","w":[["ٱلۡحَمۡدُ","All praises and thanks"],["لِلَّهِ","(be) to Allah"],["رَبِّ","the Lord"],["ٱلۡعَٰلَمِينَ","of the universe"]]},{"s":1,"a":3,"en":"The Entirely Merciful, the Especially Merciful,","w":[["ٱلرَّحۡمَٰنِ","The Most Gracious"],["ٱلرَّحِيمِ","the Most Merciful"]]}],[{"s":1,"a":4,"en":"Sovereign of the Day of Recompense.","w":[["مَٰلِكِ","(The) Master"],["يَوۡمِ","(of the) Day"],["ٱلدِّينِ","(of the) Judgment"]]},{"s":1,"a":5,"en":"It is You we worship and You we ask for help.","w":[["إِيَّاكَ","You Alone"],["نَعۡبُدُ","we worship"],["وَإِيَّاكَ","and You Alone"],["نَسۡتَعِينُ","we ask for help"]]},{"s":1,"a":6,"en":"Guide us to the straight path -","w":[["ٱهۡدِنَا","Guide us"],["ٱلصِّرَٰطَ","(to) the path"],["ٱلۡمُسۡتَقِيمَ","the straight"]]}],[{"s":1,"a":7,"en":"The path of those upon whom You have bestowed favor, not of those who have evoked [Your] anger or of those who are astray.","w":[["صِرَٰطَ","(The) path"],["ٱلَّذِينَ","(of) those"],["أَنۡعَمۡتَ","You have bestowed (Your) Favors"],["عَلَيۡهِمۡ","on them"],["غَيۡرِ","not (of)"],["ٱلۡمَغۡضُوبِ","those who earned (Your) wrath"],["عَلَيۡهِمۡ","on themselves"],["وَلَا","and not"],["ٱلضَّآلِّينَ","(of) those who go astray"]]},{"s":112,"a":1,"en":"Say, \"He is Allah, [who is] One,","w":[["قُلۡ","Say"],["هُوَ","He"],["ٱللَّهُ","(is) Allah"],["أَحَدٌ","the One"]]},{"s":112,"a":2,"en":"Allah, the Eternal Refuge.","w":[["ٱللَّهُ","Allah"],["ٱلصَّمَدُ","the Eternal,the Absolute"]]}],[{"s":112,"a":3,"en":"He neither begets nor is born,","w":[["لَمۡ","Not"],["يَلِدۡ","He begets"],["وَلَمۡ","and not"],["يُولَدۡ","He is begotten"]]},{"s":112,"a":4,"en":"Nor is there to Him any equivalent.\"","w":[["وَلَمۡ","And not"],["يَكُن","is"],["لَّهُۥ","for Him"],["كُفُوًا","equivalent"],["أَحَدُۢ","any [one]"]]},{"s":113,"a":1,"en":"Say, \"I seek refuge in the Lord of daybreak","w":[["قُلۡ","Say"],["أَعُوذُ","I seek refuge"],["بِرَبِّ","in (the) Lord"],["ٱلۡفَلَقِ","(of) the dawn"]]}],[{"s":113,"a":2,"en":"From the evil of that which He created","w":[["مِن","From"],["شَرِّ","(the) evil"],["مَا","(of) what"],["خَلَقَ","He created"]]},{"s":113,"a":3,"en":"And from the evil of darkness when it settles","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["غَاسِقٍ","(of) darkness"],["إِذَا","when"],["وَقَبَ","it spreads"]]},{"s":113,"a":4,"en":"And from the evil of the blowers in knots","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["ٱلنَّفَّـٰثَٰتِ","(of) the blowers"],["فِي","in"],["ٱلۡعُقَدِ","the knots"]]}],[{"s":113,"a":5,"en":"And from the evil of an envier when he envies.\"","w":[["وَمِن","And from"],["شَرِّ","(the) evil"],["حَاسِدٍ","(of) an envier"],["إِذَا","when"],["حَسَدَ","he envies"]]},{"s":114,"a":1,"en":"Say, \"I seek refuge in the Lord of mankind,","w":[["قُلۡ","Say"],["أَعُوذُ","I seek refuge"],["بِرَبِّ","in (the) Lord"],["ٱلنَّاسِ","(of) mankind"]]},{"s":114,"a":2,"en":"The Sovereign of mankind.","w":[["مَلِكِ","(The) King"],["ٱلنَّاسِ","(of) mankind"]]}],[{"s":114,"a":3,"en":"The God of mankind,","w":[["إِلَٰهِ","(The) God"],["ٱلنَّاسِ","(of) mankind"]]},{"s":114,"a":4,"en":"From the evil of the retreating whisperer -","w":[["مِن","From"],["شَرِّ","(the) evil"],["ٱلۡوَسۡوَاسِ","(of) the whisperer"],["ٱلۡخَنَّاسِ","the one who withdraws"]]},{"s":114,"a":5,"en":"Who whispers [evil] into the breasts of mankind -","w":[["ٱلَّذِي","The one who"],["يُوَسۡوِسُ","whispers"],["فِي","in"],["صُدُورِ","(the) breasts"],["ٱلنَّاسِ","(of) mankind"]]}],[{"s":114,"a":6,"en":"From among the jinn and mankind.\"","w":[["مِنَ","From"],["ٱلۡجِنَّةِ","the jinn"],["وَٱلنَّاسِ","and men"]]},{"s":108,"a":1,"en":"Indeed, We have granted you, [O Muhammad], al-Kawthar.","w":[["إِنَّآ","Indeed,We"],["أَعۡطَيۡنَٰكَ","We have given you"],["ٱلۡكَوۡثَرَ","Al-Kauthar"]]},{"s":108,"a":2,"en":"So pray to your Lord and sacrifice [to Him alone].","w":[["فَصَلِّ","So pray"],["لِرَبِّكَ","to your Lord"],["وَٱنۡحَرۡ","and sacrifice"]]}]]
[[{"s":90,"a":18,"en":"Those are the companions of the right.","w":[["أُوْلَـٰٓئِكَ","Those"],["أَصۡحَٰبُ","(are the) companions"],["ٱلۡمَيۡمَنَةِ","(of) the right (hand)"]]},{"s":78,"a":31,"en":"Indeed, for the righteous is attainment -","w":[["إِنَّ","Indeed"],["لِلۡمُتَّقِينَ","for the righteous"],["مَفَازًا","(is) success"]]},{"s":102,"a":3,"en":"No! You are going to know.","w":[["كَلَّا","Nay"],["سَوۡفَ","Soon"],["تَعۡلَمُونَ","you will know"]]},{"s":92,"a":14,"en":"So I have warned you of a Fire which is blazing.","w":[["فَأَنذَرۡتُكُمۡ","So I warn you"],["نَارٗا","(of) a Fire"],["تَلَظَّىٰ","blazing"]]}],[{"s":80,"a":32,"en":"[As] enjoyment for you and your grazing livestock.","w":[["مَّتَٰعٗا","(As) a provision"],["لَّكُمۡ","for you"],["وَلِأَنۡعَٰمِكُمۡ","and for your cattle"]]},{"s":88,"a":4,"en":"They will [enter to] burn in an intensely hot Fire.","w":[["تَصۡلَىٰ","They will burn"],["نَارًا","(in) a Fire"],["حَامِيَةٗ","intensely hot"]]},{"s":91,"a":5,"en":"And [by] the sky and He who constructed it","w":[["وَٱلسَّمَآءِ","And the heaven"],["وَمَا","and (He) Who"],["بَنَىٰهَا","constructed it"]]},{"s":80,"a":13,"en":"[It is recorded] in honored sheets,","w":[["فِي","In"],["صُحُفٖ","sheets"],["مُّكَرَّمَةٖ","honored"]]}],[{"s":80,"a":20,"en":"Then He eased the way for him;","w":[["ثُمَّ","Then"],["ٱلسَّبِيلَ","the way"],["يَسَّرَهُۥ","He made easy for him"]]},{"s":82,"a":3,"en":"And when the seas are erupted","w":[["وَإِذَا","And when"],["ٱلۡبِحَارُ","the seas"],["فُجِّرَتۡ","are made to gush forth"]]},{"s":82,"a":1,"en":"When the sky breaks apart","w":[["إِذَا","When"],["ٱلسَّمَآءُ","the sky"],["ٱنفَطَرَتۡ","(is) cleft asunder"]]},{"s":87,"a":17,"en":"While the Hereafter is better and more enduring.","w":[["وَٱلۡأٓخِرَةُ","While the Hereafter"],["خَيۡرٞ","(is) better"],["وَأَبۡقَىٰٓ","and everlasting"]]}],[{"s":79,"a":14,"en":"And suddenly they will be [alert] upon the earth's surface.","w":[["فَإِذَا","And behold"],["هُم","They"],["بِٱلسَّاهِرَةِ","(will be) awakened"]]},{"s":83,"a":35,"en":"On adorned couches, observing.","w":[["عَلَى","On"],["ٱلۡأَرَآئِكِ","the thrones"],["يَنظُرُونَ","observing"]]},{"s":109,"a":1,"en":"Say, \"O disbelievers,","w":[["قُلۡ","Say"],["يَـٰٓأَيُّهَا","O"],["ٱلۡكَٰفِرُونَ","disbelievers"]]},{"s":79,"a":28,"en":"He raised its ceiling and proportioned it.","w":[["رَفَعَ","He raised"],["سَمۡكَهَا","its ceiling"],["فَسَوَّىٰهَا","and proportioned it"]]}],[{"s":91,"a":4,"en":"And [by] the night when it covers it","w":[["وَٱلَّيۡلِ","And the night"],["إِذَا","when"],["يَغۡشَىٰهَا","it covers it"]]},{"s":81,"a":19,"en":"[That] indeed, the Qur'an is a word [conveyed by] a noble messenger","w":[["إِنَّهُۥ","Indeed,it"],["لَقَوۡلُ","(is) surely a word"],["رَسُولٖ","(of) a Messenger"],["كَرِيمٖ","noble"]]},{"s":84,"a":9,"en":"And return to his people in happiness.","w":[["وَيَنقَلِبُ","And he will return"],["إِلَىٰٓ","to"],["أَهۡلِهِۦ","his people"],["مَسۡرُورٗا","happily"]]},{"s":79,"a":11,"en":"Even if we should be decayed bones?","w":[["أَءِذَا","What!When"],["كُنَّا","we are"],["عِظَٰمٗا","bones"],["نَّخِرَةٗ","decayed"]]}],[{"s":86,"a":6,"en":"He was created from a fluid, ejected,","w":[["خُلِقَ","He is created"],["مِن","from"],["مَّآءٖ","a water"],["دَافِقٖ","ejected"]]},{"s":105,"a":4,"en":"Striking them with stones of hard clay,","w":[["تَرۡمِيهِم","Striking them"],["بِحِجَارَةٖ","with stones"],["مِّن","of"],["سِجِّيلٖ","baked clay"]]},{"s":99,"a":3,"en":"And man says, \"What is [wrong] with it?\" -","w":[["وَقَالَ","And says"],["ٱلۡإِنسَٰنُ","man"],["مَا","What"],["لَهَا","(is) with it"]]},{"s":79,"a":36,"en":"And Hellfire will be exposed for [all] those who see -","w":[["وَبُرِّزَتِ","And will be made manifest"],["ٱلۡجَحِيمُ","the Hellfire"],["لِمَن","to (him) who"],["يَرَىٰ","sees"]]}],[{"s":109,"a":2,"en":"I do not worship what you worship.","w":[["لَآ","Not"],["أَعۡبُدُ","I worship"],["مَا","what"],["تَعۡبُدُونَ","you worship"]]},{"s":102,"a":5,"en":"No! If you only knew with knowledge of certainty...","w":[["كَلَّا","Nay"],["لَوۡ","If"],["تَعۡلَمُونَ","you know"],["عِلۡمَ","(with) a knowledge"],["ٱلۡيَقِينِ","(of) certainty"]]},{"s":80,"a":34,"en":"On the Day a man will flee from his brother","w":[["يَوۡمَ","(The) Day"],["يَفِرُّ","will flee"],["ٱلۡمَرۡءُ","a man"],["مِنۡ","from"],["أَخِيهِ","his brother"]]},{"s":82,"a":6,"en":"O mankind, what has deceived you concerning your Lord, the Generous,","w":[["يَـٰٓأَيُّهَا","O"],["ٱلۡإِنسَٰنُ","man"],["مَا","What"],["غَرَّكَ","has deceived you"],["بِرَبِّكَ","concerning your Lord"],["ٱلۡكَرِيمِ","the Most Noble"]]}],[{"s":83,"a":31,"en":"And when they returned to their people, they would return jesting.","w":[["وَإِذَا","And when"],["ٱنقَلَبُوٓاْ","they returned"],["إِلَىٰٓ","to"],["أَهۡلِهِمُ","their people"],["ٱنقَلَبُواْ","they would return"],["فَكِهِينَ","jesting"]]},{"s":84,"a":15,"en":"But yes! Indeed, his Lord was ever of him, Seeing.","w":[["بَلَىٰٓۚ","Yes"],["إِنَّ","Indeed"],["رَبَّهُۥ","his Lord"],["كَانَ","was"],["بِهِۦ","of him"],["بَصِيرٗا","All-Seer"]]},{"s":79,"a":27,"en":"Are you a more difficult creation or is the heaven? Allah constructed it.","w":[["ءَأَنتُمۡ","Are you"],["أَشَدُّ","a more difficult"],["خَلۡقًا","creation"],["أَمِ","or"],["ٱلسَّمَآءُۚ","the heaven"],["بَنَىٰهَا","He constructed it"]]},{"s":111,"a":2,"en":"His wealth will not avail him or that which he gained.","w":[["مَآ","Not"],["أَغۡنَىٰ","(will) avail"],["عَنۡهُ","him"],["مَالُهُۥ","his wealth"],["وَمَا","and what"],["كَسَبَ","he earned"]]}]]
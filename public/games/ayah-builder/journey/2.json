[[{"s":20,"a":28,"en":"That they may understand my speech.","w":[["يَفۡقَهُواْ","That they may understand"],["قَوۡلِي","my speech"]]},{"s":20,"a":26,"en":"And ease for me my task","w":[["وَيَسِّرۡ","And ease"],["لِيٓ","for me"],["أَمۡرِي","my task"]]},{"s":94,"a":5,"en":"For indeed, with hardship [will be] ease.","w":[["فَإِنَّ","So indeed"],["مَعَ","with"],["ٱلۡعُسۡرِ","the hardship"],["يُسۡرًا","(is) ease"]]},{"s":20,"a":27,"en":"And untie the knot from my tongue","w":[["وَٱحۡلُلۡ","And untie"],["عُقۡدَةٗ","(the) knot"],["مِّن","from"],["لِّسَانِي","my tongue"]]}],[{"s":94,"a":6,"en":"Indeed, with hardship [will be] ease.","w":[["إِنَّ","Indeed"],["مَعَ","with"],["ٱلۡعُسۡرِ","the hardship"],["يُسۡرٗا","(is) ease"]]},{"s":26,"a":85,"en":"And place me among the inheritors of the Garden of Pleasure.","w":[["وَٱجۡعَلۡنِي","And make me"],["مِن","of"],["وَرَثَةِ","(the) inheritors"],["جَنَّةِ","(of) Garden (s)"],["ٱلنَّعِيمِ","(of) Delight"]]},{"s":37,"a":100,"en":"My Lord, grant me [a child] from among the righteous.\"","w":[["رَبِّ","My Lord"],["هَبۡ","grant"],["لِي","me"],["مِنَ","of"],["ٱلصَّـٰلِحِينَ","the righteous"]]},{"s":23,"a":98,"en":"And I seek refuge in You, my Lord, lest they be present with me.\"","w":[["وَأَعُوذُ","And I seek refuge"],["بِكَ","in You"],["رَبِّ","My Lord"],["أَن","Lest"],["يَحۡضُرُونِ","they be present with me"]]}],[{"s":26,"a":83,"en":"[And he said], \"My Lord, grant me authority and join me with the righteous.","w":[["رَبِّ","My Lord"],["هَبۡ","Grant"],["لِي","[for] me"],["حُكۡمٗا","wisdom"],["وَأَلۡحِقۡنِي","and join me"],["بِٱلصَّـٰلِحِينَ","with the righteous"]]},{"s":2,"a":152,"en":"So remember Me; I will remember you. And be grateful to Me and do not deny Me.","w":[["فَٱذۡكُرُونِيٓ","So remember Me"],["أَذۡكُرۡكُمۡ","I will remember you"],["وَٱشۡكُرُواْ","and be grateful"],["لِي","to Me"],["وَلَا","and (do) not"],["تَكۡفُرُونِ","(be) ungrateful to Me"]]},{"s":44,"a":12,"en":"[They will say], \"Our Lord, remove from us the torment; indeed, we are believers.\"","w":[["رَّبَّنَا","Our Lord"],["ٱكۡشِفۡ","Remove"],["عَنَّا","from us"],["ٱلۡعَذَابَ","the punishment"],["إِنَّا","indeed,we"],["مُؤۡمِنُونَ","(are) believers"]]},{"s":29,"a":30,"en":"He said, \"My Lord, support me against the corrupting people.\"","w":[["قَالَ","He said"],["رَبِّ","My Lord"],["ٱنصُرۡنِي","Help me"],["عَلَى","against"],["ٱلۡقَوۡمِ","the people"],["ٱلۡمُفۡسِدِينَ","the corrupters"]]}],[{"s":23,"a":97,"en":"And say, \"My Lord, I seek refuge in You from the incitements of the devils,","w":[["وَقُل","And say"],["رَّبِّ","My Lord"],["أَعُوذُ","I seek refuge"],["بِكَ","in You"],["مِنۡ","from"],["هَمَزَٰتِ","(the) suggestions"],["ٱلشَّيَٰطِينِ","(of) the evil ones"]]},{"s":23,"a":118,"en":"And, [O Muhammad], say, \"My Lord, forgive and have mercy, and You are the best of the merciful.\"","w":[["وَقُل","And say"],["رَّبِّ","My Lord"],["ٱغۡفِرۡ","Forgive"],["وَٱرۡحَمۡ","and have mercy"],["وَأَنتَ","and You"],["خَيۡرُ","(are the) Best"],["ٱلرَّـٰحِمِينَ","(of) those who show mercy"]]},{"s":14,"a":41,"en":"Our Lord, forgive me and my parents and the believers the Day the account is established.\"","w":[["رَبَّنَا","Our Lord"],["ٱغۡفِرۡ","Forgive"],["لِي","me"],["وَلِوَٰلِدَيَّ","and my parents"],["وَلِلۡمُؤۡمِنِينَ","and the believers"],["يَوۡمَ","(on) the Day"],["يَقُومُ","will (be) established"],["ٱلۡحِسَابُ","the account"]]},{"s":14,"a":40,"en":"My Lord, make me an establisher of prayer, and [many] from my descendants. Our Lord, and accept my supplication.","w":[["رَبِّ","My Lord"],["ٱجۡعَلۡنِي","Make me"],["مُقِيمَ","an establisher"],["ٱلصَّلَوٰةِ","(of) the prayer"],["وَمِن","and from"],["ذُرِّيَّتِيۚ","my offsprings"],["رَبَّنَا","Our Lord"],["وَتَقَبَّلۡ","and accept"],["دُعَآءِ","my prayer"]]}],[{"s":3,"a":139,"en":"So do not weaken and do not grieve, and you will be superior if you are [true] believers.","w":[["وَلَا","And (do) not"],["تَهِنُواْ","weaken"],["وَلَا","and (do) not"],["تَحۡزَنُواْ","grieve"],["وَأَنتُمُ","and you (will be)"],["ٱلۡأَعۡلَوۡنَ","[the] superior"],["إِن","if"],["كُنتُم","you are"],["مُّؤۡمِنِينَ","believers"]]},{"s":2,"a":156,"en":"Who, when disaster strikes them, say, \"Indeed we belong to Allah, and indeed to Him we will return.\"","w":[["ٱلَّذِينَ","Those who"],["إِذَآ","when"],["أَصَٰبَتۡهُم","strikes them"],["مُّصِيبَةٞ","a misfortune"],["قَالُوٓاْ","they say"],["إِنَّا","Indeed,we"],["لِلَّهِ","belong to Allah"],["وَإِنَّآ","and indeed we"],["إِلَيۡهِ","towards Him"],["رَٰجِعُونَ","will return"]]},{"s":28,"a":21,"en":"So he left it, fearful and anticipating [apprehension]. He said, \"My Lord, save me from the wrongdoing people.\"","w":[["فَخَرَجَ","So he left"],["مِنۡهَا","from it"],["خَآئِفٗا","fearing"],["يَتَرَقَّبُۖ","(and) vigilant"],["قَالَ","He said"],["رَبِّ","My Lord"],["نَجِّنِي","Save me"],["مِنَ","from"],["ٱلۡقَوۡمِ","the people"],["ٱلظَّـٰلِمِينَ","the wrongdoers"]]},{"s":21,"a":83,"en":"And [mention] Job, when he called to his Lord, \"Indeed, adversity has touched me, and you are the Most Merciful of the merciful.\"","w":[["۞وَأَيُّوبَ","And Ayub"],["إِذۡ","when"],["نَادَىٰ","he called"],["رَبَّهُۥٓ","(to) his Lord"],["أَنِّي","Indeed,[I]"],["مَسَّنِيَ","has touched me"],["ٱلضُّرُّ","the adversity"],["وَأَنتَ","and You"],["أَرۡحَمُ","(are) Most Merciful"],["ٱلرَّـٰحِمِينَ","(of) the Merciful"]]}],[{"s":2,"a":153,"en":"O you who have believed, seek help through patience and prayer. Indeed, Allah is with the patient.","w":[["يَـٰٓأَيُّهَا","O you"],["ٱلَّذِينَ","who"],["ءَامَنُواْ","believe [d]"],["ٱسۡتَعِينُواْ","Seek help"],["بِٱلصَّبۡرِ","through patience"],["وَٱلصَّلَوٰةِۚ","and the prayer"],["إِنَّ","Indeed"],["ٱللَّهَ","Allah"],["مَعَ","(is) with"],["ٱلصَّـٰبِرِينَ","the patient ones"]]},{"s":3,"a":16,"en":"Those who say, \"Our Lord, indeed we have believed, so forgive us our sins and protect us from the punishment of the Fire,\"","w":[["ٱلَّذِينَ","Those who"],["يَقُولُونَ","say"],["رَبَّنَآ","Our Lord"],["إِنَّنَآ","Indeed,we"],["ءَامَنَّا","(have) believed"],["فَٱغۡفِرۡ","so forgive"],["لَنَا","for us"],["ذُنُوبَنَا","our sins"],["وَقِنَا","and save us"],["عَذَابَ","(from) punishment"],["ٱلنَّارِ","(of) the Fire"]]},{"s":28,"a":16,"en":"He said, \"My Lord, indeed I have wronged myself, so forgive me,\" and He forgave him. Indeed, He is the Forgiving, the Merciful.","w":[["قَالَ","He said"],["رَبِّ","My Lord"],["إِنِّي","Indeed,I"],["ظَلَمۡتُ","[I] have wronged"],["نَفۡسِي","my soul"],["فَٱغۡفِرۡ","so forgive"],["لِي","[for] me"],["فَغَفَرَ","Then He forgave"],["لَهُۥٓۚ","[for] him"],["إِنَّهُۥ","Indeed He"],["هُوَ","He (is)"],["ٱلۡغَفُورُ","the Oft-Forgiving"],["ٱلرَّحِيمُ","the Most Merciful"]]},{"s":60,"a":5,"en":"Our Lord, make us not [objects of] torment for the disbelievers and forgive us, our Lord. Indeed, it is You who is the Exalted in Might, the Wise.\"","w":[["رَبَّنَا","Our Lord"],["لَا","(do) not"],["تَجۡعَلۡنَا","make us"],["فِتۡنَةٗ","a trial"],["لِّلَّذِينَ","for those who"],["كَفَرُواْ","disbelieve"],["وَٱغۡفِرۡ","and forgive"],["لَنَا","us"],["رَبَّنَآۖ","our Lord"],["إِنَّكَ","Indeed You"],["أَنتَ","[You]"],["ٱلۡعَزِيزُ","(are) the All-Mighty"],["ٱلۡحَكِيمُ","the All-Wise"]]}],[{"s":2,"a":201,"en":"But among them is he who says, \"Our Lord, give us in this world [that which is] good and in the Hereafter [that which is] good and protect us from the punishment of the Fire.\"","w":[["وَمِنۡهُم","And from those"],["مَّن","who"],["يَقُولُ","say"],["رَبَّنَآ","Our Lord"],["ءَاتِنَا","Grant us"],["فِي","in"],["ٱلدُّنۡيَا","the world"],["حَسَنَةٗ","good"],["وَفِي","and in"],["ٱلۡأٓخِرَةِ","the Hereafter"],["حَسَنَةٗ","good"],["وَقِنَا","and save us"],["عَذَابَ","(from the) punishment"],["ٱلنَّارِ","(of) the Fire"]]},{"s":17,"a":80,"en":"And say, \"My Lord, cause me to enter a sound entrance and to exit a sound exit and grant me from Yourself a supporting authority.\"","w":[["وَقُل","And say"],["رَّبِّ","My Lord"],["أَدۡخِلۡنِي","Cause me to enter"],["مُدۡخَلَ","an entrance"],["صِدۡقٖ","sound"],["وَأَخۡرِجۡنِي","and cause me to exit"],["مُخۡرَجَ","an exit"],["صِدۡقٖ","sound"],["وَٱجۡعَل","and make"],["لِّي","for me"],["مِن","from"],["لَّدُنكَ","near You"],["سُلۡطَٰنٗا","an authority"],["نَّصِيرٗا","helping"]]},{"s":50,"a":16,"en":"And We have already created man and know what his soul whispers to him, and We are closer to him than [his] jugular vein","w":[["وَلَقَدۡ","And certainly"],["خَلَقۡنَا","We created"],["ٱلۡإِنسَٰنَ","man"],["وَنَعۡلَمُ","and We know"],["مَا","what"],["تُوَسۡوِسُ","whispers"],["بِهِۦ","to him"],["نَفۡسُهُۥۖ","his soul"],["وَنَحۡنُ","and We"],["أَقۡرَبُ","(are) nearer"],["إِلَيۡهِ","to him"],["مِنۡ","than"],["حَبۡلِ","(his) jugular vein"],["ٱلۡوَرِيدِ","(his) jugular vein"]]},{"s":3,"a":8,"en":"[Who say], \"Our Lord, let not our hearts deviate after You have guided us and grant us from Yourself mercy. Indeed, You are the Bestower.","w":[["رَبَّنَا","Our Lord"],["لَا","(Do) not"],["تُزِغۡ","deviate"],["قُلُوبَنَا","our hearts"],["بَعۡدَ","after"],["إِذۡ","[when]"],["هَدَيۡتَنَا","You (have) guided us"],["وَهَبۡ","and grant"],["لَنَا","(for) us"],["مِن","from"],["لَّدُنكَ","Yourself"],["رَحۡمَةًۚ","mercy"],["إِنَّكَ","Indeed You"],["أَنتَ","You"],["ٱلۡوَهَّابُ","(are) the Bestower"]]}],[{"s":28,"a":24,"en":"So he watered [their flocks] for them; then he went back to the shade and said, \"My Lord, indeed I am, for whatever good You would send down to me, in need.\"","w":[["فَسَقَىٰ","So he watered"],["لَهُمَا","for them"],["ثُمَّ","Then"],["تَوَلَّىٰٓ","he turned back"],["إِلَى","to"],["ٱلظِّلِّ","the shade"],["فَقَالَ","and said"],["رَبِّ","My Lord"],["إِنِّي","Indeed,I am"],["لِمَآ","of whatever"],["أَنزَلۡتَ","You send"],["إِلَيَّ","to me"],["مِنۡ","of"],["خَيۡرٖ","good"],["فَقِيرٞ","(in) need"]]},{"s":71,"a":28,"en":"My Lord, forgive me and my parents and whoever enters my house a believer and the believing men and believing women. And do not increase the wrongdoers except in destruction.\"","w":[["رَّبِّ","My Lord"],["ٱغۡفِرۡ","Forgive"],["لِي","me"],["وَلِوَٰلِدَيَّ","and my parents"],["وَلِمَن","and whoever"],["دَخَلَ","enters"],["بَيۡتِيَ","my house"],["مُؤۡمِنٗا","a believer"],["وَلِلۡمُؤۡمِنِينَ","and the believing men"],["وَٱلۡمُؤۡمِنَٰتِۖ","and the believing women"],["وَلَا","And (do) not"],["تَزِدِ","increase"],["ٱلظَّـٰلِمِينَ","the wrongdoers"],["إِلَّا","except"],["تَبَارَۢا","(in) destruction"]]},{"s":18,"a":10,"en":"[Mention] when the youths retreated to the cave and said, \"Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance.\"","w":[["إِذۡ","When"],["أَوَى","retreated"],["ٱلۡفِتۡيَةُ","the youths"],["إِلَى","to"],["ٱلۡكَهۡفِ","the cave"],["فَقَالُواْ","and they said"],["رَبَّنَآ","Our Lord"],["ءَاتِنَا","Grant us"],["مِن","from"],["لَّدُنكَ","Yourself"],["رَحۡمَةٗ","Mercy"],["وَهَيِّئۡ","and facilitate"],["لَنَا","for us"],["مِنۡ","[from]"],["أَمۡرِنَا","our affair"],["رَشَدٗا","(in the) right way"]]},{"s":7,"a":126,"en":"And you do not resent us except because we believed in the signs of our Lord when they came to us. Our Lord, pour upon us patience and let us die as Muslims [in submission to You].\"","w":[["وَمَا","And not"],["تَنقِمُ","you take revenge"],["مِنَّآ","from us"],["إِلَّآ","except"],["أَنۡ","that"],["ءَامَنَّا","we believed"],["بِـَٔايَٰتِ","in (the) Signs"],["رَبِّنَا","(of) our Lord"],["لَمَّا","when"],["جَآءَتۡنَاۚ","they came to us"],["رَبَّنَآ","Our Lord"],["أَفۡرِغۡ","Pour"],["عَلَيۡنَا","upon us"],["صَبۡرٗا","patience"],["وَتَوَفَّنَا","and cause us to die"],["مُسۡلِمِينَ","(as) Muslims"]]}]]
[{"w":["قُلۡ","هُوَ","ٱللَّهُ","أَحَدٌ"],"en":"Say, \"He is Allah, [who is] One,"},{"w":["ٱللَّهُ","ٱلصَّمَدُ"],"en":"Allah, the Eternal Refuge."},{"w":["لَمۡ","يَلِدۡ","وَلَمۡ","يُولَدۡ"],"en":"He neither begets nor is born,"},{"w":["وَلَمۡ","يَكُن","لَّهُۥ","كُفُوًا","أَحَدُۢ"],"en":"Nor is there to Him any equivalent.\""}]